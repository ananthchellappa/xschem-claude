# run with $> xschem --script /path/to/cadence_style_rc

# --- Libraries: use ONLY the OA (lib/cell/view) registry --------------------
# Anchor on this rc's own location (repo/src/cadence_style_rc) to find the
# sibling repo/xschem_libs_newsym/ tree -- the pin-name-migrated OA libraries
# (tools/migrate/migrate_pin_names.py; see doc/pin_name_migration.md and
# doc/library_defs.md §7). It is a drop-in replacement for repo/xschem_libraries_oa/:
# same Library/Cell/View names, same library.defs, netlist-identical, but its symbol
# pins own their name text. To fall back to the un-migrated tree, point this at
# xschem_libraries_oa instead.
set _cad_oa [file normalize [file join [file dirname [info script]] .. xschem_libs_newsym]]

# The registry to use is the library.defs that ships inside that tree (the
# Cadence cds.lib analog). Making it the EXPLICIT $XSCHEM_LIBRARY_DEFS gives its
# DEFINEs highest precedence.
set XSCHEM_LIBRARY_DEFS [file join $_cad_oa library.defs]

# Make the OA libraries the ONLY ones the Library Manager shows: drop search-path
# auto-discovery so the registry comes purely from the library.defs above, and
# clear the legacy search path so no flat directory leaks in. OA references are
# lib-qualified (e.g. "C {devices/nmos4}") and resolve through the registry
# (abs_sym_path rule 2 / cellview_resolve), so an empty search path does not break
# opening the OA schematics.
set library_registry_defs_only 1
set XSCHEM_LIBRARY_PATH {}

# Cells copied/created into an empty library use the nested lib/cell/view layout
# (a non-empty library keeps whatever style it already holds). Copying a flat
# cell into a nested library converts it to <cell>/<view>/<cell>.<ext>.
set library_default_layout nested

# Open the Library Manager automatically at startup (Cadence-style). Bind a key
# too if you like:  bind .drw <Key-F9> {xschem library_manager}
set launch_library_manager 1
unset _cad_oa

set draw_crosshair 1
set crosshair_size 2
set infix_interface 0
set cadence_compat 1
# With cadence_compat, a LMB double-click grows the selection outward along wire
# connectivity, one ring of connected segments per double-click, the 3rd reaching
# the whole net (doc/claude/specs/dblclick_connected_select.md). This replaces
# double-click-to-Edit-Properties (reach properties via 'q'). The engine is also
# scriptable/rebindable as `xschem select_grow_connected [x y]`.
# Fluid editing: first-click grab of any object tip/edge (rect corner+edge, line/wire
# end, arc endpoint) -> drag stretches, no pre-select, independent of enable_stretch.
# Defaults off (stock); enable it here for Cadence-style direct manipulation. Toggle live
# via Options > "Fluid editing". See doc/claude/specs/fluid_editing.md.
set fluid_editing 1
# Fluid enforcement: promote the END P1/P2 invariant checker from log-only to rollback-or-
# refuse -- a connected drag that would short/merge or disconnect nets is refused and the
# schematic left untouched (a ciw_echo notice names the offending nets), rather than silently
# saving the corruption. Default on; set 0 as an emergency escape hatch. See
# doc/claude/suggestions/hardening_sprint_plan.md (Track B).
set fluid_enforce_invariants 1
set orthogonal_wiring 1
set snap_cursor 1
set snap_cursor_size 4
set persistent_command 1
set use_cursor_for_selection 1
# set enable_stretch 1; # bad - this is what causes line touching sym pin to get selected when you want to select only the pin by enclosing with sel rect
# Click a symbol pin (of a placed instance) to select it; drag from a pin draws a
# wire; Q on a selected pin shows its name/dir/net read-only. See
# doc/claude/specs/pin_selection.md
set en_pin_select 1

# to get around not being able to zoom in with CTRL-scrollwheel, suggestion from SS:
# didn't work :( Claude explained why

# Zoom
# set replace_key(Control-Button-4) ButtonPress-4
# set replace_key(Control-Button-5) ButtonPress-5

# Horizontal Pan
# set replace_key(Shift-Button-4) Shift-ButtonPress-4
# set replace_key(Shift-Button-5) Shift-ButtonPress-5

# Vertical Pan
