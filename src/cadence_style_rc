# set replace_key(Button-5) Control-ButtonPress-5

# Claude suggestions : 

# zoom with Ctrl+wheel
xschem bind wheel up   ctrl canvas view.zoom_in
xschem bind wheel down ctrl canvas view.zoom_out
# vertical pan with plain wheel
xschem bind wheel up   0    canvas view.pan_up
xschem bind wheel down 0    canvas view.pan_down
# (Shift+wheel already pans horizontally — view.pan_left/right — by default, no change needed)
# Alt+wheel : grow / shrink every selected object -- wire thickness, and the [N:M] bus
# suffix on a pin/netlabel net name or an instance name. The actions are registered in
# C (edit.grow_selection / edit.shrink_selection -> busresize_apply, utils/bus_resize.tcl);
# rebind to any chord, e.g. `xschem bind wheel up ctrl+shift canvas edit.grow_selection`.
# See doc/claude/specs/bus_thickness_scroll.md.
xschem bind wheel up   alt canvas edit.grow_selection
xschem bind wheel down alt canvas edit.shrink_selection
# Alt+Shift+wheel : SHIFT the bus index/range up/down by 1 on a selected pin/netlabel
# name or instance name (wires/text tolerated, no effect). up: something -> something[0]
# -> something[1], something[N:M] -> something[N+1:M+1]. down steps back ([0] -> something),
# floored at 0 (something[N:0] stays). See bus_transpose_scroll.md.
xschem bind wheel up   alt+shift canvas edit.transpose_up_selection
xschem bind wheel down alt+shift canvas edit.transpose_down_selection

# Ctrl+Alt+Shift+LMB on a wire (or a net-label, or an instance pin) : select the
# whole LOGICAL net -- every wire segment carrying that net name, INCLUDING the
# segments that touch nothing but share the same wire-label and are therefore one
# node in the SPICE netlist. The wire-labels (and ports/probes) that name the net
# are selected too. This is the netlist twin of the double-click grow above, which
# walks copper only and stops where the wire stops.
# Matching is on the whole net name: bus notation is NOT expanded, so A[3:0] and
# A[1] are treated as different nets. Each use writes a replayable
# `xschem select_same_net <x> <y>` line plus a "net NAME -- N wires, M labels"
# result line to the action log AND the CIW pane.
# Remap to any button+modifier chord by editing this line; un-bind with
#   xschem unbind button 1 ctrl+alt+shift canvas
# Scriptable as `xschem select_same_net [x y] [add]` (no coords = every net in the
# current selection). See doc/claude/specs/select_same_net_by_label.md.
xschem bind button 1 ctrl+alt+shift canvas select.same_net_by_label
# ...and the ADDITIVE variant, which keeps the current selection and adds the
# clicked net to it, so several nets can be gathered one click at a time.
# Unbound by default -- pick a free chord and uncomment:
# xschem bind button 2 ctrl+alt+shift canvas select.same_net_by_label_add

# Cadence-style instantiation: the "i" key opens the Create Instance browser
# (Edit > Create Instance). `break` stops the event reaching the generic <KeyPress>
# -> C dispatcher, which otherwise maps 'i' to descend-into-symbol.
bind .drw <Key-i> {xschem create_instance; break}

# Cadence-style net highlighting (see doc/claude/specs/net_hilight_styles.md):
#   9 : highlight net. If a net/wire/label is selected, highlight it (advancing the
#       style each time, leaving the selection intact); otherwise enter highlight mode
#       and click nets/labels to highlight, ESC to end.
#   8 : remove a specific net highlight (noun-verb on the selection, or click-to-remove
#       mode otherwise).
#   0 : remove ALL net highlights.
# `break` stops the digit reaching the C dispatcher (where 0 toggles pin logic level).
bind .drw <Key-9> {xschem hilight_net_interactive;   break}
bind .drw <Key-8> {xschem unhilight_net_interactive; break}
bind .drw <Key-0> {xschem unhilight_all;             break}

# Alt-minus : step the highlight STYLE cursor back one (wrapping). The cursor
# auto-advances after each highlight; this re-applies a recently used style to the
# next highlight. Bound for both the main-row minus and the numeric-keypad minus.
# See doc/claude/specs/hilight_style_decrement.md.
bind .drw <Alt-Key-minus>       {cadence::prev_hilight_style; break}
bind .drw <Alt-Key-KP_Subtract> {cadence::prev_hilight_style; break}

# --------------------------------------------------------------------------
# Cadence-style key bindings (library navigation + hierarchy).
# See doc/claude/specs/cadence_bindkey_plan.md. Pure Tcl, no C changes: each bind lives on
# .drw and ends in `break`, so it captures the chord before the generic
# <KeyPress> -> C dispatcher sees it. Five of these chords are claimed by the C
# dispatcher (Save as Symbol, Clear symbol, Cut, Edit-in-new-window, Crosshair);
# the `break` overrides them. Those commands remain on their menus; optional
# replacement key bindings are listed (commented out) at the end.
# --------------------------------------------------------------------------

# Helper procs (utils/), path-resolved relative to this rc file.
set _ut [file join [file dirname [file normalize [info script]]] .. utils]
source [file join $_ut lib_mgr_helpers.tcl]
source [file join $_ut cadence_nav.tcl]
source [file join $_ut cadence_clip.tcl]
source [file join $_ut hilight_style_nav.tcl]
source [file join $_ut bus_resize.tcl]
source [file join $_ut bus_transpose.tcl]
source [file join $_ut text_resize.tcl]
source [file join $_ut apply_hilight.tcl]
source [file join $_ut select_same_cell.tcl]
# Toggle selected ports <-> wire-labels (Ctrl+Shift+T). The bind lives inside
# this file; see its header for why it is a Tk bind and not a keybindings.csv row.
source [file join $_ut toggle_pins_netlabels.tcl]
# Find Navigator form (Ctrl+Shift+G). The Tk bind lives inside the util file; see
# its header for why it is a .drw bind and not a keybindings.csv row.
source [file join $_ut find_helper.tcl]
# Instance Update form (Ctrl+Shift+I). The Tk bind lives inside the util file; see
# its header for why it is a .drw bind and not a keybindings.csv row.
source [file join $_ut instance_update.tcl]
# OP-annotation mode (6 / Ctrl-6 / Alt-6). Proc DEFINITIONS only -- the three Tk
# binds live below, next to the Ctrl-4 precedent, because that is where someone
# remapping a displaced chord reads. doc/claude/specs/op_annotation.md step S8.
source [file join $_ut annot_mode.tcl]
# moved unset _ut

# Ctrl-Alt-S : locate a cell in the Library Manager. Acts on the selected instance's
# master, or (nothing selected) the cell being viewed, or a "lib/cell" text note.
bind .drw <Control-Alt-Key-s>   {locate_selected_in_libmgr;       break}
# Ctrl-Alt-N : place the current Library-Manager selection
bind .drw <Control-Alt-Key-n>   {place_libmgr_selection;          break}
# Ctrl-Alt-H : select every instance in the schematic sharing a cell/view with the
# reference -- a selected instance (same view), a "lib/cell[/view]" text note, or the
# Library-Manager selection (library / cell / symbol-view). Inverse of Ctrl-Alt-S.
bind .drw <Control-Alt-Key-h>   {select_same_cell;                break}
# Ctrl-N : open a NEW blank editor window (untitled.sch scratchpad), leaving the current
# schematic untouched. Overrides the default Ctrl-N = Clear Schematic (still on File menu).
bind .drw <Control-Key-n>       {cadence::new_blank_window;       break}
# Ctrl-Shift-N : open a schematic read-only in a NEW window -- the selected instance's,
# or the cell named by a "lib/cell" text note.
bind .drw <Control-Shift-Key-N> {cadence::open_inst_sch_readonly; break}
# Ctrl-X : descend into selected instance's schematic (no-op if none selected)
bind .drw <Control-Key-x>       {cadence::descend_into_inst;      break}
# Ctrl-Shift-X : descend into the selected instance's schematic in a NEW window,
# read-only -- the E-dialog "New Window" path (a REAL descend that keeps the parent
# hierarchy, vs Ctrl-Shift-N which opens the child as a fresh top-level). No-op unless
# exactly one instance is selected. GOTCHA (same as Ctrl-Shift-N above): with Shift held
# the "x" key emits the capital "X" keysym, so bind Key-X.
bind .drw <Control-Shift-Key-X> {cadence::descend_into_inst_newwin_ro; break}
# Ctrl-Y : descend into the selected instance's SYMBOL (edit the .sym in place), the
# Cadence default chord for descend-into-symbol. This chord exists because the `i` steal
# above (see "Cadence-style instantiation", ~line 129) ends in `break`, which stops the
# event reaching the generic <KeyPress> -> C dispatcher -- the ONLY key route to
# descend-into-symbol (callback.c case 'i'). Without Ctrl-Y the verb is unreachable by
# any key in cadence mode; `i` cannot be given back because cadence mode needs it for
# Create Instance. Shift-i is not a fallback (callback.c case 'I' is insert-symbol).
# It calls the BARE verb, NOT a cadence:: wrapper mirroring descend_into_inst, because
# (a) `xschem descend_symbol` already refuses OUT LOUD -- returns 0, sets descend_error
# "no-selection" and statusmsg "Descend symbol: select an instance to descend into"
# (the issue-0251 refusal channel), which descend_into_inst's silent gate does not; and
# (b) cadence::one_instance_selected accepts a strictly SMALLER set than the core's
# descend_pick_target (instance+wire selected: the core descends, the gate refuses), so
# wrapping would add a new silent refusal on a selection the core handles. `xschem
# go_back` (Ctrl-E) unwinds a symbol descend with no extra bookkeeping, so there is no
# window-chain state for a wrapper to carry. See doc/claude/issues/0410-*.md.
# CAVEAT, pre-existing and shared with the Edit menu / toolbar / right-click item:
# descend_readonly (set below) is applied in descend_schematic() only, so in cadence
# browse mode Ctrl-Y opens the .sym EDITABLE while Ctrl-X opens a child schematic
# read-only -- filed as issue 0412, deliberately not fixed by this bind.
# The verb self-logs at the C core (save.c), so no log_action belongs here. Under a
# live dialog the scheduler's semaphore==0 gate makes this a silent no-op (issue 0253).
bind .drw <Control-Key-y>       {xschem descend_symbol;           break}
# Ctrl-E : return one level. Overrides the C default (go_back / ascend in place) with
# the window-chain-aware version: a window descended-into-new-window returns focus to
# the PARENT window instead of ascending the child in place (issue 0053). Cloned to
# every new/detached canvas by clone_canvas_bindings, so it works in child windows too.
bind .drw <Control-Key-e>       {cadence::return_one_level;       break}
# Alt-E : return to top of hierarchy, remembering where we were (per window)
bind .drw <Alt-Key-e>           {cadence::return_to_top;          break}
# Alt-X : descend back into the location remembered by the last Alt-E
bind .drw <Alt-Key-x>           {cadence::descend_to_last;        break}
# Alt-Shift-C : capture lib/cell/view to the clipboard + CIW. Selected instance ->
# its master's L/C/V; selected text note -> the first "a/b/c" slash path in it;
# nothing selected -> the current cellview's L/C/V. GOTCHA (same as Ctrl-Shift-2/N
# above): with Shift held the "c" key emits the capital "C" keysym, so bind Key-C.
bind .drw <Alt-Shift-Key-C>     {cadence::capture_lcv;            break}
# Ctrl-Alt-D : round-trip a deep location through a text note. Nothing selected ->
# write the last Alt-E location as a "inst/inst/..." note you place; a note that starts
# with such a path -> descend there (same engine as Alt-X).
bind .drw <Control-Alt-Key-d>   {cadence::deeploc_note;           break}
# Ctrl-2 / Ctrl-Shift-2 : make the current view Editable / Read Only.
# GOTCHA: with Shift held, the number-row "2" key emits its SHIFTED keysym, not
# "2" -- so <Control-Shift-Key-2> never matches. On a US layout Shift-2 is "@"
# (keysym "at"), so Ctrl-Shift-2 must be bound via <Control-Key-at>. The Key-2 form
# is kept as a fallback for layouts where Shift-2 stays "2". On a non-US layout
# replace "at" with whatever your Shift-2 produces (run `xev` to find the keysym).
bind .drw <Control-Key-2>       {cadence::make_editable;          break}
bind .drw <Control-Key-at>      {cadence::make_readonly;          break}
bind .drw <Control-Shift-Key-2> {cadence::make_readonly;          break}
# Ctrl-4 : ASE-L "select signals to plot" (Cadence Direct Plot, driven from the
# design window). Enters the ASE Direct Plot click mode for the session bound to
# THIS schematic -- or, once descended, to the nearest ANCESTOR of it (issue 0168),
# so you can run, descend into an instance and probe its internal nodes: click
# wires/net-labels for voltage traces, sources/ammeters for current traces; ESC
# plots the queue into the session's waveform viewer (opening it if needed). A
# bottom-status-line prompt shows while the mode is armed.
# Overrides the C default (Ctrl+4 = select drawing layer 4), so it ends in
# `break`, exactly like Ctrl-2 above. Remap: edit the chord on this line.
bind .drw <Control-Key-4>       {ase::direct_plot_for_current;    break}
# Ctrl-Shift-4 : flip the PLOT MODE of that session's waveform viewer
# (single-plot = every signal of one Direct Plot lands in the target strip;
# multi-plot = each signal gets its own strip). Issue 0151, contract in
# doc/claude/specs/waveform_viewer_modes.md. Same `break` rationale as Ctrl-4.
# The initial mode of a new viewer window comes from `wviewer_plot_mode`.
# SAME SHIFTED-KEYSYM GOTCHA as Ctrl-Shift-2 above: a physical Ctrl+Shift+4
# arrives as keysym "dollar" on a US layout, so <Control-Shift-Key-4> would
# NEVER match (probe-verified with wish). The dollar form is the REAL bind; the
# Shift-Key-4 form is kept for layouts where Shift-4 stays "4". Non-US layout:
# replace "dollar" with whatever your Shift-4 produces (`xev`).
bind .drw <Control-Key-dollar>  {ase::plot_mode_for_current invert; break}
bind .drw <Control-Shift-Key-4> {ase::plot_mode_for_current invert; break}
# 6 / Ctrl-6 / Alt-6 : OPERATING-POINT ANNOTATION MODE (doc/claude/specs/op_annotation.md
# step S8, issue 0614). These write xctx->annot_show, the bitmask text_hidden()
# (src/actions.c) gates the annotation classes on -- so device OP numbers and node
# voltages appear on the schematic without the annotator symbol being moved, edited
# or placed (invariant I4: the overlay never modifies the .sch).
#
# TWO ADDITIVE SETTERS AND ONE CLEAR-ALL. Ruled by the user 2026-08-22 (issue 0614);
# this table replaced a three-state cascade whose two lower rows were wrong:
#   6       annot_show |= 1   ADD device OP info AND branch currents (bit1 untouched)
#   Alt-6   annot_show |= 2   ADD node voltages    (bit0 untouched)
#   Ctrl-6  annot_show  = 0   clear BOTH -- the ONLY off switch
# (The branch currents sat on `Alt-6` until issue 0678: the user drove a real bench
# 2026-08-24 and ruled that a source's current is that DEVICE's OP info, so it
# belongs to `6`. Only the MEMBERSHIP moved -- the three rows above are the ruling
# the same bench confirmed correct, and the mask arithmetic did not change.)
# So `6` never turns anything off and is not a toggle (press it twice, nothing
# moves; press it with voltages on, they stay on), and `Alt-6` from a clean start
# gives mask 2 -- voltages ALONE, which the old cascade could not reach.
# Each press also loads the cell's raw if nothing is annotated yet (ASE session
# first, else $netlist_dir/<cell>.raw) and SAYS WHAT HAPPENED on the status line,
# held -- "no raw file" and "no OP descriptor for this symbol type" are the two
# first-run confusions and both are silent without it. Body: utils/annot_mode.tcl.
#
# Ctrl-6 overrides the C default (Ctrl+<digit> = select drawing layer <digit>,
# callback.c:7272), so it ends in `break`, exactly like Ctrl-2 and Ctrl-4 above.
# THE DISPLACED VERB SURVIVES: layer 6 is still selectable from the Layers menu
# and as `xschem set rectcolor 6`; see doc/claude/specs/cadence_bindkey_plan.md
# section 10 for the full displaced-chord list. Plain 6 and Alt-6 displace
# nothing -- measured, callback.c's `case '6'` acts only when state == ControlMask.
#
# ALL FOUR CHORDS ARE SPELLED OUT AND THAT IS NOT REDUNDANCY: Tk matches a
# pattern whose modifiers are a SUBSET of the event's, so with only the plain
# chord bound BOTH Ctrl-6 and Alt-6 would fire it and the OFF key would silently
# mean ON. (Measured too: Ctrl+Alt+6 falls into the Alt form.) The fourth chord
# (issue 0868, below) does not disturb the three: a physical Alt+Shift+6 arrives
# as a DIFFERENT KEYSYM, `asciicircum`, so plain Alt+6 still lands on
# <Alt-Key-6> -- measured, and nothing else in src/ or utils/ binds asciicircum.
# Like every bind in this file these are invisible to `xschem bindings dump` and
# to keybindings.csv; remap by editing the chord on these lines.
bind .drw <Key-6>               {cadence::annot_mode op;          break}
bind .drw <Control-Key-6>       {cadence::annot_mode none;        break}
bind .drw <Alt-Key-6>           {cadence::annot_mode opvolt;      break}
# Alt-Shift-6 : TRANSIENT NODE VOLTAGES AT THE WAVEFORM CURSOR (issue 0868).
# The user's own request: "Alt-6 and 6 are for OP info and OP node voltages. We
# can add a menu item in Results > Annotate for annotating TRAN node voltages
# for time-point given by cursor B, or A ... Give user a way to enter this mode
# with a different shortcut through cadence_style_rc - maybe Alt-Shift-6".
#
# NOT a fourth `cadence::annot_mode` spelling, and that is deliberate. The three
# chords above are pure mask arithmetic -- they turn a rendering switch on over
# numbers that were already published. This one PUBLISHES: it resolves which
# cursor supplies the time point (A when both are on, otherwise whichever one
# is), asks the engine to annotate there, arms annot_show bit2 only if that
# succeeded, and SAYS what happened in the CIW and on the held status line. Its
# five outcomes are minted in one place, cadence::_annot_tran_msg
# (utils/annot_mode.tcl); this line and the ASE-L `Results > Annotate >
# Transient Node Voltages (at cursor)` item are the two doors onto ONE body.
# Ctrl-6 still clears everything, bit2 included.
#
# SAME SHIFTED-KEYSYM GOTCHA AS Ctrl-Shift-4 ABOVE, and it is measured, not
# inherited: with wish on :99, keycode 15 is `6 asciicircum`, a physical
# Alt+Shift+6 on a US layout arrives as keysym `asciicircum`, and even an event
# synthesised with keysym `6` plus Shift+Alt dispatches to
# <Alt-Key-asciicircum>. <Alt-Shift-Key-6> NEVER fires. So the asciicircum form
# is THE REAL BIND; the Shift-Key-6 form is kept for layouts where Shift-6 stays
# "6". Non-US layout: replace "asciicircum" with whatever your Shift-6 produces
# (`xev`). A landing that wrote only the Shift-Key-6 form passes every
# behavioural test row in the tree and is dead under the user's fingers, which
# is why row V20 of tests/headless/test_op_annot.tcl is a source grep.
# Both end in `break` for the same reason the three above do.
bind .drw <Alt-Key-asciicircum> {cadence::annot_tran;             break}
bind .drw <Alt-Shift-Key-6>     {cadence::annot_tran;             break}

# "Show in Signal Browser" USED TO BE BOUND HERE, as Ctrl-5 (PLAN item 12).
# TWO-PANE item 17 (R10) MOVED IT INTO THE C ACTION REGISTRY as Ctrl+Alt+V --
# see src/callback.c's `wave.show_in_signal_browser` row and its
# set_input_binding, plus src/keybindings.csv. The reversal is recorded rather
# than erased because it changes who gets the feature and how it is remapped:
#
#   * this file is an OPT-IN PROFILE, so the chord only ever existed for
#     cadence-profile users, while the Tools cascade advertised the accelerator
#     to everyone -- the menu was telling non-cadence users something untrue;
#   * a Tk `bind` here is invisible to `xschem bind` / keybindings.csv, so the
#     chord could not be remapped the way every other action can. R10 is
#     REMAPPABILITY, and re-adding a bind here would quietly take it away again.
#
# Nothing to bind: the default now ships for every profile. Ctrl-4 and Ctrl-$
# above are still rc binds and are deliberately untouched.

# Ctrl-D INSIDE the waveform viewer : Clear All -- delete every graph and every
# trace and start from scratch (one empty strip remains). The plot mode, Shared
# X, the cursors and the loaded raw data are KEPT, so you can immediately pick
# new signals from the same results. Issue 0171; also Graph > Clear All.
# The viewer canvas SWEEPS every binding cloned from this .drw (it is a
# read-only graph window, not a schematic), so a viewer key is bound on the
# `WaveViewer` BINDTAG instead. The default is installed at the first viewer
# open and only if nothing bound the sequence already -- so a line here WINS.
# To remap, disable the default with `{break}` (an empty script would read as
# "never bound" and get re-defaulted) and bind your own:
# bind WaveViewer <Control-Key-d> {break}
# bind WaveViewer <Control-Key-r> {wviewer::clear_all_at %W; break}

# `e` INSIDE the waveform viewer : Delete Empty Strips -- remove every strip
# that holds no traces, tidying the stack after deleting traces or after a plot
# batch left a blank band. Two strips are never touched: the tool-owned
# auto-plot strip (it is traceless BETWEEN simulation runs by design) and the
# last strip standing, so the window is never left with nothing. `e` on a window
# holding a single empty strip therefore does nothing at all.
# Also Graph > Delete Empty Strips. Same bindtag rules as Ctrl-D above -- a line
# here WINS over the shipped default:
# bind WaveViewer <Key-e> {break}
# bind WaveViewer <Key-y> {wviewer::delete_empty_strips_at %W; break}

# Waveform-viewer LEGEND text size and weight. The signal names along the top of
# each strip used to be about 0.6x the size of the Y-axis numbers; they are now
# drawn at the same size and in bold. Both are viewer-only (per-rect prop
# tokens written by the viewer's own strip generator), so schematics with
# embedded graphs render exactly as before.
#   wviewer_legend_textmag  multiplier on the legend text size. 1.63 is the
#                           value that matches the Y-axis numbers at the
#                           viewer's divy=5; clamped to 0.25 .. 6.0, anything
#                           else falls back to the default.
#   wviewer_legend_bold     0 = DEFAULT: bold marks the SELECTED trace only
#                           (click a trace to bold it), which is the
#                           long-standing behaviour -- only the SIZE changed.
#                           1 = every legend entry bold; the selected trace is
#                           then drawn bold ITALIC, since bold no longer
#                           distinguishes it.
# set wviewer_legend_textmag 1.63
# set wviewer_legend_bold 0

# Waveform-viewer GRID density. The dashed grid inside each strip used to light
# half its pixels (a 2-on/2-off dash); it now lights a quarter (1-on/3-off),
# which makes the traces stand out without removing a single grid line or
# changing its colour. Viewer-only, like the legend vars above.
#   wviewer_grid_dash_off   the OFF run in pixels against a 1-pixel ON run.
#                           3 = DEFAULT (1-on/3-off, half the old density).
#                           0 = the old grid, exactly. Bigger = sparser.
#                           Clamped 0..32; anything else falls back to 3.
# set wviewer_grid_dash_off 3

# Ctrl-G INSIDE the waveform viewer : show/hide the graph grid of that window.
# Only the DASHED interior lines go -- the axes, the box, the tick marks, the
# axis NUMBERS and the zero lines stay, so the plot is still readable. Per
# window and live; also Graph > Grid (a checkbutton, so the menu always shows
# the real state). Same bindtag rules as Ctrl-D/`e` above -- a line here WINS:
# bind WaveViewer <Control-Key-g> {break}
# bind WaveViewer <Control-Key-h> {wviewer::grid_toggle_at %W; break}
#   wviewer_grid_show   the grid state a NEWLY OPENED viewer starts in.
#                       1 = DEFAULT (shown). Anything not a boolean -> 1.
# set wviewer_grid_show 1
#
# --- waveform viewer: mid-drag shrink preview (viewer plan item 6) -----------
# While a trace is being DRAGGED to another strip (LMB press on the trace, drag,
# drop on another strip) it is drawn shrunk in BOTH axes about the plot box
# centre, so the pointer visibly carries something and the dragged trace stops
# being confusable with the ones it passes over. The STRIP reorder drag gets no
# preview (decision D-E).
# Purely on-screen: no prop token, no model write, no undo point, and exports
# always draw the trace at full size.
#   wviewer_drag_shrink  the scale of the dragged trace while the drag is live,
#                        applied to X and Y alike. 0.7 = DEFAULT (a 30 %
#                        shrink; the first cut was 10 % and Y-only, and on
#                        review neither read clearly enough).
#                        1.0 turns the effect off without disabling the drag.
#                        Anything outside (0, 1] falls back to 0.7.
# set wviewer_drag_shrink 0.7
#
# 9 / 8 / 0 INSIDE the waveform viewer : highlight traces, in exactly the styles
# the same three keys give NETS in a schematic (the binds at the top of this
# file). A trace is a polyline with no junctions and no direction, so the whole
# net-highlight vocabulary -- colour, width, dash pattern, blink, marching ants
# -- applies to it unchanged, out of the SAME `net_hilight_style` table: a style
# you wrote for wires works on traces as it is. The style CURSOR is per window,
# though, so the viewer keeps its own place in the table and the Alt-minus bind
# above (a `bind .drw`) does not reach it -- to pick a particular style in the
# viewer, name it with the ad-hoc form at the end of this block.
#   9 : apply the current style to the SELECTED trace(s), then step the cursor
#       on, so pressing it again gives the next style. Unlike the schematic 9
#       there is no click-to-pick mode: the viewer already has a first-class
#       trace selection (click a trace or its legend name, Ctrl+click to add),
#       so with nothing selected 9 says so and does nothing.
#   8 : remove the highlight from the selected trace(s).
#   0 : remove EVERY trace highlight in this window (no selection needed).
# The style is stroked ON TOP of the curve, so the palette colour still names it
# in the legend. It is window chrome: never saved, never exported, and it dies
# with the window. Same bindtag rules as Ctrl-D / `e` / Ctrl-G above -- a line
# here WINS over the shipped default:
# bind WaveViewer <Key-9> {break}
# bind WaveViewer <Key-h> {wviewer::hilight_traces_at %W; break}
#
# ...and the AD-HOC form, the viewer twin of the F5 apply_hilight bind at the
# bottom of this file: write the style out instead of taking whatever the cursor
# is on. Named fields in any order, a Tcl dict, or a positional row; omitted
# fields take their defaults. Needs utils/apply_hilight.tcl, which this file
# sources. Edit the style and the key to taste -- e.g.
# {color cyan thickness 4 pattern {10 4} march march_fwd rate 2} to make it crawl.
# bind WaveViewer <Key-F5> \
#   {wviewer::apply_style_traces_at %W {color purple thickness 3 pattern {20 20}}; break}
#
# NOTE Ctrl-G in a SCHEMATIC window still toggles the dot grid (draw_grid,
# below) -- these do not collide: the viewer key is on the WaveViewer bindtag,
# which schematic canvases do not carry, and the viewer suppresses the dot grid
# for life anyway. The same is true of 9/8/0: the `bind .drw` versions at the top
# of this file are cloned onto every new canvas, but the viewer sweeps every
# widget-level binding off its own, so only the WaveViewer tag reaches it.

# Descend opens the child schematic READ-ONLY by default (browse mode). To edit,
# press Ctrl-2 after descending, use the "Descend schematic (edit)" right-click
# item, or View > Toggle Read Only.
set descend_readonly 1

# --- Optional re-homes for the commands whose keys were taken above. --------
# Disabled by default (the commands stay reachable from their menus). Uncomment
# to give them a key again. Chords below were checked to be free.
#   Cut (was Ctrl-X):
# bind .drw <Alt-Shift-Key-X>         {xschem cut;              break}
#   Edit schematic in a new window (was Alt-E):
# bind .drw <Control-Shift-Key-E>     {open_sub_schematic;      break}
#   Save as Symbol (was Ctrl-Alt-S):
# bind .drw <Control-Alt-Shift-Key-S> {xschem saveas {} symbol; break}
# Clear symbol (was Ctrl-Shift-N) and Draw crosshair (was Alt-X) are left as
# menu items only (Symbol > Clear symbol; Options > Crosshair > Draw crosshair).

# --- Rotate / flip IN PLACE: Alt-R, Alt-F, Alt-V -- all three REMAPPABLE ------
# These used to be hardcoded in C (the EQUAL_MODMASK arms of callback.c's key
# switch) and could not be moved. They are now registered actions, so the chord is
# yours. Each one acts on the current selection (a multi-object selection rotates /
# horizontally-flips as ONE rigid body about its snapped bounding-box centre), or on
# the objects being dragged if you hit it mid move/copy, or -- with nothing selected
# -- it arms "click an object to transform".
#
#   edit.rotate_in_place    default Alt-R    rotate 90 deg
#   edit.flip_in_place      default Alt-F    HORIZONTAL flip (left <-> right)
#   edit.flipv_in_place     default Alt-V    VERTICAL flip   (up <-> down)
#
# Remap = bind the action to the chord you want, then un-bind the old chord:
#   xschem bind   key <keysym> <mods> canvas <action>
#   xschem unbind key <keysym> <mods> canvas
# Keysyms: r=114  f=102  v=118   R=82  F=70  V=86   (run `xev` for others).
# mods: 0 | ctrl | alt | shift | super, joined with '+'.
# GOTCHA: for printable keys the C dispatch strips Shift, so a Shift chord must name
# the SHIFTED keysym -- Ctrl+Shift+R is `key 82 ctrl`, NOT `key 114 ctrl+shift`.
# Already taken, do not reuse: plain r/f/v (rectangle / zoom-full / vertical-constrain),
# Shift-r/f/v (rotate/flip about the MOUSE point), Ctrl-f (property search),
# Ctrl-r (simulate, under cadence_compat), Ctrl-Alt-v (show in Signal Browser).
#
# Examples -- uncomment to move each transform onto Ctrl+Shift+<letter>:
# xschem bind   key 82 ctrl canvas edit.rotate_in_place   ;# Ctrl+Shift+R = rotate
# xschem unbind key 114 alt canvas                        ;# free Alt-R
# xschem bind   key 70 ctrl canvas edit.flip_in_place     ;# Ctrl+Shift+F = h-flip
# xschem unbind key 102 alt canvas                        ;# free Alt-F
# xschem bind   key 86 ctrl canvas edit.flipv_in_place    ;# Ctrl+Shift+V = v-flip
# xschem unbind key 118 alt canvas                        ;# free Alt-V
#
# Each key also ships a Super (Windows-key) twin -- keysym 114/102/118 with `super`,
# inherited from the old C test, which accepted Alt OR Super. Un-bind those too if
# you want the letter completely free:
# xschem unbind key 114 super canvas
# xschem unbind key 102 super canvas
# xschem unbind key 118 super canvas
#
# The defaults live in src/keybindings.csv (generated from the C table); a copy in
# your USER_CONF_DIR (~/.xschem/keybindings.csv) is loaded afterwards and wins, so
# you can remap there instead of here -- edit the row, or set its action to '-' to
# un-bind. The MENU accelerator text (Edit > "Rotate in place ... Alt-R") is a static
# display string and does NOT follow a remap; `xschem bindings dump` and the
# generated keybindings cheat-sheet always show the live truth.

# --- snap / grid / highlight key actions (doc/claude/specs/keybind_snap_grid_actions.md) --
# These ship UNBOUND: no built-in default chord. Each is a registered action, also
# reachable from the menus (Options / View). Map any action to any chord with
#   xschem bind key <keysym> <mods> canvas <action>
# Keysyms: g=103  G=71  %=37  s=115  (run `xev` for others); mods 0|ctrl|alt|shift|super.
# GOTCHA: Shift changes the produced keysym (Shift-g -> 'G'/71), same as Ctrl-Shift-2
# above -- the examples use the actual produced keysyms.

# CTRL-G toggles grid visibility (active):
xschem bind key 103 ctrl canvas view.toggle_draw_grid

# ALT+Up / ALT+Down : coarsen / refine the SNAP spacing (`cadsnap`) by 2x / 0.5x,
# the Cadence snap-spacing bindkeys. Works in the schematic AND the symbol editor
# (one canvas, one binding table -- the chord is dispatched by the C input-binding
# table, not by anything schematic-specific) and on a read-only view too, since
# snap is edit geometry, not saved content.
# EVERY use is logged, to the action-log FILE and to the CIW pane, as two lines:
#   xschem set cadsnap 20          <- the replayable ABSOLUTE command (0066 rule:
#                                     never the relative `xschem snap double`,
#                                     which replays onto a different value)
#   #= snap 10 -> 20 (x2)          <- the human-readable outcome
# The self-log lives in the C core (view_snap_change, callback.c), so the menu
# items (View > Halve/Double snap factor) and `xschem snap half|double` from a
# script log identically.
# Arrow keysyms: Up=65362  Down=65364  Left=65361  Right=65363. Plain (unmodified)
# arrows keep scrolling the viewport -- only the alt chord is claimed here.
# REMAP: edit the two lines below (any keysym + 0|ctrl|alt|shift|super combo), or
# re-bind at runtime from the CIW, e.g.
#   xschem bind key 65451 ctrl canvas view.snap_double   ;# Ctrl+KP_Add instead
# Un-bind with:  xschem unbind key 65362 alt canvas
# The GRID spacing (`cadgrid`, the dot pitch) is a separate value with no
# double/halve action; set it outright with `xschem set cadgrid <value>` (also
# self-logged) or from View > Set grid spacing.
# ORTHOGONAL: changing the snap no longer restyles the drawing. Stock XSCHEM scaled
# the automatic line width AND the wire-junction / pin dot radius with the LIVE
# cadsnap, so a 2x snap doubled every wire, symbol line and pin-rectangle outline.
# The reference length is now the STARTUP snap, so line weight tracks zoom only.
# Tick View > "Line width follows snap" (or `set linewidth_follows_snap 1` here) to
# get the old coupling back.
# See doc/claude/specs/snap_spacing_bindkeys.md.
xschem bind key 65362 alt canvas view.snap_double     ;# Alt+Up   : snap x2
xschem bind key 65364 alt canvas view.snap_half       ;# Alt+Down : snap x0.5

# CTRL+Plus / CTRL+Minus : grow / shrink the DISPLAYED text size of selected text notes
# and pin/net-label names (~10%, min step, per-type floor). Other objects ignored.
# Four keysyms cover both the main row and the numeric keypad; the C key path strips
# Shift for printable keys, so Ctrl+Shift+= (main-row '+') arrives as keysym 43 (plus)
# with mods=ctrl. 43=plus  45=minus  65451=KP_Add  65453=KP_Subtract. Rebind freely.
# See doc/claude/specs/text_size_scroll.md.
xschem bind key 43    ctrl canvas edit.text_grow      ;# Ctrl+Shift+=  (main-row +)
xschem bind key 65451 ctrl canvas edit.text_grow      ;# Ctrl+KP_Add  (keypad +)
xschem bind key 45    ctrl canvas edit.text_shrink    ;# Ctrl+-       (main-row -)
xschem bind key 65453 ctrl canvas edit.text_shrink    ;# Ctrl+KP_Subtract (keypad -)

# Optional -- uncomment to give the others a key again:
# (snap half/double now live on Alt+Down / Alt+Up above; these are the ORIGINAL
#  stock chords, kept here as an additional/alternative mapping)
# xschem bind key 103 0   canvas view.snap_half               ;# halve snap    (old 'g')
# xschem bind key 71  0   canvas view.snap_double             ;# double snap   (old Shift-g)
# xschem bind key 103 alt canvas hilight.send_to_waveform idle ;# hilight->wave (old Alt-g)
# xschem bind key 115 alt canvas view.set_snap_value          ;# set-snap dialog (old Ctrl-g
#                                                             ;# is now grid; 115='s', pick
#                                                             ;# any unused chord)
# xschem bind key 37  0   canvas view.toggle_draw_grid        ;# also toggle grid with '%'

# net highlighting tweaks - just testing..
source [file join $_ut display.tcl]

# One shortcut to apply YOUR favourite net-highlight style at any time (apply_hilight,
# doc/claude/specs/apply_hilight.md). With a net/pin/label selected it styles it at once;
# with nothing selected it prompts you to click or drag-select net(s), applies, and ends
# (Esc cancels). Edit the style (named fields, any order, omitted -> default) and the key
# to taste -- e.g. {color blue thickness 3 pattern {20 20} angle 30 march march_fwd rate 2}.
# Plain F5 styles nets. Tk's <Key-F5> also matches a *modified* F5, and it lives on
# the SAME bindtag (.drw) as the generic <Key> -> C dispatch, so Tk runs only this
# (more specific) binding for any F5 -- a plain fall-through can't reach the registry.
# So forward Alt-F5 (%s & 8 = Mod1) into the C dispatch ourselves, where the default
# action registry maps it to tools.raise_ciw (raise the CIW); rebind via
# `xschem bind key 65474 alt canvas <action>` still takes effect through this forward.
# Non-Alt F5 applies the highlight as before.
bind .drw <Key-F5> {if {%s & 8} {xschem callback %W %T %x %y %N 0 0 %s} \
                    else {apply_hilight {color purple thickness 3 pattern {20 20}}}; break}
unset _ut

# ASE-L shows values in engineering notation (e.g. 104u). To recover
