version 1
simulator ngspice
design {lib sg13g2_tests_ase cell sp_parasitic_cap view schematic}
rundir {}
temperature 27
models {{file {$::MODELS_NGSPICE/cornerCAP.lib} section cap_typ}}
variables {}
analyses {{type op enabled 0} {type dc enabled 0} {type ac enabled 0} {type tran enabled 0}}
outputs {{name cseries expr cseries save 1 plot 1} {name rseries expr rseries save 1 plot 1}}
save_all_v 1
save_all_i 0
options {}
includes {}
pre_commands {{cmd {pre_osdi $::SG13G2_OSDI/psp103.osdi}} {cmd {pre_osdi $::SG13G2_OSDI/psp103_nqs.osdi}} {cmd {pre_osdi $::SG13G2_OSDI/r3_cmc.osdi}} {cmd {pre_osdi $::SG13G2_OSDI/mosvar.osdi}}}
viewer {}
