version 1
simulator ngspice
design {lib sg13g2_tests_ase cell dc_hbt_13g2_5t view schematic}
rundir {}
temperature 27
models {{file {$::MODELS_NGSPICE/cornerHBT.lib} section hbt_typ}}
variables {{name temp value 27}}
analyses {{type op enabled 1} {type dc enabled 1 source Vce start 0 stop 1.5 step 0.01} {type ac enabled 0} {type tran enabled 0}}
outputs {{name ivc expr i(vc) save 1 plot 1} {name ivc1 expr i(vc1) save 1 plot 1}}
save_all_v 1
save_all_i 1
options {{name savecurrents value 1}}
includes {}
pre_commands {{cmd {pre_osdi $::SG13G2_OSDI/psp103.osdi}} {cmd {pre_osdi $::SG13G2_OSDI/psp103_nqs.osdi}} {cmd {pre_osdi $::SG13G2_OSDI/r3_cmc.osdi}} {cmd {pre_osdi $::SG13G2_OSDI/mosvar.osdi}}}
viewer {}
