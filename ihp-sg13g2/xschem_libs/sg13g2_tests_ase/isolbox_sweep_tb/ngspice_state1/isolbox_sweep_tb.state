version 1
simulator ngspice
design {lib sg13g2_tests_ase cell isolbox_sweep_tb view schematic}
rundir {}
temperature 27
models {}
variables {{name temp value 27} {name iso_w value 3u} {name iso_l value 3u}}
analyses {{type op enabled 0} {type dc enabled 1 source I0 start -1m stop 1m step 1u} {type ac enabled 0} {type tran enabled 0}}
outputs {{name vbkpos expr vbk_pos save 0 plot 0} {name vbkneg expr vbk_neg save 0 plot 0}}
save_all_v 0
save_all_i 0
options {}
includes {{file {$::MODELS_NGSPICE/diodes.lib}}}
pre_commands {{cmd {pre_osdi $::SG13G2_OSDI/psp103.osdi}} {cmd {pre_osdi $::SG13G2_OSDI/psp103_nqs.osdi}} {cmd {pre_osdi $::SG13G2_OSDI/r3_cmc.osdi}} {cmd {pre_osdi $::SG13G2_OSDI/mosvar.osdi}}}
viewer {}
