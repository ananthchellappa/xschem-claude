version 1
simulator ngspice
design {lib sg13g2_tests_ase cell dc_res_temp view schematic}
rundir {}
temperature 27
models {{file {$::MODELS_NGSPICE/cornerRES.lib} section res_typ_stat}}
variables {{name temp value 27}}
analyses {{type op enabled 1} {type dc enabled 1 source temp start -40 stop 125 step 1} {type ac enabled 0} {type tran enabled 0}}
outputs {{name VccIVsil expr Vcc/I(Vsil) save 1 plot 0} {name VccIVppd expr Vcc/I(Vppd) save 1 plot 0} {name VccIVrh expr Vcc/I(Vrh) save 1 plot 0} {name ivrh expr i(vrh) save 1 plot 1} {name ivppd expr i(vppd) save 1 plot 1} {name ivsil expr i(vsil) save 1 plot 1}}
save_all_v 1
save_all_i 0
options {}
includes {}
pre_commands {{cmd {pre_osdi $::SG13G2_OSDI/psp103.osdi}} {cmd {pre_osdi $::SG13G2_OSDI/psp103_nqs.osdi}} {cmd {pre_osdi $::SG13G2_OSDI/r3_cmc.osdi}} {cmd {pre_osdi $::SG13G2_OSDI/mosvar.osdi}}}
viewer {}
