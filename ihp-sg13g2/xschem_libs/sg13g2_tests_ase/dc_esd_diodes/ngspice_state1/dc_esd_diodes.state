version 1
simulator ngspice
design {lib sg13g2_tests_ase cell dc_esd_diodes view schematic}
rundir {}
temperature 27
models {}
variables {{name temp value 27}}
analyses {{type op enabled 0} {type dc enabled 1 source V1 start -20.7 stop 3 step 1m} {type ac enabled 0} {type tran enabled 0}}
outputs {{name iVmda expr i(Vmda) save 1 plot 1} {name ivmda1 expr i(vmda1) save 1 plot 1}}
save_all_v 1
save_all_i 0
options {}
includes {{file {$::MODELS_NGSPICE/sg13g2_esd.lib}}}
pre_commands {{cmd {pre_osdi $::SG13G2_OSDI/psp103.osdi}} {cmd {pre_osdi $::SG13G2_OSDI/psp103_nqs.osdi}} {cmd {pre_osdi $::SG13G2_OSDI/r3_cmc.osdi}} {cmd {pre_osdi $::SG13G2_OSDI/mosvar.osdi}}}
viewer {}
