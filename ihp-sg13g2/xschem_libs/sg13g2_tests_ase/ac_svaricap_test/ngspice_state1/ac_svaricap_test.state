version 1
simulator ngspice
design {lib sg13g2_tests_ase cell ac_svaricap_test view schematic}
rundir {}
temperature 27
models {{file {$::MODELS_NGSPICE/cornerCAP.lib} section cap_typ} {file {$::MODELS_NGSPICE/cornerRES.lib} section res_typ} {file {$::MODELS_NGSPICE/cornerMOShv.lib} section mos_tt}}
variables {}
analyses {{type op enabled 0} {type dc enabled 0} {type ac enabled 1 start 1GHz stop 100GHz points 100} {type tran enabled 0}}
outputs {{name Ctot expr Ctot save 0 plot 1}}
save_all_v 1
save_all_i 0
options {}
includes {}
pre_commands {{cmd {pre_osdi $::SG13G2_OSDI/psp103.osdi}} {cmd {pre_osdi $::SG13G2_OSDI/psp103_nqs.osdi}} {cmd {pre_osdi $::SG13G2_OSDI/r3_cmc.osdi}} {cmd {pre_osdi $::SG13G2_OSDI/mosvar.osdi}}}
viewer {}
