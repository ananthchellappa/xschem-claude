version 1
simulator ngspice
design {lib sg13g2_tests_ase cell inv_sweep_tb view schematic}
rundir {}
temperature 27
models {{file {$::MODELS_NGSPICE/cornerMOSlv.lib} section mos_tt} {file {$::MODELS_NGSPICE/cornerMOShv.lib} section mos_tt} {file {$::MODELS_NGSPICE/cornerHBT.lib} section hbt_typ} {file {$::MODELS_NGSPICE/cornerRES.lib} section res_typ} {file {$::MODELS_NGSPICE/cornerCAP.lib} section cap_typ}}
variables {{name temp value 27} {name c1_val value 1p} {name r1_val value 100Meg} {name m1_w_val value 0.15u} {name m2_w_val value 0.15u} {name l_val value 0.13u} {name temp value 27} {name c1_val value 1p} {name r1_val value 100Meg} {name m1_w_val value 0.15u} {name m2_w_val value 0.15u} {name l_val value 0.13u}}
analyses {{type op enabled 1} {type dc enabled 0} {type ac enabled 1 start 1 stop 100G points 1001} {type tran enabled 1 stop 30n step 10p}}
outputs {{name gainpassbanddB expr gain_passband_dB save 1 plot 0} {name fcl expr fc_l save 1 plot 0} {name fcu expr fc_u save 1 plot 0} {name GBW expr GBW save 1 plot 0} {name gaindB expr gain_dB save 1 plot 1} {name invin expr inv_in save 1 plot 1} {name invout expr inv_out save 1 plot 1}}
save_all_v 1
save_all_i 1
options {{name warn value 1}}
includes {}
pre_commands {{cmd {pre_osdi $::SG13G2_OSDI/psp103.osdi}} {cmd {pre_osdi $::SG13G2_OSDI/psp103_nqs.osdi}} {cmd {pre_osdi $::SG13G2_OSDI/r3_cmc.osdi}} {cmd {pre_osdi $::SG13G2_OSDI/mosvar.osdi}}}
viewer {}
