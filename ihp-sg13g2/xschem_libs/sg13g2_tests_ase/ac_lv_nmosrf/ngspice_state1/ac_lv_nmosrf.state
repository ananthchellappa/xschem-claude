version 1
simulator ngspice
design {lib sg13g2_tests_ase cell ac_lv_nmosrf view schematic}
rundir {}
temperature 27
models {{file {$::MODELS_NGSPICE/cornerMOSlv.lib} section mos_tt} {file {$::MODELS_NGSPICE/cornerRES.lib} section res_typ}}
variables {{name temp value 27}}
analyses {{type op enabled 0} {type dc enabled 0} {type ac enabled 1 start 10meg stop 10000meg points 1001} {type tran enabled 0}}
outputs {{name vd2 expr vd2 save 1 plot 1} {name vd1 expr vd1 save 1 plot 1}}
save_all_v 1
save_all_i 0
options {}
includes {}
pre_commands {{cmd {pre_osdi $::SG13G2_OSDI/psp103.osdi}} {cmd {pre_osdi $::SG13G2_OSDI/psp103_nqs.osdi}} {cmd {pre_osdi $::SG13G2_OSDI/r3_cmc.osdi}} {cmd {pre_osdi $::SG13G2_OSDI/mosvar.osdi}}}
viewer {}
