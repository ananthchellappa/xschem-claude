version 1
simulator ngspice
design {lib sg13g2_tests_ase cell dc_lv_pmos view schematic}
rundir {}
temperature 27
models {{file {$::MODELS_NGSPICE/cornerMOSlv.lib} section mos_tt}}
variables {{name temp value 27}}
analyses {{type op enabled 1} {type dc enabled 1 source Vds start 0 stop -1.2 step -0.01} {type ac enabled 0} {type tran enabled 0}}
outputs {{name ivd expr i(vd) save 1 plot 1}}
save_all_v 1
save_all_i 1
options {{name savecurrents value 1}}
includes {}
pre_commands {{cmd {pre_osdi $::SG13G2_OSDI/psp103.osdi}} {cmd {pre_osdi $::SG13G2_OSDI/psp103_nqs.osdi}} {cmd {pre_osdi $::SG13G2_OSDI/r3_cmc.osdi}} {cmd {pre_osdi $::SG13G2_OSDI/mosvar.osdi}}}
viewer {}
