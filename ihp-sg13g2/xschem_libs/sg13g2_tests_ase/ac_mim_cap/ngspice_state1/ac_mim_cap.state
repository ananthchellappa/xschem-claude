version 1
simulator ngspice
design {lib sg13g2_tests_ase cell ac_mim_cap view schematic}
rundir {}
temperature 27
models {{file {$::MODELS_NGSPICE/cornerCAP.lib} section cap_typ}}
variables {}
analyses {{type op enabled 0} {type dc enabled 0} {type ac enabled 1 start 1e6 stop 1e9 points 1000} {type tran enabled 0}}
outputs {{name C expr C save 0 plot 0} {name mag expr mag save 0 plot 1}}
save_all_v 1
save_all_i 0
options {}
includes {}
pre_commands {{cmd {pre_osdi $::SG13G2_OSDI/psp103.osdi}} {cmd {pre_osdi $::SG13G2_OSDI/psp103_nqs.osdi}} {cmd {pre_osdi $::SG13G2_OSDI/r3_cmc.osdi}} {cmd {pre_osdi $::SG13G2_OSDI/mosvar.osdi}}}
viewer {}
