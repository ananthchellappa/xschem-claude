version 1
simulator ngspice
design {lib sg13g2_tests_ase cell ac_hbt_13g2 view schematic}
rundir {}
temperature 27
models {{file {$::MODELS_NGSPICE/cornerHBT.lib} section hbt_typ}}
variables {{name temp value 27}}
analyses {{type op enabled 1} {type dc enabled 0} {type ac enabled 1 start 10k stop 100meg points 10} {type tran enabled 0}}
outputs {{name Vc expr Vc save 1 plot 0} {name Vb expr Vb save 1 plot 0} {name IVce expr I(Vce) save 1 plot 0} {name vc expr vc save 1 plot 1}}
save_all_v 1
save_all_i 0
options {}
includes {}
pre_commands {{cmd {pre_osdi $::SG13G2_OSDI/psp103.osdi}} {cmd {pre_osdi $::SG13G2_OSDI/psp103_nqs.osdi}} {cmd {pre_osdi $::SG13G2_OSDI/r3_cmc.osdi}} {cmd {pre_osdi $::SG13G2_OSDI/mosvar.osdi}}}
viewer {}
