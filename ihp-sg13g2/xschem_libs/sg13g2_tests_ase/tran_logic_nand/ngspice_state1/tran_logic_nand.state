version 1
simulator ngspice
design {lib sg13g2_tests_ase cell tran_logic_nand view schematic}
rundir {}
temperature 27
models {{file {$::MODELS_NGSPICE/cornerMOSlv.lib} section mos_ff}}
variables {{name temp value 127}}
analyses {{type op enabled 0} {type dc enabled 0} {type ac enabled 0} {type tran enabled 1 stop 20n step 50p}}
outputs {{name out expr out save 1 plot 1} {name a expr a save 1 plot 1} {name b expr b save 1 plot 1}}
save_all_v 1
save_all_i 0
options {}
includes {}
pre_commands {{cmd {pre_osdi $::SG13G2_OSDI/psp103.osdi}} {cmd {pre_osdi $::SG13G2_OSDI/psp103_nqs.osdi}} {cmd {pre_osdi $::SG13G2_OSDI/r3_cmc.osdi}} {cmd {pre_osdi $::SG13G2_OSDI/mosvar.osdi}}}
viewer {}
