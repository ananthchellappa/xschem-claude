version 1
simulator ngspice
design {lib sg13g2_tests_ase cell inv_mc_tb view schematic}
rundir {}
temperature 27
models {{file {$::MODELS_NGSPICE/cornerMOSlv.lib} section mos_tt_stat} {file {$::MODELS_NGSPICE/cornerMOShv.lib} section mos_tt_stat} {file {$::MODELS_NGSPICE/cornerHBT.lib} section hbt_typ_stat} {file {$::MODELS_NGSPICE/cornerRES.lib} section res_typ_stat} {file {$::MODELS_NGSPICE/cornerCAP.lib} section cap_typ_stat}}
variables {}
analyses {{type op enabled 0} {type dc enabled 0} {type ac enabled 1 start 1 stop 100G points 1001} {type tran enabled 0}}
outputs {{name gainpassbanddB expr gain_passband_dB save 0 plot 0} {name fcl expr fc_l save 0 plot 0} {name fcu expr fc_u save 0 plot 0} {name GBW expr GBW save 0 plot 0}}
save_all_v 0
save_all_i 0
options {}
includes {}
pre_commands {{cmd {pre_osdi $::SG13G2_OSDI/psp103.osdi}} {cmd {pre_osdi $::SG13G2_OSDI/psp103_nqs.osdi}} {cmd {pre_osdi $::SG13G2_OSDI/r3_cmc.osdi}} {cmd {pre_osdi $::SG13G2_OSDI/mosvar.osdi}}}
viewer {}
