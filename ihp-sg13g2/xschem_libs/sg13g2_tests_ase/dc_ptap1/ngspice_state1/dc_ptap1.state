version 1
simulator ngspice
design {lib sg13g2_tests_ase cell dc_ptap1 view schematic}
rundir {}
temperature 27
models {{file {$::MODELS_NGSPICE/cornerRES.lib} section res_typ}}
variables {{name temp value 27}}
analyses {{type op enabled 1} {type dc enabled 1 source Vres start 0 stop 3 step 0.01} {type ac enabled 0} {type tran enabled 0}}
outputs {{name VccIVr expr Vcc/I(Vr) save 1 plot 0} {name ivr expr i(vr) save 1 plot 1}}
save_all_v 1
save_all_i 0
options {}
includes {}
pre_commands {{cmd {pre_osdi $::SG13G2_OSDI/psp103.osdi}} {cmd {pre_osdi $::SG13G2_OSDI/psp103_nqs.osdi}} {cmd {pre_osdi $::SG13G2_OSDI/r3_cmc.osdi}} {cmd {pre_osdi $::SG13G2_OSDI/mosvar.osdi}}}
viewer {}
