# gf180mcuD/cadence_style_rc
# Launch:  xschem --script /path/to/gf180mcuD/cadence_style_rc [cell.sch]
#
# Cadence-style GlobalFoundries 180MCU (gf180mcuD) design workarea. Layers three
# things, exactly like ../sky130A/cadence_style_rc:
#   1. the repo's Cadence UX + keybindings + forms (find_helper Ctrl+Shift+G,
#      instance_update Ctrl+Shift+I, connected stretch/move, crosshair, ...);
#   2. the migrated gf180 library registry in ./xschem_libs (Library Manager);
#   3. the gf180 SPICE models in ./models + the GF180MCU helper menu.
# See doc/claude/specs/gf180mcud_workarea.md.

# Anchor on this file's own directory (repo/gf180mcuD), so the workarea is
# relocatable within the repo.
set _ws [file dirname [file normalize [info script]]]

# --- 1. Cadence UX + keybindings + forms (from the repo) --------------------
# The repo rc sets its own OA registry (xschem_libs_newsym); we override it below.
source [file join $_ws .. src cadence_style_rc]

# --- 2. Library registry = the migrated gf180 tree --------------------------
# Registry-only (Cadence): the Library Manager shows exactly the DEFINEs in this
# tree's library.defs (gf180mcu_pr, gf180mcu_tests) plus devices + the general
# libs -> ../../xschem_libs_newsym/<lib>.
set XSCHEM_LIBRARY_DEFS [file join $_ws xschem_libs library.defs]
set library_registry_defs_only 1
set XSCHEM_LIBRARY_PATH {}
set library_default_layout nested
set launch_library_manager 1

# --- 3. Models + GF180MCU helper menu ---------------------------------------
# gf180 testbenches embed:  .include $::180MCU_MODELS/design.ngspice
#                           .lib     $::180MCU_MODELS/sm141064.ngspice typical
# so 180MCU_MODELS points straight at the vendored (flat, self-contained) dir.
set ::180MCU_MODELS [file join $_ws models]
# ASE-L defaults: preload the FULL GF180MCU typical corner in every fresh session
# / state view, so any gf180mcu_pr device (MOS / resistor / MIM & MOS cap / BJT /
# diode) netlists + simulates without an "unknown subckt" error. Each device class
# is its OWN .lib section in sm141064.ngspice (typical = MOS only), so they are
# listed explicitly. design.ngspice supplies the global-switch .params the model
# subckts reference (sw_stat_global, mc_skew, …); it is an .include (not a .lib
# section), seeded via ASE_DEFAULT_INCLUDES and emitted BEFORE the .lib sections
# (render_deck order) so the params exist when the models use them. Portable
# $::VAR form. To change corner, swap the section suffix (_typical -> _ss/_ff).
set ::ASE_DEFAULT_MODELS [list \
  [list file {$::180MCU_MODELS/sm141064.ngspice} section typical] \
  [list file {$::180MCU_MODELS/sm141064.ngspice} section res_typical] \
  [list file {$::180MCU_MODELS/sm141064.ngspice} section mimcap_typical] \
  [list file {$::180MCU_MODELS/sm141064.ngspice} section moscap_typical] \
  [list file {$::180MCU_MODELS/sm141064.ngspice} section bjt_typical] \
  [list file {$::180MCU_MODELS/sm141064.ngspice} section diode_typical]]
set ::ASE_DEFAULT_INCLUDES [list [list file {$::180MCU_MODELS/design.ngspice}]]
# PDK/PDK_ROOT are referenced by a couple of status strings.
if {![info exists ::env(PDK)]} { set ::env(PDK) gf180mcuD }
source [file join $_ws gf180_procs.tcl]

# Run the GF180MCU menu builder after each window is created (append, don't
# clobber any startup command the repo rc may have set).
if {[info exists user_startup_commands]} {
  append user_startup_commands "\ngf180_menupdk\n"
} else {
  set user_startup_commands "gf180_menupdk\n"
}

# ...and build it for the window that ALREADY exists. user_startup_commands alone
# is not enough for an rc loaded with `--script`: xinit.c runs
# eval_user_startup_commands (xinit.c:3789) BEFORE sourcing the --script file
# (xinit.c:3793), so appending here only affects windows created LATER — the
# first window came up with no GF180MCU menu at all. gf180_menupdk is idempotent.
if {[info exists ::has_x]} {
  after idle {catch {gf180_menupdk}}
}

# ASE-L shows values in engineering notation (e.g. 104u). To recover
# scientific notation, uncomment:
# set ase_eng_notation 0

unset _ws
