version 1
simulator ngspice
design {lib sky130_tests_ase cell LACG view schematic}
rundir {}
temperature 27
models {{file {$::SKYWATER_MODELS/sky130.lib.spice} section tt}}
variables {}
analyses {{type op enabled 0} {type dc enabled 0} {type ac enabled 0} {type tran enabled 1 stop 300n step 0.1n}}
outputs {{name clk expr clk save 1 plot 1} {name clkg expr clk_g save 1 plot 1} {name V1 expr V1 save 1 plot 1} {name V2 expr V2 save 1 plot 1} {name V3 expr V3 save 1 plot 1}}
save_all_v 0
save_all_i 0
options {}
includes {{file {$::SKYWATER_STDCELLS/sky130_fd_sc_hd.spice}}}
viewer {}
