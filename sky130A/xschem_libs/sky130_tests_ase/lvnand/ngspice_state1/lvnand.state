analyses {{type op enabled 0} {type dc enabled 1 source vd start 0 stop 2 step 0.01} {type ac enabled 0} {type tran enabled 0}}
outputs {}
save_all_v 0
save_all_i 0
options {{name method value gear} {name seed value 12}}
includes {}
viewer {}
