version 1
simulator ngspice
design {lib sky130_tests_ase cell test_mos_binning view schematic}
rundir {}
temperature 27
models {{file {$::SKYWATER_MODELS/sky130.lib.spice} section tt}}
variables {{name VGATE value 1} {name VDRAIN value 1} {name WIDTH value 1} {name LENGTH value 0.15}}
analyses {{type op enabled 1} {type dc enabled 0} {type ac enabled 0} {type tran enabled 0}}
outputs {{name ivd2 expr i(vd2) save 1 plot 0} {name Id expr i(curr) save 1 plot 1}}
save_all_v 0
save_all_i 0
options {{name wnflag value 1} {name savecurrents value 1}}
includes {}
pre_commands {}
viewer {}
