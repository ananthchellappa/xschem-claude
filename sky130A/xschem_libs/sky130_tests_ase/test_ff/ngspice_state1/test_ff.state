version 1
simulator ngspice
design {lib sky130_tests_ase cell test_ff view schematic}
rundir {}
temperature 27
models {{file {$::SKYWATER_MODELS/sky130.lib.spice} section tt}}
variables {}
analyses {{type op enabled 0} {type dc enabled 0} {type ac enabled 0} {type tran enabled 1 stop 100n step 0.2n}}
outputs {}
save_all_v 1
save_all_i 0
options {{name savecurrents value 1}}
includes {{file {$::SKYWATER_STDCELLS/sky130_fd_sc_hd.spice}}}
viewer {}
