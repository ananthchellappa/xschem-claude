v {xschem version=2.9.9 file_version=1.2}
G {type=subcircuit
format="@name @pinlist @symname"
template="name=x1"
}

T {@symname} -49.5 -6 0 0 0.3 0.3 {}
T {@name} 135 -62 0 0 0.2 0.2 {}
L 4 -130 -50 130 -50 {}
L 4 -130 50 130 50 {}
L 4 -130 -50 -130 50 {}
L 4 130 -50 130 50 {}
B 5 -152.5 -42.5 -147.5 -37.5 {show_pinname=true name_dx=25 name_dy=-4 name_size=0.2 name=START dir=in }
L 4 -150 -40 -130 -40 {}
B 5 -152.5 -22.5 -147.5 -17.5 {show_pinname=true name_dx=25 name_dy=-4 name_size=0.2 name=CLK dir=in }
L 4 -150 -20 -130 -20 {}
B 5 -152.5 -2.5 -147.5 2.5 {show_pinname=true name_dx=25 name_dy=-4 name_size=0.2 name=EN_N dir=in }
L 4 -150 0 -130 0 {}
B 5 147.5 -42.5 152.5 -37.5 {show_pinname=true name_dx=-25 name_dy=-4 name_size=0.2 name_flip=1 name=VBG dir=out }
L 4 130 -40 150 -40 {}
B 5 -152.5 17.5 -147.5 22.5 {show_pinname=true name_dx=25 name_dy=-4 name_size=0.2 name=VCC dir=in }
L 4 -150 20 -130 20 {}
B 5 -152.5 37.5 -147.5 42.5 {show_pinname=true name_dx=25 name_dy=-4 name_size=0.2 name=VSS dir=in }
L 4 -150 40 -130 40 {}
