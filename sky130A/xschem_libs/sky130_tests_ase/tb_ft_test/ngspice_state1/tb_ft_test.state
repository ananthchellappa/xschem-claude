version 1
simulator ngspice
design {lib sky130_tests_ase cell tb_ft_test view schematic}
rundir {}
temperature 27
models {{file {$::SKYWATER_MODELS/sky130.lib.spice} section tt}}
variables {}
analyses {{type op enabled 1} {type dc enabled 0} {type ac enabled 1 start 1k stop 100G points 10} {type tran enabled 0}}
outputs {{name ft expr ft save 1 plot 1} {name ivg expr i(vg) save 1 plot 1} {name ivd expr i(vd) save 1 plot 1}}
save_all_v 1
save_all_i 1
options {{name savecurrents value 1}}
includes {}
pre_commands {}
viewer {}
