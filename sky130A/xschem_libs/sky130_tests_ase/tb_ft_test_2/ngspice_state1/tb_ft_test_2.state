version 1
simulator ngspice
design {lib sky130_tests_ase cell tb_ft_test_2 view schematic}
rundir {}
temperature 27
models {{file {$::SKYWATER_MODELS/sky130.lib.spice} section tt}}
variables {}
analyses {{type op enabled 1} {type dc enabled 0} {type ac enabled 1 start 1000 stop 1000G points 10} {type tran enabled 1 stop 2n step 0.001n}}
outputs {{name ivg expr i(vg) save 1 plot 1} {name ivd expr i(vd) save 1 plot 1} {name dbivdivg expr db(i(vd)/i(vg)) save 1 plot 1}}
save_all_v 1
save_all_i 0
options {{name wnflag value 1} {name method value gear} {name savecurrents value 1}}
includes {{file tb_ft_test_2.save}}
pre_commands {}
viewer {}
