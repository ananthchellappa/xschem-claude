version 1
simulator ngspice
design {lib sky130_tests_ase cell test_res view schematic}
rundir {}
temperature 27
models {{file {$::SKYWATER_MODELS/sky130.lib.spice} section tt}}
variables {}
analyses {{type op enabled 0} {type dc enabled 1 source temp start -40 stop 140 step 1} {type ac enabled 0} {type tran enabled 0}}
outputs {{name p expr vs(p) save 1 plot 1} {name ivr2 expr is(vr2) save 1 plot 1} {name ivr9 expr is(vr9) save 1 plot 1} {name ivr3 expr is(vr3) save 1 plot 1} {name ivr4 expr is(vr4) save 1 plot 1} {name ivr1 expr is(vr1) save 1 plot 1} {name ivr5 expr is(vr5) save 1 plot 1} {name ivr10 expr is(vr10) save 1 plot 1} {name ivr12 expr is(vr12) save 1 plot 1} {name ivr6 expr is(vr6) save 1 plot 1} {name ivr8 expr is(vr8) save 1 plot 1} {name ivr16 expr is(vr16) save 1 plot 1} {name ivr17 expr is(vr17) save 1 plot 1} {name ivr23 expr is(vr23) save 1 plot 1} {name ivr24 expr is(vr24) save 1 plot 1} {name ivr26 expr is(vr26) save 1 plot 1} {name ivr28 expr is(vr28) save 1 plot 1} {name ivr7 expr is(vr7) save 1 plot 1} {name ivr25 expr is(vr25) save 1 plot 1} {name ivr15 expr is(vr15) save 1 plot 1} {name ivr27 expr is(vr27) save 1 plot 1}}
save_all_v 1
save_all_i 0
options {{name savecurrents value 1}}
includes {}
pre_commands {}
viewer {}
