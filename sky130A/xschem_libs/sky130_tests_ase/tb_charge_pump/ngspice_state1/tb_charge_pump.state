version 1
simulator ngspice
design {lib sky130_tests_ase cell tb_charge_pump view schematic}
rundir {}
temperature 27
models {{file {$::SKYWATER_MODELS/sky130.lib.spice} section tt}}
variables {{name VCC value 1.8} {name FREQ value 100e6} {name PER value {{1/FREQ}}}}
analyses {{type op enabled 0} {type dc enabled 0} {type ac enabled 0} {type tran enabled 1 stop 5u step 100p}}
outputs {{name CK expr CK save 1 plot 1} {name A expr A save 1 plot 1} {name B expr B save 1 plot 1} {name C expr C save 1 plot 1} {name D expr D save 1 plot 1} {name VCC expr VCC save 1 plot 1} {name HV expr HV save 1 plot 1} {name HV2 expr HV2 save 1 plot 1} {name HVIDEAL expr HV_IDEAL save 1 plot 1} {name ivload expr i(vload) save 1 plot 1} {name HVIDEAL2 expr HV_IDEAL2 save 1 plot 1}}
save_all_v 1
save_all_i 0
options {{name savecurrents value 1}}
includes {{file {$::SKYWATER_STDCELLS/sky130_fd_sc_hd.spice}}}
pre_commands {}
viewer {}
