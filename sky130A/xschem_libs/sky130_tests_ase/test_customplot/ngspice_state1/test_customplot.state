version 1
simulator ngspice
design {lib sky130_tests_ase cell test_customplot view schematic}
rundir {}
temperature 27
models {{file {$::SKYWATER_MODELS/sky130.lib.spice} section tt}}
variables {{name W value 2}}
analyses {{type op enabled 1} {type dc enabled 0} {type ac enabled 0} {type tran enabled 1 stop 500n step 0.1n}}
outputs {{name b expr b save 1 plot 1} {name a expr a save 1 plot 1} {name del expr del save 1 plot 1}}
save_all_v 1
save_all_i 0
options {}
includes {}
pre_commands {}
viewer {}
