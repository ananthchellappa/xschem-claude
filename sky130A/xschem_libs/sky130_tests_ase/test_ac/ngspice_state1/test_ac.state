version 1
simulator ngspice
design {lib sky130_tests_ase cell test_ac view schematic}
rundir {}
temperature 27
models {{file {$::SKYWATER_MODELS/sky130.lib.spice} section tt}}
variables {}
analyses {{type op enabled 1} {type dc enabled 0} {type ac enabled 1 start 1 stop 1e12 points 10} {type tran enabled 1 stop 100n step 0.1n}}
outputs {{name out expr out save 1 plot 1} {name minus expr minus save 1 plot 1} {name phout expr ph(out) save 1 plot 1}}
save_all_v 1
save_all_i 0
options {{name reltol value 1e-5}}
includes {{file test_ac.save}}
viewer {}
