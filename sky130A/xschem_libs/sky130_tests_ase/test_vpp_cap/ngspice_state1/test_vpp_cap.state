version 1
simulator ngspice
design {lib sky130_tests_ase cell test_vpp_cap view schematic}
rundir {}
temperature 27
models {{file {$::SKYWATER_MODELS/sky130.lib.spice} section tt}}
variables {}
analyses {{type op enabled 0} {type dc enabled 0} {type ac enabled 0} {type tran enabled 1 stop 6u step 10n}}
outputs {{name g1 expr g1 save 1 plot 1} {name g2 expr g2 save 1 plot 1} {name g3 expr g3 save 1 plot 1} {name g4 expr g4 save 1 plot 1} {name ivc1 expr i(vc1) save 1 plot 1} {name ivc2 expr i(vc2) save 1 plot 1} {name ivc3 expr i(vc3) save 1 plot 1} {name ivc4 expr i(vc4) save 1 plot 1}}
save_all_v 1
save_all_i 0
options {}
includes {}
viewer {}
