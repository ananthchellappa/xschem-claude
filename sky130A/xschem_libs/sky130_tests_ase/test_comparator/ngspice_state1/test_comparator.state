version 1
simulator ngspice
design {lib sky130_tests_ase cell test_comparator view schematic}
rundir {}
temperature 27
models {{file {$::SKYWATER_MODELS/sky130.lib.spice} section tt_mm}}
variables {{name VCCGAUSS value {agauss(1.8, 0.05, 1)}} {name VCC value 'VCCGAUSS'} {name VDLGAUSS value {agauss(0.9, 0.23, 1)}} {name VDL value VDLGAUSS} {name TEMPGAUSS value {agauss(40, 30, 1)}} {name DELTA value 0.002}}
analyses {{type op enabled 1} {type dc enabled 0} {type ac enabled 0} {type tran enabled 1 stop 250n step 0.1n}}
outputs {{name saout expr saout save 1 plot 1} {name cal expr cal save 1 plot 1} {name ivvcc expr i(vvcc) save 1 plot 1} {name en expr en save 1 plot 1} {name plus expr plus save 1 plot 1} {name minus expr minus save 1 plot 1} {name temperat expr temperat save 1 plot 1} {name vcc expr vcc save 1 plot 1} {name vss expr vss save 1 plot 0} {name gp1 expr gp1 save 1 plot 0} {name gp2 expr gp2 save 1 plot 0} {name gn1 expr gn1 save 1 plot 0} {name gn2 expr gn2 save 1 plot 0} {name vssi expr vssi save 1 plot 0} {name outdiff expr outdiff save 1 plot 1} {name saoutf expr saoutf save 1 plot 1} {name zero0 expr zero0 save 1 plot 1} {name zero1 expr zero1 save 1 plot 1} {name zero2 expr zero2 save 1 plot 1} {name GN1 expr GN1 save 1 plot 1} {name GP1 expr GP1 save 1 plot 1} {name GN2 expr GN2 save 1 plot 1} {name GP2 expr GP2 save 1 plot 1}}
save_all_v 1
save_all_i 0
options {{name chgtol value 4e-16} {name method value gear} {name temp value 'TEMPGAUSS'}}
includes {}
pre_commands {}
viewer {}
