version 1
simulator ngspice
design {lib sky130_tests_ase cell nfet_test_claude view schematic}
rundir {}
temperature 27
models {{file {$::SKYWATER_MODELS/sky130.lib.spice} section tt}}
variables {}
analyses {{type op enabled 1} {type dc enabled 0} {type ac enabled 0} {type tran enabled 0}}
outputs {{name iv1 expr -i(v1) save 1 plot 0}}
save_all_v 1
save_all_i 0
options {{name savecurrents value 1}}
includes {}
viewer {}
