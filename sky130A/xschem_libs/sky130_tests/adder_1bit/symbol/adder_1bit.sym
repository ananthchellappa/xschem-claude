G {type=subcircuit
format="@name @pinlist @symname"
template="name=x0"
}

T {@symname} -45 -6 0 0 0.3 0.3 {}
T {@name} 135 -42 0 0 0.2 0.2 {}
L 4 -130 -30 130 -30 {}
L 4 -130 30 130 30 {}
L 4 -130 -30 -130 30 {}
L 4 130 -30 130 30 {}
B 5 147.5 -22.5 152.5 -17.5 {show_pinname=true name_dx=-25 name_dy=-4 name_size=0.2 name_flip=1 name=S dir=out }
L 4 130 -20 150 -20 {}
B 5 -152.5 -22.5 -147.5 -17.5 {show_pinname=true name_dx=25 name_dy=-4 name_size=0.2 name=A dir=in }
L 4 -150 -20 -130 -20 {}
B 5 -152.5 -2.5 -147.5 2.5 {show_pinname=true name_dx=25 name_dy=-4 name_size=0.2 name=B dir=in }
L 4 -150 0 -130 0 {}
B 5 147.5 -2.5 152.5 2.5 {show_pinname=true name_dx=-25 name_dy=-4 name_size=0.2 name_flip=1 name=G dir=out }
L 4 130 0 150 0 {}
B 5 -152.5 17.5 -147.5 22.5 {show_pinname=true name_dx=25 name_dy=-4 name_size=0.2 name=CIN dir=in }
L 4 -150 20 -130 20 {}
B 5 147.5 17.5 152.5 22.5 {show_pinname=true name_dx=-25 name_dy=-4 name_size=0.2 name_flip=1 name=P dir=out }
L 4 130 20 150 20 {}
