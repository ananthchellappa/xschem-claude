G {type=subcircuit
format="@name @pinlist @symname"
template="name=x0"
}

T {@symname} -40.5 -6 0 0 0.3 0.3 {}
T {@name} 135 -72 0 0 0.2 0.2 {}
L 4 -130 -60 130 -60 {}
L 4 -130 60 130 60 {}
L 4 -130 -60 -130 60 {}
L 4 130 -60 130 60 {}
B 5 147.5 -52.5 152.5 -47.5 {show_pinname=true name_dx=-25 name_dy=-4 name_size=0.2 name_flip=1 name=SG dir=out }
L 4 130 -50 150 -50 {}
B 5 147.5 -32.5 152.5 -27.5 {show_pinname=true name_dx=-25 name_dy=-4 name_size=0.2 name_flip=1 name=SP dir=out }
L 4 130 -30 150 -30 {}
B 5 147.5 -12.5 152.5 -7.5 {show_pinname=true name_dx=-25 name_dy=-4 name_size=0.2 name_flip=1 name=C1 dir=out }
L 4 130 -10 150 -10 {}
B 5 -152.5 -52.5 -147.5 -47.5 {show_pinname=true name_dx=25 name_dy=-4 name_size=0.2 name=P[3:0] dir=in }
L 4 -150 -50 -130 -50 {}
B 5 147.5 7.5 152.5 12.5 {show_pinname=true name_dx=-25 name_dy=-4 name_size=0.2 name_flip=1 name=C2 dir=out }
L 4 130 10 150 10 {}
B 5 -152.5 -32.5 -147.5 -27.5 {show_pinname=true name_dx=25 name_dy=-4 name_size=0.2 name=G[3:0] dir=in }
L 4 -150 -30 -130 -30 {}
B 5 147.5 27.5 152.5 32.5 {show_pinname=true name_dx=-25 name_dy=-4 name_size=0.2 name_flip=1 name=C3 dir=out }
L 4 130 30 150 30 {}
B 5 147.5 47.5 152.5 52.5 {show_pinname=true name_dx=-25 name_dy=-4 name_size=0.2 name_flip=1 name=C4 dir=out }
L 4 130 50 150 50 {}
B 5 -152.5 -12.5 -147.5 -7.5 {show_pinname=true name_dx=25 name_dy=-4 name_size=0.2 name=C0 dir=in }
L 4 -150 -10 -130 -10 {}
