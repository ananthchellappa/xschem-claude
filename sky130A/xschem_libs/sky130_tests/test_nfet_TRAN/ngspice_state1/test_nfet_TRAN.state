version 1
simulator ngspice
design {lib sky130_tests cell test_nfet_TRAN view schematic}
rundir {}
temperature 27
models {{file $::SKYWATER_MODELS/sky130.lib.spice section tt}}
variables {{name Vgs value 1.8} {name Vds value 1.0}}
analyses {{type op enabled 1} {type dc enabled 0} {type ac enabled 0} {type tran enabled 1 step 1n stop 200n}}
outputs {{name id expr -i(v1) save 1 plot 0}}
save_all_v 1
save_all_i 0
options {{name savecurrents value 1}}
includes {}
pre_commands {}
viewer {open 1 sharedx 0 rawfile {} graphs {{traces {{expr v(g) name {} vec v(g) color 4} {expr v(d) name {} vec v(d) color 5}} logx 0 logy 0 x1 -6.624999999999993e-8 x2 2.462499999999998e-7 y1 -0.09000000000000007 y2 1.71}}}
