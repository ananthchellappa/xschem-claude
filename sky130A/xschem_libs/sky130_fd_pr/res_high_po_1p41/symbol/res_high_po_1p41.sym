G {}
K {type=high_precision_poly_resistor
format="tcleval([
  if \{[info commands sky130_res_series] eq \{\}\} \{
    catch \{source [file join [file dirname [file dirname [file dirname [abs_sym_path [string trim \{ @symref \}]]]]] sky130_res.tcl]\}
  \}
  if \{[info commands sky130_res_series] ne \{\}\} \{
    sky130_res_series \{ @ns \} \{ @spiceprefix@name \} \{ @pinlist \} \{ sky130_fd_pr__@model L=@L mult=@mult m=@mult \}
  \} elseif \{\{ @ns \} eq \{ 1 \}\} \{
    return \{@spiceprefix@name @pinlist sky130_fd_pr__@model L=@L mult=@mult m=@mult \}
  \} else \{
    return \{* @name : ns=@ns needs sky130_res_series from sky130_fd_pr/sky130_res.tcl, which could not be loaded
@spiceprefix@name @pinlist ns_not_expanded__sky130_fd_pr__@model L=@L mult=@mult m=@mult \}
  \}
])"
template="name=R1
L=1.41
model=res_high_po_1p41
spiceprefix=X
mult=1
ns=1"
edit_form=sky130_res
}
V {}
S {}
E {}
L 4 0 20 0 30 {}
L 4 0 20 7.5 17.5 {}
L 4 -7.5 12.5 7.5 17.5 {}
L 4 -7.5 12.5 7.5 7.5 {}
L 4 -7.5 2.5 7.5 7.5 {}
L 4 -7.5 2.5 7.5 -2.5 {}
L 4 -7.5 -7.5 7.5 -2.5 {}
L 4 -7.5 -7.5 7.5 -12.5 {}
L 4 -7.5 -17.5 7.5 -12.5 {}
L 4 -7.5 -17.5 0 -20 {}
L 4 0 -30 0 -20 {}
B 5 -2.5 27.5 2.5 32.5 {show_pinname=false name_dx=-25 name_dy=-5 name_size=0.2 name_flip=1 name=M dir=inout propag=1 pinnumber=2}
B 5 -2.5 -32.5 2.5 -27.5 {show_pinname=false name_dx=-25 name_dy=-5 name_size=0.2 name_flip=1 name=P dir=inout propag=0 pinnumber=1}
B 5 -22.5 -2.5 -17.5 2.5 {show_pinname=false name_dx=-25 name_dy=-5 name_size=0.2 name_flip=1 name=B dir=inout pinnumber=1}
T {B} -15 -12.5 0 1 0.15 0.15 {layer=7}
T {@name} 15 -27.5 0 0 0.2 0.2 {}
T {@mult * 1.41 / @L} 15 13.75 0 0 0.2 0.2 {layer=13}
T {@model} 15 -13.75 0 0 0.2 0.2 {}
T {tcleval(R=[to_eng [ev \{ (255.8 + 324.4 * @L / 1.41) * @ns / @mult \}]])} 15 0 0 0 0.2 0.2 {layer=13}
T {tcleval([string trim [expr \{\{ @ns \} eq \{ 1 \} ? \{\} : \{ns=@ns \}\}]])} 15 27.5 0 0 0.2 0.2 {layer=13}
