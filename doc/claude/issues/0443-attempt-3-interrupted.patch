+# only_toplevel, the three walks of row S29.
+set S3_OTL_TOP [list \
+  {.save all} \
+  {.save @m.xmok[id]} {.save @m.xmok[gm]} \
+  {.save @m.xmotl[id]} {.save @m.xmotl[gm]}]
+set S3_OTL_SUB [list \
+  {.save all} \
+  {.save @m.x1.xmok[id]} {.save @m.x1.xmok[gm]} \
+  {.save @m.xmtop[id]} {.save @m.xmtop[gm]}]
