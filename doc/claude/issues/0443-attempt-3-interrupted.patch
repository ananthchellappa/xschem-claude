+## A DOTFILE-AWARE census of a directory (rows T15, T33). -> sorted list.
+##
+## ⚠ `glob *` CANNOT SEE THE LEAK IT IS SUPPOSED TO CATCH, MEASURED. The C
+## netlister writes its own temp as `<netlist_dir>/.<cell>_<pid>`
+## (spice_netlist.c:304), a DOTFILE, and plain `glob` skips those. Right now
+## `~/.xschem/op_annot` holds `.ptop_1110704`, `.s3badtop_1110204` and
+## `.s3badtop_1110424` — corpses of an interrupted session — while T15 passes
+## green against a `glob *` that cannot see any of them.
+proc opa_t_dircensus {dir} {
+  if {$dir eq {} || ![file isdirectory $dir]} { return {} }
+  set out {}
+  foreach f [glob -nocomplain -tails -directory $dir *] { lappend out $f }
+  foreach f [glob -nocomplain -tails -directory $dir .*] {
+    if {$f eq {.} || $f eq {..}} { continue }
+    lappend out $f
+  }
+  return [lsort -unique $out]
+}
+## What the run ADDED. A delta, not an emptiness assertion: the oracle dir is a
+## real user directory that may legitimately hold litter this suite did not
+## create and does not own, and a row that redded on someone else's corpse
+## would be noise rather than a guardian (decision D15).
+proc opa_t_delta {before after} {
+  set out {}
+  foreach f $after { if {[lsearch -exact $before $f] < 0} { lappend out $f } }
+  return $out
+}
