+set s2b_idx {}
+catch {set s2b_idx [op_annot::_deck_index [op_annot::_oracle_deck]]}
+set s2b {}
+catch {
+  ## instance 0 of s3top is x1; descend into it so x2[1:0] is instance 0 here.
