+opa_t_write [file join $lib pureg.sym] [opa_t_symtxt {}]
+opa_t_write [file join $lib pureg.sch] "v {xschem version=3.4.4 file_version=1.2}
+G {}
+V {}
+S {}
+E {}
+C {pdev.sym} 0 0 0 0 {name=MREAL}
+C {devices/code_shown.sym} 100 0 0 0 {name=CODE only_toplevel=false value=\".subckt helper a b
+Rh a b 1k
+.ends\"}
