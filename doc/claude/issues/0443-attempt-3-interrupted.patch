+## THE ORACLE'S NETLIST INVOCATION, COUNTED — and in `nowrite` mode, defeated.
+##
+## Two seams, two failures, two rows. `_oracle_dir_ready` answers "can this
+## directory hold a deck at all", and `_oracle_run` is the ONE place
+## `xschem netlist -keep_symbols -noalert` is issued. Without the split, the
+## directory pre-check short-circuits T16 before the netlist ever runs and the
+## "the netlist ran and wrote no deck" branch (decision N6) becomes unreachable
+## from ANY test — a green check certifying nothing, which is the exact shape
+## that has now reverted this step twice (decision D12).
+##
+## ⚠ THE SHIM IS NOT THE ASSERTION. If `_oracle_run` does not exist, this shim
+## defines a proc nobody calls and the hit count is 0 — which is what the
+## "issued zero times" leg WANTS, so that leg alone would pass vacuously against
+## an absent seam. Every row below therefore also asserts the seam EXISTS, and
+## captures that BEFORE arming the shim.
+set ::opa_t_run_hits 0
+set ::opa_t_runshim_mode pass
+proc opa_t_runshim_on {mode} {
+  set ::opa_t_run_hits 0
+  set ::opa_t_runshim_mode $mode
+  set ::opa_t_runshim_had [expr {[info commands ::op_annot::_oracle_run] ne {}}]
+  if {$::opa_t_runshim_had} {
+    catch {rename ::op_annot::_oracle_run ::op_annot::_oracle_run_realt}
+  }
+  proc ::op_annot::_oracle_run {out} {
+    incr ::opa_t_run_hits
+    ## `nowrite`: the netlist "ran" and produced no deck. The N6 branch, forced
+    ## without a broken PDK and without an unwritable directory.
+    if {$::opa_t_runshim_mode eq {nowrite}} { return {} }
+    return [::op_annot::_oracle_run_realt $out]
+  }
+}
+proc opa_t_runshim_off {} {
+  catch {rename ::op_annot::_oracle_run {}}
+  if {$::opa_t_runshim_had} {
+    catch {rename ::op_annot::_oracle_run_realt ::op_annot::_oracle_run}
+  }
+}
