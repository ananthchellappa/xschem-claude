+# one that names a device the generated deck actually contains, and it is the
+# only one that makes write_save_file's `<current cell>.save` filename agree with
+# its own body. Entered at `.x1.`, S3_GOLD loses its `x1.` prefix AND the two M9
+# lines — that difference is the row.
+set S3_MIDGOLD [list \
+  {.save all} \
+  {.save @m.x2[1].xm1.msky130_fd_pr__nfet_01v8[id]} \
+  {.save @m.x2[1].xm1.msky130_fd_pr__nfet_01v8[gm]} \
+  {.save @m.x2[1].xm1.msky130_fd_pr__nfet_01v8[vth]} \
+  {.save @m.x2[0].xm1.msky130_fd_pr__nfet_01v8[id]} \
+  {.save @m.x2[0].xm1.msky130_fd_pr__nfet_01v8[gm]} \
+  {.save @m.x2[0].xm1.msky130_fd_pr__nfet_01v8[vth]} \
+  {.save @m.xm5.msky130_fd_pr__nfet_01v8[id]} \
+  {.save @m.xm5.msky130_fd_pr__nfet_01v8[gm]} \
+  {.save @m.xm5.msky130_fd_pr__nfet_01v8[vth]}]
