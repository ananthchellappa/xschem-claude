+# The filter fixture's descriptor: PERMISSIVE (no `match` key) and template-borne,
+# because the filter is about the netlist and not about which PDK owns the cell.
+set S3_FTMPL  {\@m.@path@spiceprefix@name}
+set S3_FPARAM {{id id 0} {gm gm 1}}
+set S3_FDESC  [list devpath $S3_FTMPL params $S3_FPARAM]
