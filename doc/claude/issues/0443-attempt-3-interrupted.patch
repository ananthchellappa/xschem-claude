+# --- section T helpers --------------------------------------------------------
+## The netlist globals the oracle forces, as one comparable tuple.
+proc opa_t_netenv {} {
+  set out {}
+  foreach v {netlist_dir local_netlist_dir flat_netlist split_files} {
+    if {[info exists ::$v]} { lappend out [set ::$v] } else { lappend out ABSENT }
+  }
+  if {[catch {xschem get netlist_type} nt]} { set nt RAISED }
+  lappend out $nt
+  return $out
+}
+
+## THE TEST'S OWN, INDEPENDENT ORACLE (row T7). Deliberately NOT
+## op_annot::_oracle_deck: if the cross-check reused the implementation's own
+## deck reader, a broken reader would move both sides of the comparison and the
+## row could not fail. Save/restore netlist_dir and netlist_type exactly as
+## opa_s3_netlist_elems does.
+proc opa_t_netlist_text {} {
+  global scratch
+  set dir [file join $scratch tnl]
+  file mkdir $dir
+  set out [file join $dir xcheck.spice]
+  catch {file delete -force $out}
+  set old_nd {} ; set old_nt {}
+  if {[info exists ::netlist_dir]} { set old_nd $::netlist_dir }
+  catch {set old_nt [xschem get netlist_type]}
+  set ::netlist_dir $dir
+  catch {xschem set netlist_type spice}
+  catch {xschem netlist -keep_symbols $out}
+  if {$old_nd ne {}} { set ::netlist_dir $old_nd }
+  if {$old_nt ne {}} { catch {xschem set netlist_type $old_nt} }
+  if {![file isfile $out]} { return NO-NETLIST }
+  set fh [open $out r] ; set body [read $fh] ; close $fh
+  return $body
+}
+
+## The deck's OWN hierarchical device set, by recursive expansion of its blocks:
+## a line whose LAST token names a `.subckt` in the same deck is a subcircuit
+## call and is recursed into with `<element>.` prepended; anything else is a
+## device. -> a sorted set like {xmtop xplain.xma xplain.xleaf.xmb ...}.
+##
+## ⚠ THE REGION MARKERS ARE ANCHORED PATTERNS, AND THAT IS NOT PEDANTRY. Written
+## as `string match {****begin*}` the `*`s are WILDCARDS, so the pattern means
+## "any line containing begin" — and `****end*` then swallows `.ends`, leaving
+## the previous block open so the NEXT stray line is attributed to it. Measured
+## while writing this file: that spelling put `Rfake` (psymdef's attribute text)
+## inside the `pstop` block and invented a device `xstop.rfake`.
+proc opa_t_deckdevs {body} {
+  set blocks {} ; set cur {} ; set inuser 0 ; set top {}
+  foreach l [split $body \n] {
+    set t [string trim $l]
+    if {$t eq {}} { continue }
+    if {[string match {\*\*\*\* begin user architecture*} $t]} { set inuser 1 ; continue }
+    if {[string match {\*\*\*\* end user architecture*} $t]}   { set inuser 0 ; continue }
+    set d $t
+    if {[string range $d 0 1] eq {**}} { set d [string trim [string range $d 2 end]] }
+    if {[regexp -nocase {^\.subckt[ \t]+([^ \t]+)} $d -> nm]} {
+      set cur [string tolower $nm]
+      if {$top eq {}} { set top $cur }
+      if {![dict exists $blocks $cur]} { dict set blocks $cur {} }
+      continue
+    }
+    if {[regexp -nocase {^\.ends} $d]} { set cur {} ; continue }
+    if {$cur eq {} || $inuser} { continue }
+    set c [string index $t 0]
+    if {$c eq {*} || $c eq {.} || $c eq {+}} { continue }
+    dict lappend blocks $cur [string tolower $t]
+  }
+  set out {}
+  opa_t_expand blocks $top {} out
+  return [lsort -unique $out]
+}
+proc opa_t_expand {bv name pfx ov} {
+  upvar 1 $bv blocks $ov out
+  if {![dict exists $blocks $name]} { return }
+  foreach line [dict get $blocks $name] {
+    set toks [split $line]
+    set e [lindex $toks 0]
+    set last [lindex $toks end]
+    if {[dict exists $blocks $last] && $last ne $name} {
+      opa_t_expand blocks $last "$pfx$e." out
+    } else { lappend out "$pfx$e" }
+  }
+}
+
+## The device paths a block names, `@m.` stripped, as a sorted set.
+proc opa_t_carddevs {block} {
+  set out {}
+  foreach d [opa_s3_devs [opa_s3_lines $block]] { lappend out [string range $d 3 end] }
+  return [lsort -unique $out]
+}
+
+## -> {deckdevs carddevs subset?}. The counts are implicit in the two lists, so
+## an empty-vs-empty run cannot pass.
+proc opa_t_xcheck {cell} {
+  opa_s3_load $cell.sch
+  set deck [opa_t_deckdevs [opa_t_netlist_text]]
+  opa_s3_load $cell.sch
+  set cards {}
+  if {[catch {opa_t_carddevs [op_annot::save_cards]} cards]} { set cards CARDS-RAISED }
+  set sub 1
+  if {$cards eq {CARDS-RAISED}} { set sub 0 } else {
+    foreach c $cards { if {[lsearch -exact $deck $c] < 0} { set sub 0 } }
+  }
+  return [list $deck $cards $sub]
+}
+
+## The two truth tables, as {name flag name flag ...}. `which` is `net` or `desc`.
+proc opa_t_table {idx which} {
+  set out {}
+  for {set i 0} {$i < [xschem get instances]} {incr i} {
+    set nm [xschem getprop instance $i name]
+    set ty [xschem getprop instance $i cell::type]
+    if {$which eq {desc} && $ty ne {subcircuit}} { continue }
+    if {$which eq {desc}} {
+      lappend out $nm [::op_annot::_descendable $i $idx]
+    } else {
+      lappend out $nm [::op_annot::_netlisted $i $idx]
+    }
+  }
+  return $out
+}
