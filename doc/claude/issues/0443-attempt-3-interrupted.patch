+## Force the "the oracle wrote no deck" path (row T16) by pointing the oracle's
+## own directory at a path that cannot be a directory — `pdev.sym` is a regular
+## file, so `<pdev.sym>/nope` can neither be created nor written.
+proc opa_t_dirshim_on {} {
+  set ::opa_t_dirshim_had [expr {[info commands ::op_annot::_oracle_dir] ne {}}]
+  if {$::opa_t_dirshim_had} {
+    catch {rename ::op_annot::_oracle_dir ::op_annot::_oracle_dir_real}
+  }
+  proc ::op_annot::_oracle_dir {} { return [file join $::lib pdev.sym nope] }
+}
+proc opa_t_dirshim_off {} {
+  catch {rename ::op_annot::_oracle_dir {}}
+  if {$::opa_t_dirshim_had} {
+    catch {rename ::op_annot::_oracle_dir_real ::op_annot::_oracle_dir}
+  }
+}
