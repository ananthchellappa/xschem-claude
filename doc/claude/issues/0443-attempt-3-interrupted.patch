+## Record the sch_path of every level the walk enters (row T8). The descend gate
+## is the ONE decision whose failure can be invisible in the card list: a walk
+## that enters an ignored subtree and finds nothing to save there emits exactly
+## the same block.
+set ::opa_t_visits {}
+## ⚠ EVERY SHIM HERE REMEMBERS WHETHER IT HAD ANYTHING TO REPLACE. Renaming an
+## ABSENT proc fails, the shim is defined anyway, and the `off` half then leaves
+## it standing — which would silently poison every row after it while the suite
+## still ran. `_had` is what makes the removal exact.
+proc opa_t_walkshim_on {} {
+  set ::opa_t_visits {}
+  set ::opa_t_walkshim_had [expr {[info commands ::op_annot::_walk] ne {}}]
+  if {$::opa_t_walkshim_had} { catch {rename ::op_annot::_walk ::op_annot::_walk_realv} }
+  proc ::op_annot::_walk {args} {
+    lappend ::opa_t_visits [xschem get sch_path]
+    return [uplevel 1 [linsert $args 0 ::op_annot::_walk_realv]]
+  }
+}
+proc opa_t_walkshim_off {} {
+  catch {rename ::op_annot::_walk {}}
+  if {$::opa_t_walkshim_had} { catch {rename ::op_annot::_walk_realv ::op_annot::_walk} }
+}
