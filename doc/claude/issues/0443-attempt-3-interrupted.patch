+# ===========================================================================
+# S2 — THE GOLDEN CARD LIST
+# ===========================================================================
+catch {op_annot::register nmos $S3_DESC}
+opa_s3_load s3top.sch
+check {S2 GOLDEN 13-line block, depth-first, cards BEFORE descending} \
+  [rcall {opa_s3_lines [op_annot::save_cards]}] [list 0 $S3_GOLD]
+
+set s3_block {}
+catch {set s3_block [op_annot::save_cards]}
+set s3_lines [opa_s3_lines $s3_block]
+
+# ===========================================================================
+# S2b — ⚠ NEW IN S3c. THE VECTOR INSTANCE IS THE ORACLE'S FIRST TRAP, AND IT
+#       IS INVISIBLE TO EVERY OTHER ROW IN THIS SECTION.
+# ===========================================================================
+# MEASURED on this tree, this fixture, this binary: the deck's s3mid block is
+#
+#     .subckt s3mid A
+#     x2[1] ...
+#     x2[0] ...
+#     XM5   ...
+#
+# i.e. the netlister writes ONE ELEMENT LINE PER MEMBER, while the instance's
+# own name — and therefore `xschem translate x2[1:0] {@spiceprefix@name}` — is
+# the BRACKETED RANGE `x2[1:0]`, which appears in the deck NOWHERE. A membership
+# test that compares the bare translated name against the block answers 0 for
+# every vector instance, and the oracle then refuses to descend into it: six of
