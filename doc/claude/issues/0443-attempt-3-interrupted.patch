 }
 
+# =============================================================================
+# SECTION S — S3 of doc/claude/specs/op_annotation.md: THE HIERARCHY WALK,
+#             THE SAVE-CARD BLOCK, AND THE .save FILE WRITER
+# =============================================================================
+# S1 built the name builder; S2 filled the descriptor store. S3 adds the two
+# consumers that turn a descriptor into a deck:
+#
+#   op_annot::save_cards {}       -> the `.save` block as TEXT, {} when empty
+#   op_annot::last_warnings {}    -> the warning LIST from the most recent walk
+#   op_annot::write_save_file {}  -> $netlist_dir/<cell>.save, returns the path
+#
+# and the hierarchy walk underneath them, ported from sg13g2_sch_expand /
+# sg13g2_hier_sch_expand (sg13g2_procs.tcl:345-421) and de-PDK'd.
+#
+# ============================================================================
+# ⚠ THE CARD IS BARE. NEVER op_annot::vector.  (spec §3 R4, src/op_annot.tcl:43)
+# ============================================================================
+# Re-measured for this section on BOTH ngspice binaries now on this box
+# (/usr/bin/ngspice = 42, /usr/local/bin/ngspice = 46+ and FIRST on PATH):
+#
+#     .save @m.xm1.m1[id]     -> raw contains  i(@m.xm1.m1[id])
+#     .save i(@m.xm1.m1[id])  -> raw contains  NOTHING. no vector, no message.
+#
+# The emitter writes `[op_annot::devpath $inst][param]`. Row S3 is the guardian.
+#
+# ============================================================================
+# ⚠ I2's SPELLING IS `.save all`, NOT the bare `save all` the step brief says
+# ============================================================================
+# MEASURED on ngspice-42 AND 46+: a bare deck-level `save all` line is
+# `Error on line N … Unable to find definition of model` — ngspice parses it as
+# an `s`-prefixed switch instance — and NO RAW FILE IS WRITTEN AT ALL. The
+# dot-card `.save all` works on both (raw = node voltages plus the bare device
+# vectors). Emitting the bare form is strictly WORSE than omitting it: it
+# removes the whole raw rather than only the node voltages. Rows S4 and S5.
+#
+# ============================================================================
+# ⚠ I6 IS THE WHOLE RISK OF THIS STEP, AND IT IS FOUR THINGS, NOT THREE
+# ============================================================================
+# The walk sets no_draw 1, no_undo 1, keep_symbols 1 and DESCENDS THE REAL
+# DESIGN. Every exit path — including the forced mid-walk raise — must restore
+# all of them AND the entry hierarchy level. Reproduced before-state, on this
+# tree: `sky130_save_fet_params` on sky130_tests/test_generators raises
+# `Symbol not found` and returns with no_draw=1 keep_symbols=1 still set
+# (issue 0431). Rows S8/S10/S11/S12.
+#
+# ⚠ `xschem get no_undo` DOES NOT EXIST (setter only, scheduler.c:11958). It
+# returns {} both before and after `xschem set no_undo 1` — measured. So the
+# step's stated "assert no_undo is back to its entry value" is UNWRITABLE as a
+# flag read: as `== 0` it fails, as `equals the entry value` it passes
+# vacuously against {}. Row S9 probes the FLAG'S EFFECT instead — push_undo /
+# delete / undo round-trips the instance count — with a PAIRED CONTROL under an
+# explicit `no_undo 1` proving the probe discriminates. Issue 0432.
+#
+# ⚠ EVERY FORCED-FAILURE ROW ALSO ASSERTS THE SHIM FIRED. Without that, an
+# ABSENT op_annot::save_cards raises `invalid command name` before touching
+# anything, "the state is unchanged" is trivially true, and S11/S12 would pass
+# green against a feature that does not exist. `$::opa_s3_shim_hits > 0` is
+# what makes the restore a claim. Same reason the happy-path rows carry the
+# `rcall` rc in their golden.
+#
+# ============================================================================
+# ⚠ THE GOLDEN IS S3's OWN — NEVER A BYTE-DIFF AGAINST THE PDK PROTOTYPE
+# ============================================================================
+# Measured on this fixture the generic walk and sky130_save_fet_params disagree
+# BY DESIGN: the prototype reads `getprop instance <n> spiceprefix` (empty when
+# spiceprefix lives in the symbol template) and answers `@m.x1.x2[1].m1.…`
+# without the `x` (issue 0430), and it never saves `id` (issue 0427). Section P
+# keeps the prototype diff where it belongs — at name level, on cells that
+# spell `spiceprefix=` on the instance line.
+#
+# ============================================================================
+# ⚠ FIXTURE TRAP, MEASURED AND EXPENSIVE: THE `~.sch` BACKUP
+# ============================================================================
+# A row that leaves the buffer modified (row S9's undo probe does) makes the
+# NEXT `xschem load` write `s3top~.sch`, and `go_back` prefers that backup over
+# the on-disk cell (actions.c load_backup_as). Measured consequence: a later
+# descend/go_back round trip came back with ONE instance instead of two and
+# every subsequent descend answered `not-descendable:nmos`. `xschem set
+# modified 0` does NOT clear the flag (measured: rc 0, flag still 1). So every
+# fixture load in this section goes through opa_s3_load, which deletes the
+# backups on BOTH sides of the load.
+#
+# ⚠ `xschem select instance <i>` TOGGLES. After a go_back the instance you came
+# from is left selected, so a bare re-select DESELECTS it and the next descend
+# fails `no-selection`. Every re-descend here is `unselect_all` first.
+#
+# True headless is the default invocation; rows S16 and S19 need more:
+#   ./src/xschem --nogui --pipe -q --nolog --script tests/headless/test_op_annot.tcl
+#   GUI_GATE=0 xvfb-run -a ./src/xschem --pipe -q --logdir $(mktemp -d) \
+#     --script tests/headless/test_op_annot.tcl
+
+## A row that cannot run in THIS invocation. Neither counter moves: a skip that
+## incremented $npass would be a hollow pass, and one that incremented $fail
+## would red the default headless run for the absence of an X server.
+proc skiprow {name why} { puts "skip: $name  ($why)" ; flush stdout }
+
+## ⚠ AN X-ONLY HANG, MEASURED, AND IT IS THE TREE'S AND NOT THIS STEP'S. A
+## schematic that cannot be opened makes the C pop a MODAL dialog
+## (save.c:4416 -> `alert_`, src/xschem.tcl:11907, a `toplevel` with a tkwait),
+## so an unattended run under a display BLOCKS FOREVER instead of failing. The
+## S3 fixture has such a cell on purpose: s3bad.sym has no `.sch`. BOTH doors
+## reach it — the oracle's `xschem netlist`, which walks the symbol to emit its
+## `.subckt`, and (before the oracle existed) the walk's own `xschem descend` —
+## so silencing it is a HARNESS concern, not a feature change: with a human at
+## the desk the dialog is the right behaviour for a menu item they clicked.
+## Measured: `--nogui` prints the same diagnostic to stderr and never blocks,
+## which is why this hazard is invisible to the default invocation.
+## MEASURED, both doors, and only ONE of them has a switch:
+##   * load_schematic() (save.c:4416) takes the netlister's own `alert` flag all
+##     the way down (spice_netlist.c:695), so `xschem netlist -noalert` silences
+##     it — which is what op_annot::_oracle_deck now passes;
+##   * has_included_subcircuit (src/xschem.tcl:2239, reached from token.c:1977)
+##     pops an `alert_` that NO flag reaches, on any `spice_sym_def` whose text
+##     carries no matching `.subckt` — and section T's fixture has exactly one,
+##     on purpose, because that is drop class 3. Issue 0446.
+## So the harness silences the dialog for the rows that walk those fixtures.
+## ⚠ IDEMPOTENT ON BOTH SIDES: an `off` with nothing installed would `rename`
+## the REAL alert_ away and every later row would run without it.
+## ⚠ AND THE SECOND MODAL, WHICH IS THE ONE THAT LEAVES THE X LEG DARK.
+## `alert_` is not the only blocking dialog on this path. `xschem netlist
+## <path-with-a-slash>` reaches set_netlist_dir(1,<dirname>) (src/xschem.tcl:9037,
+## and :8998 for the what==0 arm), and a failing `file mkdir` there pops a RAW
+## `tk_messageBox` that no `-noalert` reaches and that this shim pair did not
+## cover. MEASURED, and it is why rows S19/T28/T29 have never been observed to
+## pass: `GUI_GATE=0 xvfb-run -a ./src/xschem --pipe -q --logdir <t> --script
+## <this file>` runs to rc=124 at 240 s with 113 `ok:` lines and NO RESULT line,
+## blocked on a mapped 366x162 `__tk__messagebox` reading
+## `can't create directory "...": file already exists` — T16's deliberately
+## unwritable oracle dir.
+##
+## ⚠ IT COUNTS, IT DOES NOT SWALLOW. A shim that returned quietly would let
+## T16/T33 assert "no dialog" against a dialog that fired; `::opa_mb_hits` is
+## what makes the zero an assertion instead of an assumption.
+##
+## ⚠ VACUOUS UNDER --nogui, AND THAT IS RECORDED RATHER THAN HIDDEN.
+## src/xschem.tcl:8998/:9037 guard the call with `[info exists has_x]`, and
+## measured on this tree `has_x` does not exist under --nogui/--pipe, so the
+## hit count is 0 headless whether or not the production pre-check exists. The
+## `tk_messageBox` legs below therefore mean something ONLY on the X leg; the
+## SEAM-EXISTS legs beside them are what make those rows red headless.
+set ::opa_alert_hits 0
+set ::opa_alert_had 0
+set ::opa_alert_on 0
+set ::opa_mb_hits 0
+set ::opa_mb_had 0
+proc opa_alert_shim_on {} {
+  if {$::opa_alert_on} { return }
+  set ::opa_alert_hits 0
+  set ::opa_alert_had [expr {[info commands ::alert_] ne {}}]
+  if {$::opa_alert_had} { catch {rename ::alert_ ::opa_alert_real} }
+  proc ::alert_ {args} {
+    incr ::opa_alert_hits
+    catch {set tctx::rcode 1}
+    return {}
+  }
+  ## The tk_messageBox half, idempotent in exactly the same way and for exactly
+  ## the same reason: an `off` with nothing installed would rename the REAL
+  ## tk_messageBox away and every later dialog in the session would vanish.
+  set ::opa_mb_hits 0
+  set ::opa_mb_had [expr {[info commands ::tk_messageBox] ne {}}]
+  if {$::opa_mb_had} { catch {rename ::tk_messageBox ::opa_mb_real} }
+  proc ::tk_messageBox {args} {
+    incr ::opa_mb_hits
+    return ok
+  }
+  set ::opa_alert_on 1
+}
+proc opa_alert_shim_off {} {
+  if {!$::opa_alert_on} { return }
+  catch {rename ::alert_ {}}
+  if {$::opa_alert_had} { catch {rename ::opa_alert_real ::alert_} }
+  catch {rename ::tk_messageBox {}}
+  if {$::opa_mb_had} { catch {rename ::opa_mb_real ::tk_messageBox} }
+  set ::opa_alert_on 0
+}
