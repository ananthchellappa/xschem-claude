+set S3_FILTGOLD_LVS [list \
+  {.save all} \
+  {.save @m.xmok[id]} {.save @m.xmok[gm]} \
+  {.save @m.xmtmpl[id]} {.save @m.xmtmpl[gm]}]
+# The device paths, as a sorted set, for the netlist cross-check (row S31).
+set S3_FILTDEVS {@m.xmlvs @m.xmok @m.xmtmpl}
