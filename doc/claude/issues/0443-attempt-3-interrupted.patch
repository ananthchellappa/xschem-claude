+  proc ::op_annot::_walk {args} {
+    if {$::opa_t_re_hits == 0} {
+      incr ::opa_t_re_hits
+      ::op_annot::save_cards
+    }
+    return [uplevel 1 [linsert $args 0 ::op_annot::_walk_realr]]
+  }
+}
+proc opa_t_reshim_off {} {
+  catch {rename ::op_annot::_walk {}}
+  if {$::opa_t_reshim_had} { catch {rename ::op_annot::_walk_realr ::op_annot::_walk} }
+}
