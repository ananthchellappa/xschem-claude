+# s3igntop: x1 carries spice_ignore=true, so NOTHING below it is in the deck.
+# Not "x1 gets no card of its own" (it never had one — it is a subcircuit) but
+# "the walk does not DESCEND", which is a different edit in a different place.
+set S3_IGNGOLD [list \
+  {.save all} \
+  {.save @m.xm9.msky130_fd_pr__nfet_01v8[id]} \
+  {.save @m.xm9.msky130_fd_pr__nfet_01v8[gm]} \
+  {.save @m.xm9.msky130_fd_pr__nfet_01v8[vth]}]
