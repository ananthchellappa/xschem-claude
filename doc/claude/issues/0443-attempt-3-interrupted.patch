+## Backup-safe fixture load. See the `~.sch` trap above.
+proc opa_s3_load {name} {
+  global lib
+  foreach f [glob -nocomplain [file join $lib *~.sch]] { catch {file delete -force $f} }
+  catch {xschem load [file join $lib $name]}
+  foreach f [glob -nocomplain [file join $lib *~.sch]] { catch {file delete -force $f} }
+  return [list [xschem get instances] [xschem get currsch] [xschem get sch_path] \
+               [xschem get modified]]
+}
+
+## THE I6 4-TUPLE. no_draw and currsch/sch_path are real getters; keep_symbols
+## is the Tcl global the walk overwrites. no_undo is absent by construction —
+## see the header, and row S9.
+proc opa_s3_state {} {
+  set kd 0
+  if {[info exists ::keep_symbols]} { set kd $::keep_symbols }
+  return [list [xschem get no_draw] $kd [xschem get currsch] [xschem get sch_path]]
+}
+
+## Does undo actually work right now? -> {before after-delete after-undo}.
+## Measured: {2 1 2} with undo live, {2 1 1} under `xschem set no_undo 1`.
+proc opa_s3_undo_probe {} {
+  set n0 [xschem get instances]
+  catch {xschem push_undo}
+  catch {xschem unselect_all}
+  catch {xschem select instance 0 fast nodraw}
+  catch {xschem delete}
+  set n1 [xschem get instances]
+  catch {xschem undo}
+  return [list $n0 $n1 [xschem get instances]]
+}
+
+proc opa_s3_lines {block} { return [split [string trimright $block "\n"] "\n"] }
+
+## The forced mid-walk failure. devpath is the ONE call every emitted card goes
+## through, so raising inside it whenever the walk has descended reproduces the
+## "a devproc / translate / expandlabel blew up three levels down" case without
+## needing a broken PDK. The hit counter is what stops the rows it feeds from
+## passing vacuously against an absent save_cards.
+set ::opa_s3_shim_hits 0
+proc opa_s3_shim_on {} {
+  set ::opa_s3_shim_hits 0
+  if {[info commands ::op_annot::devpath_real] eq {}} {
+    catch {rename ::op_annot::devpath ::op_annot::devpath_real}
+  }
+  ## ⚠ THE SHIM'S SIGNATURE IS PART OF THE CONTRACT. devpath grew a `basis` and
+  ## a `root` argument (issue 0436 / decision D1); a one-argument shim makes the
+  ## walk die on `wrong # args` INSTEAD of on the forced failure, so S10/S11/S12
+  ## would go red for a harness bug wearing the right colour. All three are
+  ## forwarded verbatim.
+  proc ::op_annot::devpath {instname {basis read} {root {}}} {
+    if {[xschem get currsch] > 0} {
+      incr ::opa_s3_shim_hits
+      return -code error "opa forced mid-walk failure"
+    }
+    return [::op_annot::devpath_real $instname $basis $root]
+  }
+}
+proc opa_s3_shim_off {} {
+  if {[info commands ::op_annot::devpath_real] ne {}} {
+    catch {rename ::op_annot::devpath {}}
+    catch {rename ::op_annot::devpath_real ::op_annot::devpath}
+  }
+}
