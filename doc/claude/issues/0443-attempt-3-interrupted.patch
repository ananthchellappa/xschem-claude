+set T_GOLD [list \
+  {.save all} \
+  {.save @m.xmtop[id]} {.save @m.xmtop[gm]} \
+  {.save @m.xmlvs[id]} {.save @m.xmlvs[gm]} \
+  {.save @m.xmotl[id]} {.save @m.xmotl[gm]} \
+  {.save @m.xplain.xma[id]} {.save @m.xplain.xma[gm]} \
+  {.save @m.xplain.xleaf.xmb[id]} {.save @m.xplain.xleaf.xmb[gm]}]
