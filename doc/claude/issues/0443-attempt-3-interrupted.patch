+## Action-log line counter (row S16 only). The log is line-buffered
+## (util.c:405), so a mid-run read sees every line already written.
+proc opa_s3_logcount {pat} {
+  if {[catch {open [xschem get actionlog_filename] r} fd]} { return -1 }
+  set b [read $fd] ; close $fd
+  set n 0
+  foreach line [split $b \n] { if {[string match $pat $line]} { incr n } }
+  return $n
+}
