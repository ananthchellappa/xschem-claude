+  [list $t13 $t13_leak $t13_flag $t13_ctl] \
+  [list [list 0 $T_GOLD] {} 1 {lnd.spice}]
+
+# ===========================================================================
+# T14 — flat_netlist: THE BLOCK STRUCTURE THE ORACLE READS MUST EXIST
+# ===========================================================================
+# MEASURED: flatten.awk (src/xschem.tcl:2274) rewrites the deck as `** PTOP flat
+# netlist` with no `.subckt` at all and every device renamed and UPPERCASED, so
+# a block index of it is meaningless. The oracle forces the setting to 0 and
+# gives it back. (op_annot's CARDS are also wrong under this setting — that is a
+# pre-existing defect of its own, filed rather than silently patched here.)
+opa_s3_load ptop.sch
+set t14_saved 0
+if {[info exists ::flat_netlist]} { set t14_saved $::flat_netlist }
+set ::flat_netlist 1
+set t14 [rcall {opa_s3_lines [op_annot::save_cards]}]
+set t14_flag $::flat_netlist
+set ::flat_netlist $t14_saved
+check {T14 with flat_netlist 1 the block is unchanged and the flag survives} \
+  [list $t14 $t14_flag] [list [list 0 $T_GOLD] 1]
+
+# ===========================================================================
+# T15 — NO TEMP DECK SURVIVES, ON EITHER PATH
+# ===========================================================================
+# The oracle writes a throwaway deck and must remove it — including when the
+# walk raises three levels down. `_oracle_dir` is asserted to be a real
+# directory so the row cannot pass vacuously against a proc that answers {}.
+## ⚠ HARDENED FROM AN EMPTINESS TEST TO A DOTFILE-AWARE DELTA (decision D15),
+## AND THIS ROW WAS ALREADY GREEN — it is a robustness change, not a fix, and it
+## is recorded as such so nobody reads it as evidence for anything. The old
+## `glob -nocomplain -tails -directory $dir *` is blind to the C netlister's own
+## temp `<netlist_dir>/.<cell>_<pid>` (spice_netlist.c:304) — the single most
+## likely thing to leak here — and three such dotfiles are sitting in
+## `~/.xschem/op_annot` right now from an interrupted session while the row
+## passes. A DELTA rather than an emptiness assertion is the right shape because
+## the oracle dir is a real user directory that may hold litter this suite did
+## not create.
+opa_s3_load ptop.sch
+set t15_dir [lindex [rcall {::op_annot::_oracle_dir}] 1]
+set t15_census0 [opa_t_dircensus $t15_dir]
+set t15_rc1 [lindex [rcall {op_annot::save_cards}] 0]
+set t15_isdir 0
+if {$t15_dir ne {}} { set t15_isdir [file isdirectory $t15_dir] }
+set t15_left1 [opa_t_delta $t15_census0 [opa_t_dircensus $t15_dir]]
+opa_s3_shim_on
+set t15_rc2 [lindex [rcall {op_annot::save_cards}] 0]
+set t15_hits $::opa_s3_shim_hits
+opa_s3_shim_off
+set t15_left2 [opa_t_delta $t15_census0 [opa_t_dircensus $t15_dir]]
+check {T15 the oracle dir is real and gains no file after a walk NOR after a raise} \
+  [list $t15_rc1 $t15_isdir $t15_left1 $t15_rc2 [expr {$t15_hits > 0}] $t15_left2] \
+  {0 1 {} 1 1 {}}
+
+# ===========================================================================
+# T16 — A MISSING DECK RAISES. IT NEVER DEGRADES TO AN EMPTY INDEX.
+# ===========================================================================
+# ⚠ THE FAILURE MODE THIS FORBIDS IS THE ONE THAT LOOKS LIKE SUCCESS. An oracle
+# that answered {} when the netlist could not be written would build an empty
+# index, find no instance in it, emit zero cards, and hand the user a feature
+# that silently reports "nothing to save" — indistinguishable from "this PDK is
+# not supported" (spec §4.2's error discipline, landmine 9's shape). So: raise,
+# with a message that names the oracle, and restore the entry state on the way
+# out.
+## ⚠ AND THE RAISE MUST COME FROM op_annot, BEFORE THE NETLIST IS ISSUED
+## (decision D11/D12). `xschem netlist <path-with-a-slash>` reaches
+## set_netlist_dir(1,<dirname>) whose failing `file mkdir` pops a RAW MODAL
+## `tk_messageBox` (src/xschem.tcl:9037, and :8998) that no `-noalert` reaches
+## and that names a directory the user never chose. A user with a read-only HOME
+## gets that dialog INSTEAD of `_oracle_deck`'s careful named diagnostic, and
+## this suite's X leg gets a 240-second hang instead of a result. So the row now
+## also demands the two named seams and demands that the netlist was never
+## issued at all.
+##
+## ⚠ THE `_oracle_run was issued 0 times` LEG IS MEANINGLESS ON ITS OWN — with
+## the seam absent the shim counts a proc nobody calls and answers 0, which is
+## the expected value. `$t16_seams` is captured BEFORE the shim is armed and is
+## what makes this row red for the absence rather than green for it.
+opa_s3_load ptop.sch
+set t16_before [opa_s3_state]
+set t16_seams [list [expr {[info commands ::op_annot::_oracle_dir_ready] ne {}}] \
+                    [expr {[info commands ::op_annot::_oracle_run] ne {}}]]
+set t16_mb0 $::opa_mb_hits
+opa_t_dirshim_on
+opa_t_runshim_on pass
+set t16 [rcall {op_annot::save_cards}]
+set t16_runhits $::opa_t_run_hits
+opa_t_runshim_off
+set t16_after [opa_s3_state]
+opa_t_dirshim_off
+set t16_mb [expr {$::opa_mb_hits - $t16_mb0}]
+check {T16 N6 an unwritable oracle dir RAISES naming the oracle, and restores} \
+  [list [lindex $t16 0] \
+        [regexp -nocase {oracle|netlist} [lindex $t16 1]] \
+        $t16_before [expr {$t16_after eq $t16_before}] \
+        $t16_seams $t16_runhits $t16_mb] \
+  [list 1 1 $T_ENTRY 1 {1 1} 0 0]
+
+# ===========================================================================
+# T17 — A POLYMORPHIC `schematic=` INSTANCE IS DESCENDED INTO ITS OVERRIDE
+# ===========================================================================
+# MEASURED, and the reason the index is keyed on `** sch_path:`:
+# get_additional_symbols (actions.c:3356) synthesizes a symbol for xp2, and the
+# deck's block for it carries `** sym_path: …/psub.sym` with
+# `** sch_path: …/pleaf.sch`. A sym_path-keyed index sends xp2 to psub's block
+# and emits `xp2.xma`, a device the deck does not contain.
+check {T17 the `schematic=` override decides the block: xp2 -> pleaf, not psub} \
+  [list [opa_s3_load ppoly.sch] [rcall {opa_s3_lines [op_annot::save_cards]}]] \
+  [list {2 0 . 0} [list 0 $T_POLYGOLD]]
+
+# ===========================================================================
+# T18 — SAME BASENAME, DIFFERENT LIBRARY: UNDER-EMIT, NEVER MIS-EMIT
+# ===========================================================================
+# MEASURED: the netlister hashes subckt blocks by get_cell(sym->name)
+# (spice_netlist.c:487), so lib/psub and lib2/psub collapse to ONE `.subckt psub`
+# and lib2's MDUP is nowhere in the deck. The block key for xb's own schematic is
+# therefore absent, the walk does not enter it, and the aggregate no-expansion
+# count rises by one. That is the I3-safe direction — a device the user cannot
+# see beats a card that kills their raw.
+#
+# ⚠ TWO warning lines here, not one — corrected by measurement, same slip as
+# T22's. The walk DOES enter xa, and psub holds MOTL2, whose `only_toplevel`
+# takes it out of the deck one level down: that is a claimed device with no
+# card, so the DEVICE aggregate fires too. The count this row is actually about
+# is the FIRST WORD of the first line (1, the one collision), and it is
+# unchanged.
+check {T18 0445 a same-basename collision is skipped and COUNTED, not guessed} \
+  [list [opa_s3_load pcoll.sch] [rcall {opa_s3_lines [op_annot::save_cards]}] \
+        [llength [lindex [rcall {op_annot::last_warnings}] 1]] \
+        [lindex [lindex [lindex [rcall {op_annot::last_warnings}] 1] 0] 0]] \
+  [list {2 0 . 0} [list 0 $T_COLLGOLD] 2 1]
+
+# ===========================================================================
+# T19 — THE GUARDIAN OF `_normkey`. ONE CELL, TWO SPELLINGS, ONE KEY.
+# ===========================================================================
+# MEASURED on this fixture: `xschem get_sch_from_sym xb` answers
+# `…/lib/../lib/psub.sch` while the deck's `** sch_path:` says `…/lib/psub.sch`,
+# and the deck contains ONE psub block that both xa and xb call. Without a
+# `file normalize` on BOTH sides the two strings differ, xb's whole subtree is
+# silently dropped, and the block shortens from nine lines to five with nothing
+# to say so. abs_sym_path alone does NOT collapse `..` — measured.
+check {T19 `../lib/psub.sym` and `psub.sym` normalize to ONE block key} \
+  [list [opa_s3_load pdot2.sch] [rcall {opa_s3_lines [op_annot::save_cards]}]] \
+  [list {2 0 . 0} [list 0 $T_DOTGOLD]]
+
+# ===========================================================================
+# T20 — `_element` AGREES WITH THE DECK IN BOTH DIRECTIONS
+# ===========================================================================
+# Forward: every element name in the top block is some instance's `_element`.
+# Backward: every instance the walk calls netlisted has its `_element` in that
+# block. Both, because a key that is systematically wrong (a dropped `x`, a
+# missing `@spiceprefix`) fails only one of them.
+opa_s3_load ptop.sch
+set t20 [rcall {
+  set idx [::op_annot::_deck_index [::op_annot::_oracle_deck]]
+  set blk [dict get $idx [::op_annot::_normkey [xschem get schname]]]
+  set elems {} ; set claimed {}
+  for {set i 0} {$i < [xschem get instances]} {incr i} {
+    set e [::op_annot::_element [xschem getprop instance $i name]]
+    lappend elems $e
+    if {[::op_annot::_netlisted $i $idx]} { lappend claimed $e }
+  }
+  set orphan {} ; set unclaimed {}
+  foreach b $blk { if {[lsearch -exact $elems $b] < 0} { lappend orphan $b } }
+  foreach c $claimed { if {[lsearch -exact $blk $c] < 0} { lappend unclaimed $c } }
+  list [llength $blk] [llength $elems] [lsort $orphan] [lsort $unclaimed]
+}]
+check {T20 element <-> deck, both directions, no orphan and no unclaimed} \
+  $t20 {0 {8 11 {} {}}}
+
+# ===========================================================================
+# T21 — `_element` WHEN spiceprefix LIVES ONLY IN THE SYMBOL TEMPLATE (0430)
+# ===========================================================================
+# ⚠ CONTROL PLUS CLAIM. The control half is the prototypes' bug reproduced:
+# `getprop instance MTOP spiceprefix` is EMPTY here because the token lives in
+# the symbol `template=`, which is why sg13g2_procs/sky130_procs lose the `x` on
+# 3 of 45 shipped sky130 cells. The claim is that `_element` does not: the deck
+# says `XMTOP`, so the key must be `xmtop`.
+opa_s3_load ptop.sch
+check {T21 0430 _element is xmtop although the instance line has no spiceprefix} \
+  [list [xschem getprop instance MTOP spiceprefix] \
+        [rcall {::op_annot::_element MTOP}] \
+        [rcall {::op_annot::_element xplain}]] \
+  [list {} {0 xmtop} {0 xplain}]
+
+# ===========================================================================
+# T22 — THE WARNING CHANNEL: TWO AGGREGATES, NEVER A PER-DEVICE FLOOD
+# ===========================================================================
+# Decision D7 (attempt 2) kept this channel narrow because a real PDK design is
+# full of documentation-only spice_ignore devices and one line each would bury
+# the one warning that matters. Decision N8 keeps that and adds what BOTH prior
+# attempts lacked: UNDER-emission has to be visible, because that is the failure
+# that survived 85 and then 96 green checks.
+#
+# The contract, and it is what this row asserts. The two phrases are decision
+# N8's own wording and ARE matched, because a glob loose enough to accept either
+# line would let the two swap places and still pass:
+#   * exactly two lines here, DEVICES first then SUBCIRCUITS
+#   * each line's FIRST WORD is its count
+#   * a line is emitted only when its count is > 0 (T18/S14 see one line, not
+#     two, and a clean walk sees none — the S14 `s14_clean` half)
+#   * devices    = instances a descriptor CLAIMS (non-blank devpath) that are
+#                  not in the deck -> MIGN **and MOTL2**, so 2
+#   * subcircuits= subcircuit instances the walk did not enter -> xsigign,
+#                  xstop, xsymdef, xign, xnofmt, xprim, so 6
+#
+# ⚠ THE DEVICE COUNT WAS 1 IN THIS ROW AS FIRST WRITTEN, AND THAT WAS AN
+# ENUMERATION SLIP, CORRECTED BY MEASUREMENT — not the implementation bending to
+# fit. The rule stated one line above is "claimed by a descriptor and not in the
+# deck", and psub's MOTL2 is exactly that: `only_toplevel` drops it one level
+# down (it is absent from the `.subckt psub` block, which is why T_GOLD carries
+# no `xplain.xmotl2` card), and the walk enters psub through xplain. So the
+# honest count is 2. Making it 1 would mean the walk knowing WHY a device is
+# absent — i.e. reading `only_toplevel` — which is the hand-maintained mirror
+# this whole step exists to delete. Under-reporting here is the same silence
+# that let 85 and then 96 green checks certify a broken filter.
+opa_s3_load ptop.sch
+set t22 [rcall {op_annot::save_cards ; op_annot::last_warnings}]
+set t22_w [lindex $t22 1]
+check {T22 N8 two aggregate warnings, counts 2 and 6, zero per-device lines} \
+  [list [lindex $t22 0] [llength $t22_w] \
+        [lindex [lindex $t22_w 0] 0] \
+        [string match {*not in the netlist*} [lindex $t22_w 0]] \
+        [lindex [lindex $t22_w 1] 0] \
+        [string match {*expand*} [lindex $t22_w 1]]] \
+  {0 2 2 1 6 1}
+
+# ===========================================================================
+# T23 — THE USER-ARCHITECTURE REGION, AND A MEASURED FATAL FALSE POSITIVE
+# ===========================================================================
+# ⚠ THIS IS THE ONE PLACE THE ORACLE HAS A HAND-WRITTEN RULE, AND ITS
+# FALSE-POSITIVE DIRECTION IS THE DANGEROUS ONE. Measured on this tree: a
+# `code_shown` symbol whose value is the literal line `xghost net1 pmodel` puts
+# that line INSIDE the top block, between `**** begin user architecture code`
+# and `**** end user architecture code`. The instance GHOST carries
+# `spice_ignore=true` and is nowhere in the deck — but its element name is
+# `xghost`. A parser that does not skip the region reads the user's own text as
+# proof that a dropped device is present, and emits cards for it: the exact
+# 0442 defect, arriving from the parser instead of from a mirror.
+# The control half asserts the fabricated line really is in the deck, so the row
+# cannot pass because the trap failed to arm.
+opa_s3_load puser.sch
+set t23_deck [opa_t_netlist_text]
+set t23_ghostline 0
+foreach l [split $t23_deck \n] {
+  if {[string match {xghost *} [string trim $l]]} { set t23_ghostline 1 }
+}
+set t23 [rcall {opa_s3_lines [op_annot::save_cards]}]
+check {T23 a fabricated element line in the user-architecture region adds no card} \
+  [list $t23_ghostline $t23 [lindex [rcall {::op_annot::_element GHOST}] 1]] \
+  [list 1 [list 0 $T_USERGOLD] xghost]
+
+# ===========================================================================
+# T24 — THE PARSER'S OTHER FOUR LINE CLASSES, ON SYNTHETIC TEXT
+# ===========================================================================
+# Synthetic rather than netlisted, so the row states the rule instead of
+# depending on a deck that happens to contain one: a `+` continuation
+# (break.awk splits element lines over 130 chars — measured on
+# sky130_tests/test_nmos: `XM1 … sd=0` / `+ mult=1`), a `*` comment and a `.`
+# dot-card are NOT elements.
+#
+# ⚠ AND THE MARKER-ANCHORING TRAP, WHICH BIT THIS FILE'S OWN FIRST DRAFT.
+# `string match {****begin*}` treats every `*` as a WILDCARD, so it matches any
+# line containing "begin" — and the `end` twin then swallows `.ends`, leaving
+# the block open. XBEGIN1 and XEND2 below are ordinary devices with unlucky
+# names; both must be counted, and XAFTER must land in the block that `.ends`
+# would have closed if the naive pattern had eaten it.
+set T_SYNTH "** sch_path: [file join $lib ptop.sch]
+**.subckt ptop
+XREAL net1 pmodel
++ mult=1
+* a comment that is not an element
+.param zz=1
+XBEGIN1 net2 pmodel
+XEND2 net3 pmodel
+**** begin user architecture code
+xfabricated net9 pmodel
+**** end user architecture code
+XAFTER net4 pmodel
+**.ends
+.end
+"
+check {T24 continuations, comments, dot-cards and unlucky names are all handled} \
+  [rcall {dict get [::op_annot::_deck_index $::T_SYNTH] \
+                   [::op_annot::_normkey [file join $::lib ptop.sch]]}] \
+  {0 {xreal xbegin1 xend2 xafter}}
+
+# ===========================================================================
+# T28 — THE PLACEMENT GATE (I4). THE SHARPEST SEAM OF THE WHOLE INVERSION.
+# ===========================================================================
+# ⚠ MEASURED ON THIS TREE, AND IT IS WHY THIS GATE EXISTS: with a wire-label
+# placement preview live (ui_state 16424, sympin_preview 1, 12 instances),
+# `xschem netlist` calls leave_placement_for("Netlist") (scheduler.c:8823) whose
+# teardown is a delete() (issue 0263) — after it, ui_state 0, sympin_preview 0,
+# 11 instances. The user's in-flight object is GONE, for a menu item they used
+# to read a schematic. Neither call is suppressible from Tcl.
+#
+# So save_cards REFUSES while a gesture is pending, rather than absorbing the
+# damage: raise, name the gesture, and leave the preview exactly where it was.
+opa_s3_load ptop.sch
+set ::label_new_name FOO
+catch {xschem add_wire_label -place}
+set t28_armed [list [expr {([xschem get ui_state] & 16384) ? 1 : 0}] \
+                    [xschem get instances] [xschem get sympin_preview]]
+set t28 [rcall {op_annot::save_cards}]
+set t28_after [list [expr {([xschem get ui_state] & 16384) ? 1 : 0}] \
+                    [xschem get instances] [xschem get sympin_preview]]
+xschem abort_operation ; xschem abort_operation ; xschem abort_operation
+check {T28 I4 save_cards refuses on a live placement and does not eat it} \
+  [list $t28_armed [lindex $t28 0] \
+        [regexp -nocase {plac|preview|pending|gesture} [lindex $t28 1]] $t28_after] \
+  [list {1 12 1} 1 1 {1 12 1}]
+
+# ===========================================================================
+# T29 — THE MERGE TWIN (I4)
+# ===========================================================================
+# Same door, other half: leave_merge_for (scheduler.c:8824). MEASURED — with a
+# pending paste (ui_state 296, one merged wire) a bare `xschem netlist` leaves
+# ui_state 0 and ZERO wires. The pasted objects must survive save_cards.
+opa_s3_load ptop.sch
+set t29_src [file join $scratch t_one_wire.sch]
+set fh [open $t29_src w]
+puts $fh "v {xschem version=3.4.8RC file_version=1.3}"
+puts $fh "G {}" ; puts $fh "K {}" ; puts $fh "V {}" ; puts $fh "S {}" ; puts $fh "E {}"
+puts $fh "N 900 900 1000 900 {}"
+close $fh
+catch {xschem merge $t29_src}
+set t29_armed [list [expr {([xschem get ui_state] & 256) ? 1 : 0}] [xschem get wires]]
+set t29 [rcall {op_annot::save_cards}]
+set t29_after [list [expr {([xschem get ui_state] & 256) ? 1 : 0}] [xschem get wires]]
+xschem abort_operation ; xschem abort_operation ; xschem abort_operation
+check {T29 I4 save_cards refuses on a pending paste and the objects survive} \
+  [list $t29_armed [lindex $t29 0] \
+        [regexp -nocase {paste|merge|pending|gesture} [lindex $t29 1]] $t29_after] \
+  [list {1 1} 1 1 {1 1}]
+
+# ===========================================================================
+# T30 — RE-ENTRANCY RAISES (issue 0438)
+# ===========================================================================
+# Attempt 2 left 0438 open when the only shared state was the card accumulator.
+# The oracle adds two more — a netlist inside a netlist, and the forced/restored
+# netlist globals, whose saved values a nested call would overwrite with the
+# already-forced ones and then "restore" — so a nested call now corrupts the
+# outer walk's idea of the user's settings. It raises instead. The outer walk
+# still restores everything on the way out.
+opa_s3_load ptop.sch
+set t30_before [opa_s3_state]
+set t30_env [opa_t_netenv]
+opa_t_reshim_on
+set t30 [rcall {op_annot::save_cards}]
+set t30_hits $::opa_t_re_hits
+opa_t_reshim_off
+check {T30 0438 a re-entrant save_cards raises, and the outer walk restores} \
+  [list [expr {$t30_hits > 0}] [lindex $t30 0] \
+        [regexp -nocase {save_cards|re-ent|reentr|already} [lindex $t30 1]] \
+        [expr {[opa_s3_state] eq $t30_before}] \
+        [expr {[opa_t_netenv] eq $t30_env}]] \
+  {1 1 1 1 1}
+
+# ===========================================================================
+# T31 — 0443: THE ORACLE'S NETLIST MAY NOT TAKE THE USER'S netlist_name
+# ===========================================================================
+# MEASURED ON THIS TREE, with a HEAD-sharedir control that keeps the name:
+#   working tree   BEFORE=my_custom_deck.spice  AFTER={}
+#   HEAD sharedir  BEFORE=my_custom_deck.spice  AFTER=my_custom_deck.spice
+# `xschem netlist <file>` SETS xctx->netlist_name from the filename it was given
+# (scheduler.c:8768) and then, with erc==0 — which the oracle's netlist always
+# is — CLEARS it (scheduler.c:8841). op_annot::_netlist_env snapshots five
+# globals and this is not one of them, so a read-only annotation click silently
+# discards a netlist filename the user typed. That is a WRITE, and I4's
+# read-only discipline covers editor state and not only the .sch (decision D9).
+#
+# ⚠ TWO LEGS, AND THE SECOND ONE IS GREEN TODAY ON PURPOSE. An empty name at
+# entry must still be empty afterwards: a "restore" that fabricates a name is
+# the opposite defect and a one-legged row would not see it.
+opa_s3_load ptop.sch
+catch {xschem set netlist_name my_custom_deck.spice}
+set t31_before [lindex [rcall {xschem get netlist_name}] 1]
+set t31_rc     [lindex [rcall {op_annot::save_cards}] 0]
+set t31_after  [lindex [rcall {xschem get netlist_name}] 1]
+catch {xschem set netlist_name {}}
+set t31_rc2    [lindex [rcall {op_annot::save_cards}] 0]
+set t31_after2 [lindex [rcall {xschem get netlist_name}] 1]
+catch {xschem set netlist_name {}}
+check {T31 0443 the oracle's netlist leaves the user's netlist_name alone} \
+  [list $t31_before $t31_rc $t31_after $t31_rc2 $t31_after2] \
+  {my_custom_deck.spice 0 my_custom_deck.spice 0 {}}
+
+# ===========================================================================
+# T31b — 0443 ON THE RAISING PATH, WHICH IS THE WORSE HALF
+# ===========================================================================
+# MEASURED, and it is not merely "cleared": with the oracle directory forced
+# unwritable, save_cards raises and leaves netlist_name reading
+# `op_annot_oracle_38306.spice` — op_annot's OWN THROWAWAY FILENAME, complete
+# with the pid. The user's netlist name has not been lost, it has been replaced
+# by a private temp file's. `_restore_netlist_env` already runs on every path
+# out of `_oracle_deck`, so the row is the proof that the new snapshot row rides
+# that same discipline rather than sitting on the happy path.
+opa_s3_load ptop.sch
+catch {xschem set netlist_name raise_probe.spice}
+opa_t_dirshim_on
+set t31b_rc [lindex [rcall {op_annot::save_cards}] 0]
+opa_t_dirshim_off
+set t31b_after [lindex [rcall {xschem get netlist_name}] 1]
+catch {xschem set netlist_name {}}
+check {T31b 0443 netlist_name survives the RAISING path too} \
+  [list $t31b_rc $t31b_after] {1 raise_probe.spice}
+
+# ===========================================================================
+# T32 — 0447: A `.subckt`/`.ends` PAIR INSIDE THE USER REGION CLOSES THE BLOCK
+# ===========================================================================
+# The parser's ONE hand-written rule is the user-architecture region, and today
+# it is consulted TOO LATE: `_deck_index` tests `.subckt` / `.ends` BEFORE
+# `if {$inuser} { continue }`, so a complete `.subckt`/`.ends` pair inside the
+# region runs `.ends` -> `set cur {}` and EVERY ELEMENT AFTER IT IN THAT BLOCK
+# is silently dropped. MEASURED on exactly this text: the shipped parser answers
+# `xreal` and loses `xafter`.
+#
+# ⚠ THE ASSERTION IS THE EXACT LIST, BECAUSE THAT IS WHAT COVERS BOTH
+# DIRECTIONS AT ONCE. The pre-fix ordering answers {xreal} and reds; a parser
+# with the region rule DISABLED answers {xreal xfabricated ...} and reds too.
+# A row that only asked "is xafter present" would go green on the second, which
+# is the T23 defect (a fabricated element line read as proof a dropped device
+# is in the deck) arriving through the fix for this one.
+set T_UREGSYNTH "** sch_path: [file join $lib ptop.sch]
+**.subckt ptop
+XREAL net1 pmodel
+**** begin user architecture code
+xfabricated net9 pmodel
+.subckt helper a b
+Rh a b 1k
+.ends
+**** end user architecture code
+XAFTER net4 pmodel
+**.ends
+.end
+"
+check {T32 0447 a user-region .subckt/.ends does not close the enclosing block} \
+  [rcall {dict get [::op_annot::_deck_index $::T_UREGSYNTH] \
+                   [::op_annot::_normkey [file join $::lib ptop.sch]]}] \
+  {0 {xreal xafter}}
+
+# ===========================================================================
+# T32b — 0447 END TO END, ON A REAL DECK THE NETLISTER WROTE
+# ===========================================================================
+# T32 states the parser rule; this proves the rule reaches the emitter and is
+# not a unit-test artefact. The control half asserts the deck really has the
+# shape — begin marker, `.subckt helper` inside it, end marker, and only THEN
+# `XMAFTER` — so the row cannot pass because the trap failed to arm.
+#
+# ⚠ A SUBCIRCUIT, NOT THE TOP CELL, AND NOT `schprop` — see the fixture note
+# above. Both alternatives were measured and neither can place an element line
+# after the region.
+opa_s3_load puregtop.sch
+set t32b_deck [opa_t_netlist_text]
+set t32b_beg 0 ; set t32b_sub 0 ; set t32b_end 0 ; set t32b_shape 0
+foreach l [split $t32b_deck "\n"] {
+  set tl [string trim $l]
+  if {[string match {\*\*\*\* begin user architecture*} $tl]} { set t32b_beg 1 ; continue }
+  if {[string match {\*\*\*\* end user architecture*} $tl]}   { set t32b_end 1 ; continue }
+  if {$t32b_beg && !$t32b_end && [regexp -nocase {^\.subckt[ \t]+helper} $tl]} {
+    set t32b_sub 1 ; continue
+  }
+  if {$t32b_sub && $t32b_end && [string match {XMAFTER *} $tl]} { set t32b_shape 1 }
+}
+opa_s3_load puregtop.sch
+set t32b [rcall {opa_s3_lines [op_annot::save_cards]}]
+set t32b_w [llength [lindex [rcall {op_annot::last_warnings}] 1]]
+check {T32b 0447 the device placed after a user-region .subckt still gets cards} \
+  [list $t32b_shape $t32b $t32b_w] \
+  [list 1 [list 0 $T_UREGGOLD] 0]
+
+# ===========================================================================
+# T33 — N6 WITH A PERFECTLY GOOD DIRECTORY: THE NETLIST RAN AND WROTE NOTHING
+# ===========================================================================
+# ⚠ THIS ROW EXISTS BECAUSE T16's FIX WOULD OTHERWISE DELETE T16's MEANING.
+# Once `_oracle_dir_ready` raises before the netlist is issued (decision D11),
+# the unwritable-directory row no longer reaches `_oracle_deck`'s
+# `![file isfile $out]` branch at all — and that branch is decision N6 itself,
+# the one thing standing between "the oracle failed" and an empty index that
+# emits zero cards and reports success. Unreachable-from-any-test is how a green
+# check certifies nothing, which is the exact shape that has now reverted this
+# step twice (decision D12).
+#
+# So: a REAL, writable oracle directory, and the netlist invocation defeated at
+# its own named seam. The hit counter is what stops the row passing vacuously —
+# with `_oracle_run` absent the shim counts a proc nobody calls.
+opa_s3_load ptop.sch
+set t33_before [opa_s3_state]
+set t33_dir [lindex [rcall {::op_annot::_oracle_dir}] 1]
+set t33_census0 [opa_t_dircensus $t33_dir]
+opa_t_runshim_on nowrite
+set t33 [rcall {op_annot::save_cards}]
+set t33_hits $::opa_t_run_hits
+opa_t_runshim_off
+set t33_after [opa_s3_state]
+set t33_left [opa_t_delta $t33_census0 [opa_t_dircensus $t33_dir]]
+check {T33 N6 a netlist that writes no deck RAISES naming the oracle, and cleans up} \
+  [list [expr {$t33_hits > 0}] [lindex $t33 0] \
+        [regexp -nocase {oracle} [lindex $t33 1]] \
+        [expr {$t33_after eq $t33_before}] $t33_left] \
+  [list 1 1 1 1 {}]
+
+# ===========================================================================
+# T34 — THE WARNINGS REACH THE USER, AS `* NOTE:` LINES IN THE .save FILE
+# ===========================================================================
+# The two aggregates exist because "a filter that UNDER-emits in silence is the
+# failure that survived 85 and then 96 green checks" — and today they are
+# computed and thrown away. `write_save_file` never reads `last_warnings`, and
+# the menu command only speaks on an error or on an empty block, so the user who
+# clicks the item on ptop.sch is told nothing about 2 devices and 6 subcircuits
+# that got no cards. The textwindow the menu already opens becomes the channel,
+# at zero new UI and with no dialog that could fire on a healthy design
+# (decision D13).
+#
+# The shape asserted: line 0 is the `*` header, then EXACTLY
+# `[llength [op_annot::last_warnings]]` lines each starting `* NOTE:`, then one
+# blank, then the block unchanged. And on a warning-free cell, NO NOTE line at
+# all — so S17's structure is preserved by construction rather than by luck.
+set t34_dir [file join $scratch tsavedir]
+file mkdir $t34_dir
+set t34_nd {}
+if {[info exists ::netlist_dir]} { set t34_nd $::netlist_dir }
+set ::netlist_dir $t34_dir
+opa_s3_load ptop.sch
+catch {file delete -force [file join $t34_dir ptop.save]}
+set t34_p [rcall {op_annot::write_save_file}]
+set t34_w [llength [lindex [rcall {op_annot::last_warnings}] 1]]
+set t34_body {}
+if {[file isfile [file join $t34_dir ptop.save]]} {
+  set fh [open [file join $t34_dir ptop.save] r] ; set t34_body [read $fh] ; close $fh
+}
+set t34_lines [opa_s3_lines $t34_body]
+set t34_notes {}
+set t34_i 1
+while {[string match {\* NOTE:*} [lindex $t34_lines $t34_i]]} {
+  lappend t34_notes [lindex $t34_lines $t34_i] ; incr t34_i
+}
+## the warning-free half
+opa_s3_load pleaf.sch
+catch {file delete -force [file join $t34_dir pleaf.save]}
+set t34_p2 [rcall {op_annot::write_save_file}]
+set t34_w2 [llength [lindex [rcall {op_annot::last_warnings}] 1]]
+set t34_body2 {}
+if {[file isfile [file join $t34_dir pleaf.save]]} {
+  set fh [open [file join $t34_dir pleaf.save] r] ; set t34_body2 [read $fh] ; close $fh
+}
+set t34_lines2 [opa_s3_lines $t34_body2]
+set t34_notes2 0
+foreach l $t34_lines2 { if {[string match {\* NOTE:*} $l]} { incr t34_notes2 } }
+if {$t34_nd ne {}} { set ::netlist_dir $t34_nd }
+check {T34 write_save_file surfaces last_warnings as `* NOTE:` lines, none when clean} \
+  [list $t34_w [llength $t34_notes] \
+        [string index [lindex $t34_lines 0] 0] \
+        [lindex $t34_lines $t34_i] \
+        [lrange $t34_lines [expr {$t34_i + 1}] end] \
+        $t34_w2 $t34_notes2 [lrange $t34_lines2 2 end]] \
+  [list 2 2 * {} $T_GOLD 0 0 $T_LEAFGOLD]
+
+opa_s3_load ptop.sch
+opa_alert_shim_off
+
+} terr]} {
+  puts "UNEXPECTED ERROR (section T): $terr"
+  incr fail
+}
+## also on the error path: a leaked shim would leave the REST of the session
+## without the real `alert_`. Idempotent, so the happy-path call above is not
+## undone by this one.
+opa_alert_shim_off
+
 # --- verdict -----------------------------------------------------------------
