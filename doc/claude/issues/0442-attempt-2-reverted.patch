+# --- S3b helpers --------------------------------------------------------------
+## Descend into instance <i> from the current level. ⚠ `xschem select instance`
+## TOGGLES, and after a go_back the instance you came from is still selected, so
+## the unselect_all is load-bearing (see the section header).
+proc opa_s3_descend {i} {
+  catch {xschem unselect_all}
+  catch {xschem select instance $i fast nodraw}
+  return [xschem descend 1 2]
+}
+
+## Read the raw at $lib/s3.raw while standing where we stand, and WITNESS the
+## collapse it causes. Returns {rc sch_path sim_sch_path}: a row that asserts
+## "the deck basis is unmoved by a raw" is worthless unless the raw actually
+## moved something, and a silently failed raw_read would make S20-S22 pass
+## against the very bug they exist for.
+proc opa_s3_raw_witness {} {
+  global lib
+  set rc [catch {xschem raw_read [file join $lib s3.raw]} r]
+  return [list $rc $r [xschem get sch_path] [xschem get sim_sch_path]]
+}
+proc opa_s3_raw_clear {} { catch {xschem raw_clear} ; return {} }
+
+## The device paths a block names, as a SORTED SET: `.save @m.xmok[gm]` -> @m.xmok.
+## `.save all` is not a device and is dropped.
+proc opa_s3_devs {lines} {
+  set out {}
+  foreach l $lines {
+    if {![regexp {^\.save +(.+)$} $l -> v]} { continue }
+    if {$v eq {all}} { continue }
+    regsub {\[[^\]]*\]$} $v {} v
+    lappend out $v
+  }
+  return [lsort -unique $out]
+}
+
+## What `xschem netlist` ACTUALLY writes for the currently loaded cell, as the
+## sorted set of lowercased element names of the DECK TOP subcircuit. This is
+## the oracle of row S31 — the netlister itself, not a re-implementation of its
+## rules. The top block is delimited by `**.subckt` / `**.ends` (spice_netlist.c
+## comments out the top-level wrapper); `.subckt` blocks below it belong to
+## symbols and are deliberately not counted.
+proc opa_s3_netlist_elems {} {
+  global scratch
+  set dir [file join $scratch nl]
+  file mkdir $dir
+  set base [file rootname [file tail [xschem get schname]]]
+  catch {file delete -force [file join $dir $base.spice]}
+  set old_nd {} ; set old_nt {}
+  if {[info exists ::netlist_dir]} { set old_nd $::netlist_dir }
+  catch {set old_nt [xschem get netlist_type]}
+  set ::netlist_dir $dir
+  catch {xschem set netlist_type spice}
+  catch {xschem netlist}
+  if {$old_nd ne {}} { set ::netlist_dir $old_nd }
+  if {$old_nt ne {}} { catch {xschem set netlist_type $old_nt} }
+  if {![file isfile [file join $dir $base.spice]]} { return {NO-NETLIST} }
+  set fh [open [file join $dir $base.spice] r] ; set body [read $fh] ; close $fh
+  set out {} ; set inside 0
+  foreach l [split $body \n] {
+    if {[string match {**.subckt*} $l]} { set inside 1 ; continue }
+    if {[string match {**.ends*}   $l]} { set inside 0 ; continue }
+    if {!$inside} { continue }
+    set l [string trim $l]
+    if {$l eq {}} { continue }
+    if {[string index $l 0] eq {*}} { continue }
+    if {[string index $l 0] eq {+}} { continue }
+    if {[string index $l 0] eq {.}} { continue }
+    lappend out [string tolower [lindex $l 0]]
+  }
+  return [lsort -unique $out]
+}
