+# the store and a different library path; without this row a broken fixture
+# would degrade every S row below into a hollow pass.
+check {S0 FIXTURE store cleared, and the 3-level fixture loads at every level} \
+  [list [rcall {opa_clear_store}] \
+        [opa_s3_load s3leaf.sch] [xschem getprop instance 0 name] \
+        [xschem getprop instance 0 cell::type] \
+        [opa_s3_load s3top.sch] [xschem getprop instance 0 name] \
+        [xschem getprop instance 0 cell::type] [xschem getprop instance 1 name] \
+        [xschem getprop instance 1 cell::type] [opa_s3_state]] \
+  [list {0 {{} {} {}}} {1 0 . 0} M1 nmos {2 0 . 0} x1 subcircuit M9 nmos \
+        $S3_ENTRY]
+
+# ===========================================================================
+# S1 — the three deliverables exist
+# ===========================================================================
+# ⚠ THE rcall DISCIPLINE'S PARTNER. An absent proc must red ONE legible row;
+# without this the expects-blank rows below would be satisfied by
+# `invalid command name`.
+check {S1 save_cards, last_warnings and write_save_file all exist} \
+  [list [expr {[info commands ::op_annot::save_cards]      ne {}}] \
+        [expr {[info commands ::op_annot::last_warnings]   ne {}}] \
+        [expr {[info commands ::op_annot::write_save_file] ne {}}]] \
+  {1 1 1}
+
+# ===========================================================================
+# S2 — THE GOLDEN CARD LIST
+# ===========================================================================
+catch {op_annot::register nmos $S3_DESC}
+opa_s3_load s3top.sch
+check {S2 GOLDEN 13-line block, depth-first, cards BEFORE descending} \
+  [rcall {opa_s3_lines [op_annot::save_cards]}] [list 0 $S3_GOLD]
+
+set s3_block {}
+catch {set s3_block [op_annot::save_cards]}
+set s3_lines [opa_s3_lines $s3_block]
+
+# ===========================================================================
+# S3 — THE CARD IS BARE (spec §3 R4). THE MOST IMPORTANT ROW IN THE STEP.
+# ===========================================================================
+# The three params deliberately span all three kinds (id=0, gm=1, vth=2). If
+# the emitter went through op_annot::vector, 8 of the 12 cards would gain an
+# `i(` or `v(` wrapper — and ngspice would then put NOTHING in the raw for
+# them, with no diagnostic. The second half recomputes the top-level cards from
+# op_annot::devpath at the call site: same builder (I1), no wrapper.
+#
+# ⚠ THE RECOMPUTE ASKS FOR THE **deck** BASIS (issue 0436 / D1). A save card is a
+# line in an UNSIMULATED deck, so it is rooted at the walk's entry cell and no
+# loaded raw may perturb it; `read` is the display basis and is measurably a
+# different string the moment a raw is loaded below the entry (rows S20-S22).
+# The walk entered at the top here, so root is `.`.
+set s3_m9 {}
+catch { foreach p {id gm vth} { lappend s3_m9 ".save [op_annot::devpath M9 deck .]\[$p\]" } }
+check {S3 R4/I1 no card is wrapped, and the M9 cards are [devpath][param]} \
+  [list [llength [lsearch -all -glob $s3_lines {*i(*}]] \
+        [llength [lsearch -all -glob $s3_lines {*v(*}]] \
+        [expr {[lrange $s3_lines end-2 end] eq $s3_m9}] [llength $s3_m9]] \
+  {0 0 1 3}
+
+# ===========================================================================
+# S4/S5 — I2 / rule R2, and I2's SPELLING
+# ===========================================================================
+check {S4 I2/R2 the block's FIRST line is `.save all`, and exactly one line is} \
+  [list [lindex $s3_lines 0] [llength [lsearch -all -exact $s3_lines {.save all}]]] \
+  [list {.save all} 1]
+
+# ⚠ Measured on ngspice-42 AND 46+: the bare deck-level form is a hard error and
+# writes NO raw file at all. The line count is in the golden so an absent
+# save_cards (one empty line) cannot satisfy the row.
+check {S5 I2 SPELLING no line is the bare `save all` (it kills the whole run)} \
+  [list [llength [lsearch -all -exact $s3_lines {save all}]] [llength $s3_lines]] \
+  {0 13}
+
+# ===========================================================================
+# S6 — the 0425 CONSUMER CONTRACT: skip on a blank DEVPATH, never on a blank
+#      DESCRIPTOR (src/op_annot.tcl:122-124)
+# ===========================================================================
+# The descriptor is still fully registered; only its `match` glob stops
+# claiming the cell. An emitter that tested the DESCRIPTOR would emit twelve
+# cards with an EMPTY device name — and per spec landmine 9 ngspice answers a
+# bogus card with a fabricated 0.0 column, not a blank.
+catch {op_annot::register nmos [list devpath $S3_TMPL params $S3_PARAMS \
+                                    match {*nothing_matches_this*}]}
+check {S6 0425 a non-matching cell yields {} — not a lone `.save all`, not a raise} \
+  [list [expr {[op_annot::descriptor nmos] ne {}}] [rcall {op_annot::save_cards}]] \
+  [list 1 {0 {}}]
+
+# ===========================================================================
+# S7 — `derived` and `pinexpr` CONTRIBUTE NO CARDS (spec §4.3)
+# ===========================================================================
+# `gm/id` is computed from params after they are read and `vgs` is a pin
+# expression; neither has a vector in any raw. The S2 descriptor deliberately
+# carries neither key, so this row is their sole guardian.
+catch {op_annot::register nmos [list devpath $S3_TMPL params $S3_PARAMS \
+        match $S3_MATCH derived {{gm/id {$gm/$id}}} \
+        pinexpr {{vgs {expr(@#1:spice_get_voltage - @#2:spice_get_voltage)}}}]}
+check {S7 derived and pinexpr add no cards: the block is byte-identical to S2} \
+  [rcall {opa_s3_lines [op_annot::save_cards]}] [list 0 $S3_GOLD]
+
+# ===========================================================================
+# S8 — I6, HAPPY PATH
+# ===========================================================================
+# ⚠ THE rc IS IN THE GOLDEN. Without it the row passes against an absent
+# save_cards: a call that raises before touching anything leaves the state
+# trivially unchanged.
+catch {op_annot::register nmos $S3_DESC}
+opa_s3_load s3top.sch
+set s8_before [opa_s3_state]
+set s8_rc [lindex [rcall {op_annot::save_cards}] 0]
+check {S8 I6 no_draw / keep_symbols / currsch / sch_path all back after a walk} \
+  [list $s8_rc $s8_before [expr {[opa_s3_state] eq $s8_before}]] \
+  [list 0 $S3_ENTRY 1]
+
+# ===========================================================================
+# S9 — I6 for no_undo, FUNCTIONALLY (issue 0432: there is no getter)
+# ===========================================================================
+# ⚠ `xschem get no_undo` returns {} whether the flag is 0 or 1 — measured
+# before and after `xschem set no_undo 1`. So the flag is probed by its EFFECT.
+# The paired control under an explicit `no_undo 1` is what proves the probe
+# discriminates instead of passing on any binary at all.
+opa_s3_load s3top.sch
+set s9_rc [lindex [rcall {op_annot::save_cards}] 0]
+set s9_live [opa_s3_undo_probe]
+opa_s3_load s3top.sch
+xschem set no_undo 1
+set s9_dead [opa_s3_undo_probe]
+xschem set no_undo 0
+check {S9 I6 undo still works after the walk; control: no_undo 1 breaks it} \
+  [list $s9_rc $s9_live $s9_dead] [list 0 {2 1 2} {2 1 1}]
+
+# ===========================================================================
+# S10 — I6, FORCED MID-WALK FAILURE: RE-RAISED, NOT SWALLOWED
+# ===========================================================================
+# A partial block silently returned is spec landmine 9's fabricated-zeros
+# hazard wearing a different hat: the missing devices do not blank, they get a
+# 0.0 column. The walk must re-raise and let the caller decide.
+opa_s3_load s3top.sch
+set s10_before [opa_s3_state]
+opa_s3_shim_on
+set s10 [rcall {op_annot::save_cards}]
+set s10_after [opa_s3_state]
+set s10_hits $::opa_s3_shim_hits
+opa_s3_shim_off
+check {S10 I6 a forced mid-walk failure propagates out of save_cards} \
+  [list [lindex $s10 0] \
+        [string match {*opa forced mid-walk failure*} [lindex $s10 1]] \
+        [expr {$s10_hits > 0}]] \
+  {1 1 1}
+
+# ===========================================================================
+# S11 — I6, THE ROW ISSUE 0431 EXISTS FOR
+# ===========================================================================
+# Before-state, reproduced on this tree: sky130_save_fet_params raises and
+# returns with no_draw=1 keep_symbols=1 still set. The shim-hit count is what
+# stops this row passing against an absent save_cards.
+check {S11 I6 after the forced failure the entry state is fully restored (0431)} \
+  [list [expr {$s10_hits > 0}] $s10_before $s10_after \
+        [expr {$s10_after eq $s10_before}] [opa_s3_undo_probe]] \
+  [list 1 $S3_ENTRY $S3_ENTRY 1 {2 1 2}]
+
+# ===========================================================================
+# S12 — I6, THE UNWIND IS BOUNDED BY THE ENTRY LEVEL, NOT BY 0
+# ===========================================================================
+# This is the half of I6 that issue 0431 never measured: its cell raises at the
+# TOP level, where sch_path survives by luck. Entering the walk already
+# descended into x1 and forcing the same raise two levels down, the restore
+# must land back on currsch=1 / sch_path=.x1. — the src/xschem.tcl:3857 idiom
+# `while {[xschem get currsch]} {xschem go_back}` would ascend past the caller.
+opa_s3_load s3top.sch
+xschem unselect_all
+xschem select instance 0 fast nodraw
+xschem descend 1 2
+set s12_before [opa_s3_state]
+opa_s3_shim_on
+set s12 [rcall {op_annot::save_cards}]
+set s12_after [opa_s3_state]
+set s12_hits $::opa_s3_shim_hits
+opa_s3_shim_off
+while {[xschem get currsch] > 0} { catch {xschem go_back 2} }
+check {S12 I6 the unwind stops at the ENTRY level (currsch 1, sch_path .x1.)} \
+  [list [expr {$s12_hits > 0}] $s12_before $s12_after] \
+  [list 1 {0 0 1 .x1.} {0 0 1 .x1.}]
+
+# ===========================================================================
+# S13 — I4: the overlay never modifies the schematic
+# ===========================================================================
+opa_s3_load s3top.sch
+set s13_m0 [xschem get modified]
+set s13_rc1 [lindex [rcall {op_annot::save_cards}] 0]
+set s13_m1 [xschem get modified]
+opa_s3_shim_on
+set s13_rc2 [lindex [rcall {op_annot::save_cards}] 0]
+set s13_hits $::opa_s3_shim_hits
+opa_s3_shim_off
+set s13_m2 [xschem get modified]
+check {S13 I4 the walk never dirties the .sch, happy path or forced failure} \
+  [list $s13_m0 $s13_rc1 $s13_m1 [expr {$s13_hits > 0}] $s13_rc2 $s13_m2] \
+  {0 0 0 1 1 0}
+
+# ===========================================================================
+# S14 — THE WARNINGS CHANNEL
+# ===========================================================================
+# The prototype's answer to an undescendable instance is a bare `puts` (
+# sg13g2_procs.tcl:405), which is invisible under --nogui and unassertable.
+# s3bad.sym has NO .sch: measured, `xschem descend` returns 0, currsch DOES
+# increment (issue 0250 class 2) and `xschem get descend_error` is
+# `load-failed`. The walk must still emit the sibling FET's cards.
+opa_s3_load s3top.sch
+set s14_clean [rcall {op_annot::save_cards ; op_annot::last_warnings}]
+opa_s3_load s3badtop.sch
+set s14 [rcall {op_annot::save_cards}]
+set s14_w [rcall {op_annot::last_warnings}]
+check {S14 an undescendable subcircuit is reported in last_warnings, not `puts`} \
+  [list $s14_clean [lindex $s14 0] [opa_s3_lines [lindex $s14 1]] \
+        [lindex $s14_w 0] [llength [lindex $s14_w 1]] \
+        [string match {*xb*} [lindex $s14_w 1]] \
+        [string match {*load-failed*} [lindex $s14_w 1]] [opa_s3_state]] \
+  [list {0 {}} 0 $S3_BADGOLD 0 1 1 1 $S3_ENTRY]
+
+# ===========================================================================
+# S15 — issue 0433: A CLASS-1 DESCEND REFUSAL MUST NOT OVER-ASCEND
+# ===========================================================================
+# `xschem descend` returns 0 in TWO classes with OPPOSITE required responses
+# (actions.c:4055-4065). Measured on this tree: a blank/missing schematic
+# returns 0 with currsch INCREMENTED (`load-failed`), while a refusal BEFORE
+# descending returns 0 with currsch UNCHANGED (`no-selection`, `maxdepth`,
+# `not-descendable:<type>`). Both PDK prototypes answer 0 with an unconditional
+# `go_back 2` — right for the first class, and for the second it pops a level
+# it never pushed, so the walk re-visits levels and emits DUPLICATE cards.
+# s3rec.sym instantiates itself, so the walk hits CADMAXHIER=40 and takes the
+# class-1 path for real. 118 lines = `.save all` + 39 levels x 3 params.
+opa_s3_load s3rectop.sch
+set s15 [rcall {op_annot::save_cards}]
+set s15_w [rcall {op_annot::last_warnings}]
+set s15_lines [opa_s3_lines [lindex $s15 1]]
+check {S15 0433 the recursive walk terminates, emits no duplicate card, restores} \
+  [list [lindex $s15 0] [llength $s15_lines] \
+        [expr {[llength $s15_lines] == [llength [lsort -unique $s15_lines]]}] \
+        [lindex $s15_w 0] [llength [lindex $s15_w 1]] \
+        [string match {*xr*} [lindex $s15_w 1]] \
+        [string match {*maxdepth*} [lindex $s15_w 1]] [opa_s3_state]] \
+  [list 0 118 1 0 1 1 1 $S3_ENTRY]
+
+# ===========================================================================
+# S16 — THE ACTION LOG (fires only under --logdir)
+# ===========================================================================
+# descend and go_back SELF-LOG (actions.c:4073, :4229). A walk over a real
+# design would flood a log whose contract is REPLAYABLE USER EDITS with
+# hundreds of navigation lines. The control half is the important one: an
+# unpopped `log_action -suppress push` silences the user's log for the rest of
+# the session, which is a worse defect than the noise it removes.
+if {[xschem get actionlog_filename] eq {}} {
+  skiprow {S16 the walk suppresses its own descend/go_back log traffic} \
+          {no action log open -- run with --logdir}
+} else {
+  opa_s3_load s3top.sch
+  set s16_d0 [opa_s3_logcount {xschem descend*}]
+  set s16_g0 [opa_s3_logcount {xschem go_back*}]
+  set s16 [rcall {opa_s3_lines [op_annot::save_cards]}]
+  set s16_d1 [opa_s3_logcount {xschem descend*}]
+  set s16_g1 [opa_s3_logcount {xschem go_back*}]
+  xschem unselect_all
+  xschem select instance 0 fast nodraw
+  xschem descend 1 2
+  xschem go_back 2
+  set s16_d2 [opa_s3_logcount {xschem descend*}]
+  set s16_g2 [opa_s3_logcount {xschem go_back*}]
+  check {S16 the walk logs no navigation, and the suppress scope IS popped after} \
+    [list [lindex $s16 0] [llength [lindex $s16 1]] \
+          [expr {$s16_d1 - $s16_d0}] [expr {$s16_g1 - $s16_g0}] \
+          [expr {$s16_d2 - $s16_d1}] [expr {$s16_g2 - $s16_g1}]] \
+    {0 13 0 0 1 1}
+}
+
+# ===========================================================================
+# S17 — THE MENU DELIVERABLE: $netlist_dir/<cell>.save
+# ===========================================================================
+# Modelled on IHP's `Create FET and BIP .save file` (sg13g2_procs.tcl:602-606),
+# whose `file mkdir $netlist_dir` sky130_procs.tcl:235 lacks — keep IHP's. The
+# header is the writer's, not save_cards': S4's consumer injects the block into
+# a deck where a prose comment is noise, while a human opening this file needs
+# the `.include` instruction. Structure is asserted, prose is not.
+set s17_dir [file join $scratch savedir]
+file mkdir $s17_dir
+set s17_saved_nd {}
+if {[info exists ::netlist_dir]} { set s17_saved_nd $::netlist_dir }
+set ::netlist_dir $s17_dir
+opa_s3_load s3top.sch
+catch {file delete -force [file join $s17_dir s3top.save]}
+set s17 [rcall {op_annot::write_save_file}]
+set s17_body {}
+if {[file isfile [file join $s17_dir s3top.save]]} {
+  set fh [open [file join $s17_dir s3top.save] r]
+  set s17_body [read $fh] ; close $fh
+}
+set s17_lines [opa_s3_lines $s17_body]
+check {S17 write_save_file writes <netlist_dir>/s3top.save: header, blank, block} \
+  [list $s17 [file isfile [file join $s17_dir s3top.save]] \
+        [string index [lindex $s17_lines 0] 0] [lindex $s17_lines 1] \
+        [lrange $s17_lines 2 end]] \
+  [list [list 0 [file join $s17_dir s3top.save]] 1 * {} $S3_GOLD]
+
+# ===========================================================================
+# S18 — AN EMPTY BLOCK WRITES NO FILE
+# ===========================================================================
+# A .save file containing only a header says nothing and reports success. {} is
+# what lets the caller say WHICH first-run confusion it hit (spec §4.6).
+catch {op_annot::register nmos [list devpath $S3_TMPL params $S3_PARAMS \
+                                    match {*nothing_matches_this*}]}
+catch {file delete -force [file join $s17_dir s3top.save]}
+set s18 [rcall {op_annot::write_save_file}]
+check {S18 with nothing to save, write_save_file returns {} and writes no file} \
+  [list $s18 [file exists [file join $s17_dir s3top.save]]] \
+  [list {0 {}} 0]
+catch {op_annot::register nmos $S3_DESC}
+if {$s17_saved_nd ne {}} { set ::netlist_dir $s17_saved_nd }
+
+# ===========================================================================
+# S19 — THE MENU IS WIRED (X only)
+# ===========================================================================
+# Its real job is to prove the new src/xschem.tcl line did not break
+# build_widgets: a raise there kills GUI startup outright.
+if {![info exists ::has_x] || !$::has_x} {
+  skiprow {S19 Simulation > Graphs carries `Create device OP .save file`} \
+          {no X -- run under xvfb without --nogui}
+} else {
+  set s19_menu "[xschem get top_path].menubar.simulation.graph"
+  set s19_labels {}
+  if {[winfo exists $s19_menu]} {
+    for {set i 0} {$i <= [$s19_menu index end]} {incr i} {
+      catch {lappend s19_labels [$s19_menu entrycget $i -label]}
+    }
+  }
+  check {S19 Simulation > Graphs carries `Create device OP .save file`} \
+    [list [winfo exists $s19_menu] \
+          [expr {[lsearch -exact $s19_labels {Create device OP .save file}] >= 0}]] \
+    {1 1}
+}
+
+# ###########################################################################
+# S3b — THE THREE THINGS ATTEMPT 1 GOT WRONG, EACH WITH THE ROWS THAT WOULD
+#       HAVE CAUGHT IT
+# ###########################################################################
+# Attempt 1 was green on 85 checks and still shipped two defects. Measured
+# reason, not a guess: `grep -cE 'raw_read|annotate_op|spice_ignore'` over that
+# suite = 0. Not one row loaded a raw, and not one placed an instance the
+# netlister drops. Everything from here down is exactly those two families,
+# plus the guardian of the cgso/cgdo ruling in section P.
+#
+#   S20-S25  the BASIS (issue 0436): a save card is DECK-ABSOLUTE, a display
+#            name is raw-relative, and they are different strings.
+#   S26-S31  the FILTER (issue 0437): a card for a device the deck does not
+#            contain is a fabricated 0.0 column on the schematic, not a blank.
+#
+# ⚠ WHY THE S2 GOLDEN DID NOT HAVE TO CHANGE, and why that is the trap: with no
+# raw loaded AND the walk entering at currsch 0 the two bases produce the SAME
+# string. Every row above is blind to the whole defect by construction. A row
+# only sees it if a raw is loaded (S20-S22) or the walk starts descended (S24).
+
+# ===========================================================================
+# S20 — THE ROW ISSUE 0436 EXISTS FOR: a loaded raw must not move a save card
+# ===========================================================================
+# `xschem raw_read` binds raw->schname to the cell the READER was standing in
+# (save.c:1260), and sch_waves_loaded() (draw.c:2825-2841) then re-finds that
+# cell AS THE WALK DESCENDS and strips a component off every path. The block
+# below is written for a deck nobody has simulated yet; which raw happens to be
+# open in the editor is not allowed to be an input to it.
+#
+# ⚠ THE WITNESS IS HALF THE ROW. `s20_wit` proves the raw really did collapse
+# `sim_sch_path` at the s3mid level — {.x1. {}} instead of {.x1. x1.}. Without
+# it a raw_read that silently failed would make this row pass against the bug.
+catch {op_annot::register nmos $S3_DESC}
+opa_s3_load s3top.sch
+opa_s3_descend 0
+set s20_wit [lrange [opa_s3_raw_witness] 2 3]
+xschem go_back 2
+set s20 [rcall {opa_s3_lines [op_annot::save_cards]}]
+set s20_lines [lindex $s20 1]
+check {S20 0436 a raw loaded ONE LEVEL DOWN does not move a single save card} \
+  [list $s20_wit [lindex $s20 0] $s20_lines \
+        [expr {[llength $s20_lines] == [llength [lsort -unique $s20_lines]]}]] \
+  [list {.x1. {}} 0 $S3_GOLD 1]
+
+# ===========================================================================
+# S21 — BOTH BASES STAY LIVE, AND UNDER THAT RAW THEY DISAGREE
+# ===========================================================================
+# I1 says ONE builder; D1 says it answers two shapes. This row is what stops the
+# fix degenerating into "make devpath always absolute" — S5's on-screen display
+# reads a LOADED raw and must keep the raw-relative name, which is why `read`
+# stays the default and stays wrong-for-a-card.
+#
+# s3dup holds TWO instances of ONE cell. With the raw open the read basis gives
+# them the SAME string (the collapse, with no warning anywhere); the deck basis
+# keeps them apart. Measured on this fixture with this binary.
+opa_s3_load s3dup.sch
+opa_s3_descend 0
+## {catch-rc raw_read-result} — measured {0 1} on this binary. Both halves are
+## in the golden because a raw that failed to load makes this row assert nothing.
+set s21_rawrc [lrange [opa_s3_raw_witness] 0 1]
+set s21_r1 [rcall {op_annot::devpath M1 read}]
+set s21_d1 [rcall {op_annot::devpath M1 deck .}]
+xschem go_back 2
+opa_s3_descend 1
+set s21_r3 [rcall {op_annot::devpath M1 read}]
+set s21_d3 [rcall {op_annot::devpath M1 deck .}]
+xschem go_back 2
+check {S21 0436 under a raw the READ basis collapses x1/x3, the DECK basis does not} \
+  [list $s21_rawrc $s21_r1 $s21_r3 $s21_d1 $s21_d3] \
+  [list {0 1} {0 @m.xm1.msky130_fd_pr__nfet_01v8} \
+          {0 @m.xm1.msky130_fd_pr__nfet_01v8} \
+          {0 @m.x1.xm1.msky130_fd_pr__nfet_01v8} \
+          {0 @m.x3.xm1.msky130_fd_pr__nfet_01v8}]
+
+# ===========================================================================
+# S22 — THE DEVPROC ROUTE, WHICH NO TEMPLATE ROW CAN COVER
+# ===========================================================================
+# ⚠ THE SHARPEST TRAP IN THIS STEP. There are TWO raw-relative sources and only
+# one of them is in Tcl: `op_annot::_simpath` (which the devproc arm passes as
+# its `path` argument) and `@path` INSIDE `xschem translate` (token.c:4719 is a
+# byte-for-byte copy of sim_sch_path's stripping loop). A fix that swaps only
+# `_simpath` passes every sky130 row — sky130 registers a DEVPROC — and leaves
+# gf180's and IHP's `@path` TEMPLATES silently raw-relative. A fix that only
+# `string map`s `@path` away does the reverse. S20/S21 watch the template arm;
+# this row watches the devproc arm, with the same raw open.
+catch {op_annot::register nmos $S3_DPDESC}
+opa_s3_descend 0
+set s22_r1 [rcall {op_annot::devpath M1 read}]
+set s22_d1 [rcall {op_annot::devpath M1 deck .}]
+xschem go_back 2
+opa_s3_descend 1
+set s22_d3 [rcall {op_annot::devpath M1 deck .}]
+xschem go_back 2
+check {S22 0436 the deck basis reaches the DEVPROC's `path` argument too} \
+  [list $s22_r1 $s22_d1 $s22_d3] \
+  [list {0 @m.xm1.mnfet_01v8} {0 @m.x1.xm1.mnfet_01v8} {0 @m.x3.xm1.mnfet_01v8}]
+opa_s3_raw_clear
+catch {op_annot::register nmos $S3_DESC}
+
+# ===========================================================================
+# S23 — A WRONG BASIS IS LOUD (decision D3)
+# ===========================================================================
+# The brief asks for a difference that is "impossible to get wrong by name".
+# A silent fall-through to `read` would reproduce 0436's failure shape exactly:
+# a caller asks for the write name, gets the read name, and nothing says so. The
+# error discipline in src/op_annot.tcl:152-166 puts data conditions on the blank
+# path and CALLER BUGS on the loud one, and `deck` is unreachable from any
+# draw/tcleval path, so a raise here cannot break rendering.
+#
+# ⚠ THE NEEDLE IS THE CONTRACT: the message must name the argument the caller
+# got wrong, so `absolute` (issue 0436's own rejected spelling) says `basis` and
+# a misplaced root says `root`.
+opa_s3_load s3top.sch
+check_raises {S23a an unrecognised basis raises, naming `basis`} \
+  {op_annot::devpath M9 absolute} {basis}
+check_raises {S23b a non-empty root with basis `read` raises, naming `root`} \
+  {op_annot::devpath M9 read .x1.} {root}
+
+# ===========================================================================
+# S24 — `deck` IS ENTRY-RELATIVE, AND THE FILENAME AGREES WITH THE BODY
+# ===========================================================================
+# D2, and the row that separates the two candidate definitions of "absolute".
+# Issue 0436's fix sketch says level-0-rooted; measurement says entry-rooted:
+# `xschem netlist` invoked while descended into a cell writes THAT cell as the
+# deck top (`**.subckt s3otl`, measured on this binary), so a level-0-rooted
+# card names a device the generated deck does not contain. It is also what
+# reconciles write_save_file's `<current cell>.save` with its own content —
+# attempt 1's unresolved "filename contradicts content" residual.
+#
+# The two definitions COINCIDE at currsch 0, which is why S2 above is unchanged
+# and why this row has to enter the walk already descended.
+opa_s3_load s3top.sch
+opa_s3_descend 0
+set s24_entry [opa_s3_state]
+set s24 [rcall {opa_s3_lines [op_annot::save_cards]}]
+set s24_dir [file join $scratch savedir]
+file mkdir $s24_dir
+set s24_saved_nd {}
+if {[info exists ::netlist_dir]} { set s24_saved_nd $::netlist_dir }
+set ::netlist_dir $s24_dir
+catch {file delete -force [file join $s24_dir s3mid.save]}
+catch {file delete -force [file join $s24_dir s3top.save]}
+set s24_w [rcall {op_annot::write_save_file}]
+set s24_after [opa_s3_state]
+if {$s24_saved_nd ne {}} { set ::netlist_dir $s24_saved_nd }
+while {[xschem get currsch] > 0} { catch {xschem go_back 2} }
+check {S24 D2 a walk entered one level down is rooted THERE, and names s3mid.save} \
+  [list $s24_entry [lindex $s24 0] [lindex $s24 1] \
+        $s24_w [file isfile [file join $s24_dir s3mid.save]] \
+        [file exists [file join $s24_dir s3top.save]] $s24_after] \
+  [list {0 0 1 .x1.} 0 $S3_MIDGOLD \
+        [list 0 [file join $s24_dir s3mid.save]] 1 0 {0 0 1 .x1.}]
+
+# ===========================================================================
+# S25 — A ROOT THAT IS NOT A PREFIX OF THE LIVE PATH RAISES (D3)
+# ===========================================================================
+# The blank alternative is the worse one: `string range` over a mismatched
+# prefix yields a plausible truncation, and per spec landmine 9 a wrong device
+# name does NOT blank at read time — ngspice writes a full 0.0 column under
+# exactly the name asked for. A caller that hands the builder a root from the
+# wrong walk has a bug, and a bug must be loud.
+opa_s3_load s3top.sch
+check_raises {S25 D3 a root that is not a prefix of sch_path raises, naming `root`} \
+  {op_annot::devpath M9 deck .zz.} {root}
+
+# ===========================================================================
+# S26 — THE FILTER TRUTH TABLE (issue 0437). MEASURED, NOT ASSUMED.
+# ===========================================================================
+# The netlister's filter is skip_instance() (netlist.c:1245): inst.flags |
+# sym.flags against SPICE_IGNORE|SPICE_SHORT, where set_inst_flags (actions.c:
+# 1055) reads inst->prop_ptr and set_sym_flags (actions.c:960) reads
+# sym->prop_ptr. Truthy spellings are util.c:72's — `true`/`on`/`yes`
+# case-insensitively and any nonzero all-digit string — plus exact-case `open`
+# and `short`.
+#
+# Measured on THIS fixture with THIS binary — `xschem netlist` writes
+#   XMOK  XMTMPL  XMLVS
+# and nothing at all for MTRUE / MUPPER / MOPEN / MSHORT / MSYM.
+#
+# ⚠ THE ROW IS TWO-DIRECTIONAL ON PURPOSE. MSYM (spice_ignore in the symbol G
+# record) must NOT get cards — that is the 0437 bug. MTMPL (spice_ignore in the
+# symbol TEMPLATE) MUST get them — its device IS in the deck, and 0437's
+# prescribed `translate @spice_ignore` probe would delete it. A filter that is
+# right in only one direction reds here.
+catch {op_annot::register nmos $S3_FDESC}
+opa_s3_load s3filt.sch
+set s26 [rcall {opa_s3_lines [op_annot::save_cards]}]
+check {S26 0437 five ignore spellings contribute no card; MTMPL and MOK do} \
+  [list [lindex $s26 0] [lindex $s26 1] \
+        [llength [lsearch -all -glob [lindex $s26 1] {*mtrue*}]] \
+        [llength [lsearch -all -glob [lindex $s26 1] {*mupper*}]] \
+        [llength [lsearch -all -glob [lindex $s26 1] {*mopen*}]] \
+        [llength [lsearch -all -glob [lindex $s26 1] {*mshort*}]] \
+        [llength [lsearch -all -glob [lindex $s26 1] {*msym*}]] \
+        [llength [lsearch -all -glob [lindex $s26 1] {*mtmpl*}]]] \
+  [list 0 $S3_FILTGOLD 0 0 0 0 0 2]
+
+# ===========================================================================
+# S27 — ⚠ CONTROL. GREEN BEFORE AND AFTER. It pins the MEASUREMENT that makes
+#       issue 0437's prescribed fix wrong, so nobody "fixes" it back.
+# ===========================================================================
+# 0437 says to probe with `xschem translate <inst> @spice_ignore`. translate's
+# fallback is sym->templ ONLY (token.c:5350-5353); it never reads sym->prop_ptr.
+# So it answers {} for the G-record case it was written to catch and `true` for
+# a template-borne one whose device IS in the netlist — wrong in BOTH
+# directions. The netlister-faithful pair is `getprop instance <n>
+# spice_ignore` OR `... cell::spice_ignore`. This row asserts the PROBE's
+# behaviour, not the filter's, so it must stay green when the filter is
+# sabotaged — that is what makes it a control rather than a duplicate of S26.
+check {S27 0437 CORRECTION: translate @spice_ignore is wrong in BOTH directions} \
+  [list [xschem translate MSYM  {@spice_ignore}] \
+        [xschem translate MTMPL {@spice_ignore}] \
+        [xschem getprop instance MSYM  cell::spice_ignore] \
+        [xschem getprop instance MSYM  spice_ignore] \
+        [xschem getprop instance MTMPL cell::spice_ignore] \
+        [xschem getprop instance MTMPL spice_ignore] \
+        [xschem getprop instance MTRUE spice_ignore]] \
+  [list {} true true {} {} {} true]
+
+# ===========================================================================
+# S28 — AN IGNORED SUBCIRCUIT IS NOT DESCENDED INTO (decision D6)
+# ===========================================================================
+# Measured: with `spice_ignore=true` on x1 the deck's top subckt holds XM9
+# alone. s3mid's `.subckt` DEFINITION is still written (spice_netlist.c:464
+# keys on the SYMBOL flag) but nothing calls it, so no device below x1 exists in
+# the run. A guard bolted onto the card emitter alone would still walk in and
+# emit x2[1]/x2[0]/M5 — 0437's class of card arriving through a different door.
+# The control half (s3top, unchanged, still S3_GOLD) is what proves the walk did
+# not simply stop descending everywhere.
+catch {op_annot::register nmos $S3_DESC}
+opa_s3_load s3igntop.sch
+set s28 [rcall {opa_s3_lines [op_annot::save_cards]}]
+set s28_state [opa_s3_state]
+opa_s3_load s3top.sch
+set s28_ctl [rcall {opa_s3_lines [op_annot::save_cards]}]
+check {S28 D6 an ignored SUBCIRCUIT removes its whole subtree, control unaffected} \
+  [list [lindex $s28 0] [lindex $s28 1] $s28_state $s28_ctl] \
+  [list 0 $S3_IGNGOLD $S3_ENTRY [list 0 $S3_GOLD]]
+
+# ===========================================================================
+# S29 — only_toplevel IS MEASURED FROM THE WALK ENTRY, NOT FROM LEVEL 0
+# ===========================================================================
+# spice_netlist.c:216 drops an only_toplevel device when `netlist_count` is
+# non-zero, i.e. when its cell is a SUBCIRCUIT of the deck rather than the deck
+# top. Measured three ways on this binary:
+#   s3otl as the loaded cell        -> XMOTL present
+#   s3otltop (s3otl one level down) -> XMOTL absent
+#   s3otltop, DESCENDED into x1     -> XMOTL present again
+# The third is the same relativity D2 gives the path basis, and it is why this
+# filter cannot be written as "skip whenever currsch > 0".
+catch {op_annot::register nmos $S3_FDESC}
+opa_s3_load s3otl.sch
+set s29_top [rcall {opa_s3_lines [op_annot::save_cards]}]
+opa_s3_load s3otltop.sch
+set s29_sub [rcall {opa_s3_lines [op_annot::save_cards]}]
+opa_s3_load s3otltop.sch
+opa_s3_descend 0
+set s29_desc [rcall {opa_s3_lines [op_annot::save_cards]}]
+while {[xschem get currsch] > 0} { catch {xschem go_back 2} }
+check {S29 only_toplevel is relative to the WALK ENTRY, three walks of one cell} \
+  [list $s29_top $s29_sub $s29_desc] \
+  [list [list 0 $S3_OTL_TOP] [list 0 $S3_OTL_SUB] [list 0 $S3_OTL_TOP]]
+
+# ===========================================================================
+# S30 — lvs_ignore HONOURS THE ::lvs_ignore GLOBAL, AND THE GLOBAL SURVIVES
+# ===========================================================================
+# skip_instance() takes lvs_ignore as an argument, and spice_netlist.c:209
+# passes the global. Measured: XMLVS is in the deck at 0 and gone at 1. A walk
+# that ignored the global would emit a card for a device the user's own LVS
+# netlist deliberately dropped; a walk that CHANGED the global would be an I4
+# violation of a different kind — the setting is the user's, not the walk's.
+opa_s3_load s3filt.sch
+set s30_saved_lvs 0
+if {[info exists ::lvs_ignore]} { set s30_saved_lvs $::lvs_ignore }
+set ::lvs_ignore 0
+set s30_off [rcall {opa_s3_lines [op_annot::save_cards]}]
+set ::lvs_ignore 1
+set s30_on [rcall {opa_s3_lines [op_annot::save_cards]}]
+set s30_after $::lvs_ignore
+set ::lvs_ignore $s30_saved_lvs
+check {S30 lvs_ignore drops MLVS only when ::lvs_ignore is set, and is not clobbered} \
+  [list $s30_off $s30_on $s30_after] \
+  [list [list 0 $S3_FILTGOLD] [list 0 $S3_FILTGOLD_LVS] 1]
+
+# ===========================================================================
+# S31 — THE CROSS-CHECK: THE NETLISTER ITSELF IS THE ORACLE
+# ===========================================================================
+# Every row above encodes what the netlister does as a golden a human typed.
+# This one asks the netlister. The set of devices the cards name must EQUAL the
+# set of elements `xschem netlist` actually wrote for the same cell — no card
+# for a device that is not in the deck (0437), and no device in the deck left
+# without cards. It is the acceptance the reverted attempt's brief asked for and
+# the one no golden can drift away from.
+opa_s3_load s3filt.sch
+set s31_elems [opa_s3_netlist_elems]
+opa_s3_load s3filt.sch
+set s31 [rcall {opa_s3_devs [opa_s3_lines [op_annot::save_cards]]}]
+# The card names carry the `@m.` element-letter prefix that ngspice needs and
+# the netlist element names do not; strip it for the comparison, and assert the
+# netlist side separately so a NO-NETLIST does not silently satisfy the row.
+set s31_stripped {}
+if {[lindex $s31 0] == 0} {
+  foreach d [lindex $s31 1] { lappend s31_stripped [string range $d 3 end] }
+}
+check {S31 0437 the cards name EXACTLY the elements the netlister wrote} \
+  [list $s31_elems [lindex $s31 0] [lsort -unique $s31_stripped] \
+        [lindex $s31 1]] \
+  [list {xmlvs xmok xmtmpl} 0 {xmlvs xmok xmtmpl} $S3_FILTDEVS]
+
+catch {op_annot::register nmos $S3_DESC}
+opa_s3_load s3top.sch
+
+} serr]} {
+  puts "UNEXPECTED ERROR (section S): $serr"
+  incr fail
+}
