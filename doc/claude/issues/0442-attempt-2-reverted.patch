+## ============================================================================
+## THE BASIS SEAMS (issue 0436). FOUR PROCS, BECAUSE THEY FAIL INDEPENDENTLY.
+## ============================================================================
+## _check_basis  validates, and is the ONLY place that raises
+## _pathfor      answers the hierarchy PREFIX for a basis
+## _subst_path   substitutes that prefix into a devpath TEMPLATE
+## _devproc_call hands that prefix to a DEVPROC's `path` argument
+##
+## They are separate names rather than four blocks inside `devpath` because
+## each one can be wrong on its own and leave the other three right: a
+## template-only fix leaves the devproc arm raw-relative and vice versa, and
+## both are invisible to a test suite that exercises only one PDK's shape.
+
+## Validate the basis/root pair. Returns the basis; RAISES naming the argument
+## the caller got wrong (decision D3).
+##
+## ⚠ THE RAISE IS THE MECHANISM, not a nicety. `deck` is unreachable from any
+## draw / tcleval path — S5's display and S9's overlay pass no basis at all — so
+## the I3 rule "data conditions are blank" is not weakened: this is the file's
+## other rule, "caller bugs are loud" (see the error discipline above).
+proc op_annot::_check_basis {basis root} {
+  if {$basis eq {read}} {
+    if {[string trim $root] ne {}} {
+      return -code error \
+        "op_annot::devpath: a \"root\" argument is meaningless with basis\
+ \"read\" — the read name is measured from the level the RAW was loaded at, not\
+ from a walk entry. Pass basis \"deck\" to root a name at a walk entry."
+    }
+    return read
+  }
+  if {$basis ne {deck}} {
+    return -code error \
+      "op_annot::devpath: unknown basis \"$basis\" — expected \"read\" (the\
+ raw-relative name a LOADED raw uses, for display) or \"deck\" (the\
+ entry-relative name an UNSIMULATED deck uses, for save cards)."
+  }
+  ## deck: the root is the walk's entry `sch_path` and must still be a prefix of
+  ## where we now stand. A root from a different walk is a caller bug, and a
+  ## blank answer would be worse than a raise: `string range` over a mismatched
+  ## prefix yields a plausible truncation, and per spec landmine 9 a wrong device
+  ## name does NOT blank at read time — ngspice writes a full 0.0 column under
+  ## exactly the name it was asked for.
+  if {[catch {xschem get sch_path} p]} { return deck }
+  set r [::op_annot::_root $root]
+  if {[string first $r $p] != 0} {
+    return -code error \
+      "op_annot::devpath: root \"$r\" is not a prefix of the current hierarchy\
+ path \"$p\" — the root must be the sch_path of the level the walk started from."
+  }
+  return deck
+}
