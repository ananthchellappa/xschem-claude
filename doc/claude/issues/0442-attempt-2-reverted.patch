+## The walk-entry root, defaulted. `.` is level 0, i.e. `xschem get sch_path` at
+## the top, which is what makes `deck` with no root mean "rooted at the top".
+proc op_annot::_root {root} {
+  if {[string trim $root] eq {}} { return {.} }
+  return $root
+}
