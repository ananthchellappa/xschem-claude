+# --- the S3 fixture: top -> mid -> leaf, with a VECTOR instance in the middle -
+# s3top.sch   x1 (s3mid.sym)        + M9 (sky130 nfet)
+# s3mid.sch   x2[1:0] (s3leaf.sym)  + M5 (sky130 nfet)
+# s3leaf.sch  M1 (sky130 nfet)
+# s3badtop.sch  xb (s3bad.sym, which has NO .sch) + M3   -> the warning channel
+# s3rectop.sch  xr (s3rec.sym, whose .sch instantiates s3rec.sym again) + M1
+#               at every level  -> CADMAXHIER=40, the class-1 descend refusal
+foreach s {s3mid s3leaf s3rec s3bad} {
+  set f [open [file join $lib $s.sym] w]
+  puts $f "v {xschem version=3.4.4 file_version=1.2}
+G {type=subcircuit
+format=\"@name @pinlist @symname\"
+template=\"name=x1\"}
+V {}
+S {}
+E {}
+L 4 -20 -20 20 -20 {}
+L 4 20 -20 20 20 {}
+L 4 20 20 -20 20 {}
+L 4 -20 20 -20 -20 {}
+B 5 -22.5 -2.5 -17.5 2.5 {name=A dir=inout}
+T {@symname} -20 -34 0 0 0.2 0.2 {}"
+  close $f
+}
+set f [open [file join $lib s3top.sch] w]
+puts $f {v {xschem version=3.4.4 file_version=1.2}
+G {}
+V {}
+S {}
+E {}
+C {s3mid.sym} 120 0 0 0 {name=x1}
+C {sky130_fd_pr/nfet_01v8.sym} 400 -300 0 0 {name=M9 W=1 L=0.15 nf=1}}
+close $f
+set f [open [file join $lib s3mid.sch] w]
+puts $f {v {xschem version=3.4.4 file_version=1.2}
+G {}
+V {}
+S {}
+E {}
+C {s3leaf.sym} 120 0 0 0 {name=x2[1:0]}
+C {sky130_fd_pr/nfet_01v8.sym} 400 -300 0 0 {name=M5 W=1 L=0.15 nf=1}}
+close $f
+set f [open [file join $lib s3leaf.sch] w]
+puts $f {v {xschem version=3.4.4 file_version=1.2}
+G {}
+V {}
+S {}
+E {}
+C {sky130_fd_pr/nfet_01v8.sym} 400 -300 0 0 {name=M1 W=1 L=0.15 nf=1}}
+close $f
+set f [open [file join $lib s3badtop.sch] w]
+puts $f {v {xschem version=3.4.4 file_version=1.2}
+G {}
+V {}
+S {}
+E {}
+C {s3bad.sym} 120 0 0 0 {name=xb}
+C {sky130_fd_pr/nfet_01v8.sym} 400 -300 0 0 {name=M3 W=1 L=0.15 nf=1}}
+close $f
+set f [open [file join $lib s3rec.sch] w]
+puts $f {v {xschem version=3.4.4 file_version=1.2}
+G {}
+V {}
+S {}
+E {}
+C {s3rec.sym} 120 0 0 0 {name=xr}
+C {sky130_fd_pr/nfet_01v8.sym} 400 -300 0 0 {name=M1 W=1 L=0.15 nf=1}}
+close $f
+set f [open [file join $lib s3rectop.sch] w]
+puts $f {v {xschem version=3.4.4 file_version=1.2}
+G {}
+V {}
+S {}
+E {}
+C {s3rec.sym} 120 0 0 0 {name=xr}}
+close $f
+
+set XSCHEM_LIBRARY_PATH ":[file join $repo sky130A xschem_libs]:[file join $repo xschem_library devices]:$lib"
