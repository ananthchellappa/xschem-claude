+# --- the S3 goldens -----------------------------------------------------------
+set S3_TMPL   {\@m.@path@spiceprefix@name\.msky130_fd_pr__@model}
+set S3_PARAMS {{id id 0} {gm gm 1} {vth vth 2}}
+set S3_MATCH  {*sky130_fd_pr/*}
+set S3_DESC   [list devpath $S3_TMPL params $S3_PARAMS match $S3_MATCH]
+
+# ⚠ ORDER IS PART OF THE GOLDEN, and it is the walk's contract made visible:
+# DEPTH-FIRST, cards emitted for an instance BEFORE descending into it, vector
+# members leftmost-first (x2[1] precedes x2[0] — `expandlabel x2[1:0]` answers
+# `x2[1],x2[0] 2`). Measured on this fixture with the prototype's own recursion
+# shape; a walk that emitted the top-level M9 first, or that visited x2[0]
+# first, reds here and should.
+set S3_GOLD [list \
+  {.save all} \
+  {.save @m.x1.x2[1].xm1.msky130_fd_pr__nfet_01v8[id]} \
+  {.save @m.x1.x2[1].xm1.msky130_fd_pr__nfet_01v8[gm]} \
+  {.save @m.x1.x2[1].xm1.msky130_fd_pr__nfet_01v8[vth]} \
+  {.save @m.x1.x2[0].xm1.msky130_fd_pr__nfet_01v8[id]} \
+  {.save @m.x1.x2[0].xm1.msky130_fd_pr__nfet_01v8[gm]} \
+  {.save @m.x1.x2[0].xm1.msky130_fd_pr__nfet_01v8[vth]} \
+  {.save @m.x1.xm5.msky130_fd_pr__nfet_01v8[id]} \
+  {.save @m.x1.xm5.msky130_fd_pr__nfet_01v8[gm]} \
+  {.save @m.x1.xm5.msky130_fd_pr__nfet_01v8[vth]} \
+  {.save @m.xm9.msky130_fd_pr__nfet_01v8[id]} \
+  {.save @m.xm9.msky130_fd_pr__nfet_01v8[gm]} \
+  {.save @m.xm9.msky130_fd_pr__nfet_01v8[vth]}]
+
+# s3badtop: the FET at the top still gets its cards; only xb is skipped.
+set S3_BADGOLD [list \
+  {.save all} \
+  {.save @m.xm3.msky130_fd_pr__nfet_01v8[id]} \
+  {.save @m.xm3.msky130_fd_pr__nfet_01v8[gm]} \
+  {.save @m.xm3.msky130_fd_pr__nfet_01v8[vth]}]
+
+# The entry state every row in this section starts from and must get back.
+set S3_ENTRY {0 0 0 .}
+
+if {[catch {
+
+# ===========================================================================
+# S0 — FIXTURE, asserted rather than assumed
+# ===========================================================================
+# ⚠ CONTROL, green before and after. Section P leaves an IHP-shaped `nmos` in
+# the store and a different library path; without this row a broken fixture
+# would degrade every S row below into a hollow pass.
+check {S0 FIXTURE store cleared, and the 3-level fixture loads at every level} \
+  [list [rcall {opa_clear_store}] \
+        [opa_s3_load s3leaf.sch] [xschem getprop instance 0 name] \
+        [xschem getprop instance 0 cell::type] \
+        [opa_s3_load s3top.sch] [xschem getprop instance 0 name] \
+        [xschem getprop instance 0 cell::type] [xschem getprop instance 1 name] \
+        [xschem getprop instance 1 cell::type] [opa_s3_state]] \
+  [list {0 {{} {} {}}} {1 0 . 0} M1 nmos {2 0 . 0} x1 subcircuit M9 nmos \
+        $S3_ENTRY]
+
+# ===========================================================================
+# S1 — the three deliverables exist
+# ===========================================================================
+# ⚠ THE rcall DISCIPLINE'S PARTNER. An absent proc must red ONE legible row;
+# without this the expects-blank rows below would be satisfied by
+# `invalid command name`.
+check {S1 save_cards, last_warnings and write_save_file all exist} \
+  [list [expr {[info commands ::op_annot::save_cards]      ne {}}] \
+        [expr {[info commands ::op_annot::last_warnings]   ne {}}] \
+        [expr {[info commands ::op_annot::write_save_file] ne {}}]] \
+  {1 1 1}
+
+# ===========================================================================
+# S2 — THE GOLDEN CARD LIST
+# ===========================================================================
+catch {op_annot::register nmos $S3_DESC}
+opa_s3_load s3top.sch
+check {S2 GOLDEN 13-line block, depth-first, cards BEFORE descending} \
+  [rcall {opa_s3_lines [op_annot::save_cards]}] [list 0 $S3_GOLD]
+
+set s3_block {}
+catch {set s3_block [op_annot::save_cards]}
+set s3_lines [opa_s3_lines $s3_block]
+
+# ===========================================================================
+# S3 — THE CARD IS BARE (spec §3 R4). THE MOST IMPORTANT ROW IN THE STEP.
+# ===========================================================================
+# The three params deliberately span all three kinds (id=0, gm=1, vth=2). If
+# the emitter went through op_annot::vector, 8 of the 12 cards would gain an
+# `i(` or `v(` wrapper — and ngspice would then put NOTHING in the raw for
+# them, with no diagnostic. The second half recomputes the top-level cards from
+# op_annot::devpath at the call site: same builder (I1), no wrapper.
+set s3_m9 {}
+catch { foreach p {id gm vth} { lappend s3_m9 ".save [op_annot::devpath M9]\[$p\]" } }
+check {S3 R4/I1 no card is wrapped, and the M9 cards are [devpath][param]} \
+  [list [llength [lsearch -all -glob $s3_lines {*i(*}]] \
+        [llength [lsearch -all -glob $s3_lines {*v(*}]] \
+        [expr {[lrange $s3_lines end-2 end] eq $s3_m9}] [llength $s3_m9]] \
+  {0 0 1 3}
+
+# ===========================================================================
+# S4/S5 — I2 / rule R2, and I2's SPELLING
+# ===========================================================================
+check {S4 I2/R2 the block's FIRST line is `.save all`, and exactly one line is} \
+  [list [lindex $s3_lines 0] [llength [lsearch -all -exact $s3_lines {.save all}]]] \
+  [list {.save all} 1]
+
+# ⚠ Measured on ngspice-42 AND 46+: the bare deck-level form is a hard error and
+# writes NO raw file at all. The line count is in the golden so an absent
+# save_cards (one empty line) cannot satisfy the row.
+check {S5 I2 SPELLING no line is the bare `save all` (it kills the whole run)} \
+  [list [llength [lsearch -all -exact $s3_lines {save all}]] [llength $s3_lines]] \
+  {0 13}
+
+# ===========================================================================
+# S6 — the 0425 CONSUMER CONTRACT: skip on a blank DEVPATH, never on a blank
+#      DESCRIPTOR (src/op_annot.tcl:122-124)
+# ===========================================================================
+# The descriptor is still fully registered; only its `match` glob stops
+# claiming the cell. An emitter that tested the DESCRIPTOR would emit twelve
+# cards with an EMPTY device name — and per spec landmine 9 ngspice answers a
+# bogus card with a fabricated 0.0 column, not a blank.
+catch {op_annot::register nmos [list devpath $S3_TMPL params $S3_PARAMS \
+                                    match {*nothing_matches_this*}]}
+check {S6 0425 a non-matching cell yields {} — not a lone `.save all`, not a raise} \
+  [list [expr {[op_annot::descriptor nmos] ne {}}] [rcall {op_annot::save_cards}]] \
+  [list 1 {0 {}}]
+
+# ===========================================================================
+# S7 — `derived` and `pinexpr` CONTRIBUTE NO CARDS (spec §4.3)
+# ===========================================================================
+# `gm/id` is computed from params after they are read and `vgs` is a pin
+# expression; neither has a vector in any raw. The S2 descriptor deliberately
+# carries neither key, so this row is their sole guardian.
+catch {op_annot::register nmos [list devpath $S3_TMPL params $S3_PARAMS \
+        match $S3_MATCH derived {{gm/id {$gm/$id}}} \
+        pinexpr {{vgs {expr(@#1:spice_get_voltage - @#2:spice_get_voltage)}}}]}
+check {S7 derived and pinexpr add no cards: the block is byte-identical to S2} \
+  [rcall {opa_s3_lines [op_annot::save_cards]}] [list 0 $S3_GOLD]
+
+# ===========================================================================
+# S8 — I6, HAPPY PATH
+# ===========================================================================
+# ⚠ THE rc IS IN THE GOLDEN. Without it the row passes against an absent
+# save_cards: a call that raises before touching anything leaves the state
+# trivially unchanged.
+catch {op_annot::register nmos $S3_DESC}
+opa_s3_load s3top.sch
+set s8_before [opa_s3_state]
+set s8_rc [lindex [rcall {op_annot::save_cards}] 0]
+check {S8 I6 no_draw / keep_symbols / currsch / sch_path all back after a walk} \
+  [list $s8_rc $s8_before [expr {[opa_s3_state] eq $s8_before}]] \
+  [list 0 $S3_ENTRY 1]
+
+# ===========================================================================
+# S9 — I6 for no_undo, FUNCTIONALLY (issue 0432: there is no getter)
+# ===========================================================================
+# ⚠ `xschem get no_undo` returns {} whether the flag is 0 or 1 — measured
+# before and after `xschem set no_undo 1`. So the flag is probed by its EFFECT.
+# The paired control under an explicit `no_undo 1` is what proves the probe
+# discriminates instead of passing on any binary at all.
+opa_s3_load s3top.sch
+set s9_rc [lindex [rcall {op_annot::save_cards}] 0]
+set s9_live [opa_s3_undo_probe]
+opa_s3_load s3top.sch
+xschem set no_undo 1
+set s9_dead [opa_s3_undo_probe]
+xschem set no_undo 0
+check {S9 I6 undo still works after the walk; control: no_undo 1 breaks it} \
+  [list $s9_rc $s9_live $s9_dead] [list 0 {2 1 2} {2 1 1}]
+
+# ===========================================================================
+# S10 — I6, FORCED MID-WALK FAILURE: RE-RAISED, NOT SWALLOWED
+# ===========================================================================
+# A partial block silently returned is spec landmine 9's fabricated-zeros
+# hazard wearing a different hat: the missing devices do not blank, they get a
+# 0.0 column. The walk must re-raise and let the caller decide.
+opa_s3_load s3top.sch
+set s10_before [opa_s3_state]
+opa_s3_shim_on
+set s10 [rcall {op_annot::save_cards}]
+set s10_after [opa_s3_state]
+set s10_hits $::opa_s3_shim_hits
+opa_s3_shim_off
+check {S10 I6 a forced mid-walk failure propagates out of save_cards} \
+  [list [lindex $s10 0] \
+        [string match {*opa forced mid-walk failure*} [lindex $s10 1]] \
+        [expr {$s10_hits > 0}]] \
+  {1 1 1}
+
+# ===========================================================================
+# S11 — I6, THE ROW ISSUE 0431 EXISTS FOR
+# ===========================================================================
+# Before-state, reproduced on this tree: sky130_save_fet_params raises and
+# returns with no_draw=1 keep_symbols=1 still set. The shim-hit count is what
+# stops this row passing against an absent save_cards.
+check {S11 I6 after the forced failure the entry state is fully restored (0431)} \
+  [list [expr {$s10_hits > 0}] $s10_before $s10_after \
+        [expr {$s10_after eq $s10_before}] [opa_s3_undo_probe]] \
+  [list 1 $S3_ENTRY $S3_ENTRY 1 {2 1 2}]
+
+# ===========================================================================
+# S12 — I6, THE UNWIND IS BOUNDED BY THE ENTRY LEVEL, NOT BY 0
+# ===========================================================================
+# This is the half of I6 that issue 0431 never measured: its cell raises at the
+# TOP level, where sch_path survives by luck. Entering the walk already
+# descended into x1 and forcing the same raise two levels down, the restore
+# must land back on currsch=1 / sch_path=.x1. — the src/xschem.tcl:3857 idiom
+# `while {[xschem get currsch]} {xschem go_back}` would ascend past the caller.
+opa_s3_load s3top.sch
+xschem unselect_all
+xschem select instance 0 fast nodraw
+xschem descend 1 2
+set s12_before [opa_s3_state]
+opa_s3_shim_on
+set s12 [rcall {op_annot::save_cards}]
+set s12_after [opa_s3_state]
+set s12_hits $::opa_s3_shim_hits
+opa_s3_shim_off
+while {[xschem get currsch] > 0} { catch {xschem go_back 2} }
+check {S12 I6 the unwind stops at the ENTRY level (currsch 1, sch_path .x1.)} \
+  [list [expr {$s12_hits > 0}] $s12_before $s12_after] \
+  [list 1 {0 0 1 .x1.} {0 0 1 .x1.}]
+
+# ===========================================================================
+# S13 — I4: the overlay never modifies the schematic
+# ===========================================================================
+opa_s3_load s3top.sch
+set s13_m0 [xschem get modified]
+set s13_rc1 [lindex [rcall {op_annot::save_cards}] 0]
+set s13_m1 [xschem get modified]
+opa_s3_shim_on
+set s13_rc2 [lindex [rcall {op_annot::save_cards}] 0]
+set s13_hits $::opa_s3_shim_hits
+opa_s3_shim_off
+set s13_m2 [xschem get modified]
+check {S13 I4 the walk never dirties the .sch, happy path or forced failure} \
+  [list $s13_m0 $s13_rc1 $s13_m1 [expr {$s13_hits > 0}] $s13_rc2 $s13_m2] \
+  {0 0 0 1 1 0}
+
+# ===========================================================================
+# S14 — THE WARNINGS CHANNEL
+# ===========================================================================
+# The prototype's answer to an undescendable instance is a bare `puts` (
+# sg13g2_procs.tcl:405), which is invisible under --nogui and unassertable.
+# s3bad.sym has NO .sch: measured, `xschem descend` returns 0, currsch DOES
+# increment (issue 0250 class 2) and `xschem get descend_error` is
+# `load-failed`. The walk must still emit the sibling FET's cards.
+opa_s3_load s3top.sch
+set s14_clean [rcall {op_annot::save_cards ; op_annot::last_warnings}]
+opa_s3_load s3badtop.sch
+set s14 [rcall {op_annot::save_cards}]
+set s14_w [rcall {op_annot::last_warnings}]
+check {S14 an undescendable subcircuit is reported in last_warnings, not `puts`} \
+  [list $s14_clean [lindex $s14 0] [opa_s3_lines [lindex $s14 1]] \
+        [lindex $s14_w 0] [llength [lindex $s14_w 1]] \
+        [string match {*xb*} [lindex $s14_w 1]] \
+        [string match {*load-failed*} [lindex $s14_w 1]] [opa_s3_state]] \
+  [list {0 {}} 0 $S3_BADGOLD 0 1 1 1 $S3_ENTRY]
+
+# ===========================================================================
+# S15 — issue 0433: A CLASS-1 DESCEND REFUSAL MUST NOT OVER-ASCEND
+# ===========================================================================
+# `xschem descend` returns 0 in TWO classes with OPPOSITE required responses
+# (actions.c:4055-4065). Measured on this tree: a blank/missing schematic
+# returns 0 with currsch INCREMENTED (`load-failed`), while a refusal BEFORE
+# descending returns 0 with currsch UNCHANGED (`no-selection`, `maxdepth`,
+# `not-descendable:<type>`). Both PDK prototypes answer 0 with an unconditional
+# `go_back 2` — right for the first class, and for the second it pops a level
+# it never pushed, so the walk re-visits levels and emits DUPLICATE cards.
+# s3rec.sym instantiates itself, so the walk hits CADMAXHIER=40 and takes the
+# class-1 path for real. 118 lines = `.save all` + 39 levels x 3 params.
+opa_s3_load s3rectop.sch
+set s15 [rcall {op_annot::save_cards}]
+set s15_w [rcall {op_annot::last_warnings}]
+set s15_lines [opa_s3_lines [lindex $s15 1]]
+check {S15 0433 the recursive walk terminates, emits no duplicate card, restores} \
+  [list [lindex $s15 0] [llength $s15_lines] \
+        [expr {[llength $s15_lines] == [llength [lsort -unique $s15_lines]]}] \
+        [lindex $s15_w 0] [llength [lindex $s15_w 1]] \
+        [string match {*xr*} [lindex $s15_w 1]] \
+        [string match {*maxdepth*} [lindex $s15_w 1]] [opa_s3_state]] \
+  [list 0 118 1 0 1 1 1 $S3_ENTRY]
+
+# ===========================================================================
+# S16 — THE ACTION LOG (fires only under --logdir)
+# ===========================================================================
+# descend and go_back SELF-LOG (actions.c:4073, :4229). A walk over a real
+# design would flood a log whose contract is REPLAYABLE USER EDITS with
+# hundreds of navigation lines. The control half is the important one: an
+# unpopped `log_action -suppress push` silences the user's log for the rest of
+# the session, which is a worse defect than the noise it removes.
+if {[xschem get actionlog_filename] eq {}} {
+  skiprow {S16 the walk suppresses its own descend/go_back log traffic} \
+          {no action log open -- run with --logdir}
+} else {
+  opa_s3_load s3top.sch
+  set s16_d0 [opa_s3_logcount {xschem descend*}]
+  set s16_g0 [opa_s3_logcount {xschem go_back*}]
+  set s16 [rcall {opa_s3_lines [op_annot::save_cards]}]
+  set s16_d1 [opa_s3_logcount {xschem descend*}]
+  set s16_g1 [opa_s3_logcount {xschem go_back*}]
+  xschem unselect_all
+  xschem select instance 0 fast nodraw
+  xschem descend 1 2
+  xschem go_back 2
+  set s16_d2 [opa_s3_logcount {xschem descend*}]
+  set s16_g2 [opa_s3_logcount {xschem go_back*}]
+  check {S16 the walk logs no navigation, and the suppress scope IS popped after} \
+    [list [lindex $s16 0] [llength [lindex $s16 1]] \
+          [expr {$s16_d1 - $s16_d0}] [expr {$s16_g1 - $s16_g0}] \
+          [expr {$s16_d2 - $s16_d1}] [expr {$s16_g2 - $s16_g1}]] \
+    {0 13 0 0 1 1}
+}
+
+# ===========================================================================
+# S17 — THE MENU DELIVERABLE: $netlist_dir/<cell>.save
+# ===========================================================================
+# Modelled on IHP's `Create FET and BIP .save file` (sg13g2_procs.tcl:602-606),
+# whose `file mkdir $netlist_dir` sky130_procs.tcl:235 lacks — keep IHP's. The
+# header is the writer's, not save_cards': S4's consumer injects the block into
+# a deck where a prose comment is noise, while a human opening this file needs
+# the `.include` instruction. Structure is asserted, prose is not.
+set s17_dir [file join $scratch savedir]
+file mkdir $s17_dir
+set s17_saved_nd {}
+if {[info exists ::netlist_dir]} { set s17_saved_nd $::netlist_dir }
+set ::netlist_dir $s17_dir
+opa_s3_load s3top.sch
+catch {file delete -force [file join $s17_dir s3top.save]}
+set s17 [rcall {op_annot::write_save_file}]
+set s17_body {}
+if {[file isfile [file join $s17_dir s3top.save]]} {
+  set fh [open [file join $s17_dir s3top.save] r]
+  set s17_body [read $fh] ; close $fh
+}
+set s17_lines [opa_s3_lines $s17_body]
+check {S17 write_save_file writes <netlist_dir>/s3top.save: header, blank, block} \
+  [list $s17 [file isfile [file join $s17_dir s3top.save]] \
+        [string index [lindex $s17_lines 0] 0] [lindex $s17_lines 1] \
+        [lrange $s17_lines 2 end]] \
+  [list [list 0 [file join $s17_dir s3top.save]] 1 * {} $S3_GOLD]
+
+# ===========================================================================
+# S18 — AN EMPTY BLOCK WRITES NO FILE
+# ===========================================================================
+# A .save file containing only a header says nothing and reports success. {} is
+# what lets the caller say WHICH first-run confusion it hit (spec §4.6).
+catch {op_annot::register nmos [list devpath $S3_TMPL params $S3_PARAMS \
+                                    match {*nothing_matches_this*}]}
+catch {file delete -force [file join $s17_dir s3top.save]}
+set s18 [rcall {op_annot::write_save_file}]
+check {S18 with nothing to save, write_save_file returns {} and writes no file} \
+  [list $s18 [file exists [file join $s17_dir s3top.save]]] \
+  [list {0 {}} 0]
+catch {op_annot::register nmos $S3_DESC}
+if {$s17_saved_nd ne {}} { set ::netlist_dir $s17_saved_nd }
+
+# ===========================================================================
+# S19 — THE MENU IS WIRED (X only)
+# ===========================================================================
+# Its real job is to prove the new src/xschem.tcl line did not break
+# build_widgets: a raise there kills GUI startup outright.
+if {![info exists ::has_x] || !$::has_x} {
+  skiprow {S19 Simulation > Graphs carries `Create device OP .save file`} \
+          {no X -- run under xvfb without --nogui}
+} else {
+  set s19_menu "[xschem get top_path].menubar.simulation.graph"
+  set s19_labels {}
+  if {[winfo exists $s19_menu]} {
+    for {set i 0} {$i <= [$s19_menu index end]} {incr i} {
+      catch {lappend s19_labels [$s19_menu entrycget $i -label]}
+    }
+  }
+  check {S19 Simulation > Graphs carries `Create device OP .save file`} \
+    [list [winfo exists $s19_menu] \
+          [expr {[lsearch -exact $s19_labels {Create device OP .save file}] >= 0}]] \
+    {1 1}
+}
