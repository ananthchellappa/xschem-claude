+set W_LIBS ":$W_LIB:[file join $repo xschem_library devices]"
+set XSCHEM_LIBRARY_PATH $W_LIBS
+opa_w_fixture $W_LIB
+opa_w_register
+set W_CONF_SAVE $::USER_CONF_DIR
+set ::USER_CONF_DIR $W_CONF
+set netlist_dir $W_NL
