+  if {[string first $r $p] != 0} {
+    return -code error \
+      "op_annot::devpath: root \"$r\" is not a prefix of the current hierarchy\
+ path \"$p\" — the root must be the sch_path of the level the walk started from."
+  }
+  return deck
