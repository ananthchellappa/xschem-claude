+/* Does cellfile have a "~" autosave backup on disk at all? This is the ANCESTOR
+ * rule of hierarchy_modified(): while you are descended past an unsaved parent,
+ * that parent's ~ IS the live copy of its edits (B5/B6 wrote it on the way down
+ * and go_back reads it back), so bare existence is exactly the right question. */
+static int backup_exists(const char *cellfile)
+{
+  char bak[PATH_MAX];
+  struct stat sb;
+  if(!cellfile || !cellfile[0]) return 0;
+  if(!backup_file_name(bak, S(bak), cellfile)) return 0;
+  return stat(bak, &sb) ? 0 : 1;
+}
+
+/* Does cellfile's "~" hold work that is NOT already in the cell file? This is the
+ * CURRENT-level rule (issue 0264). Unlike an ancestor's, the current buffer's ~ can
+ * also be a SUPERSEDED leftover -- the cell was saved from another window/session
+ * after the ~ was written -- so bare existence would warn about junk. It counts when
+ * it is NEWER than the cell, or when the cell has no on-disk file at all (an untitled
+ * buffer's ~ is all there is). Deliberately the SAME staleness test that
+ * xschem_recover_backup already applies on open (src/xschem.tcl: "cell at least as
+ * new as the backup -> drop it silently"), which buys a statable invariant:
+ * Close/Quit warns about the current cell exactly when reopening it would offer
+ * recovery. */
+static int backup_is_live(const char *cellfile)
+{
+  char bak[PATH_MAX];
+  struct stat bsb, csb;
+  if(!cellfile || !cellfile[0]) return 0;
+  if(!backup_file_name(bak, S(bak), cellfile)) return 0;
+  if(stat(bak, &bsb)) return 0;         /* no backup at all */
+  if(stat(cellfile, &csb)) return 1;    /* backup but no cell: the ~ is all there is */
+  return bsb.st_mtime > csb.st_mtime;
+}
+
