diff --git a/tests/headless/test_backup_recovery.tcl b/tests/headless/test_backup_recovery.tcl
index 54290eee..85807b3a 100644
--- a/tests/headless/test_backup_recovery.tcl
+++ b/tests/headless/test_backup_recovery.tcl
@@ -11,6 +11,10 @@
 # R3  recovery offer (xschem_recover_backup): a ~ newer than the saved cell is a
 #     crash artifact -> offered (yes restores it, no removes it); a ~ older than the
 #     cell is stale junk -> silently removed, never offered.
+# R4  (issue 0264) a discard destroys only the work it was ASKED about: clearing a
+#     CLEAN buffer must leave its ~ alone, because that ~ is then not this session's
+#     unsaved content -- it is the only surviving copy of work Reload/open-another
+#     dropped from the buffer. The consented half (dirty + yes/no) is unchanged.
 #
 # Works on a /tmp copy so the ~ backups never pollute the committed fixtures.
 
@@ -38,6 +42,17 @@ proc write_sch {path n} {
   close $fp
 }
 
+# count the "N " wire records of an on-disk schematic (-1 if the file is gone):
+# proves CONTENT survived, not merely a filename.
+proc count_wires {path} {
+  if {![file exists $path]} { return -1 }
+  set fp [open $path r]
+  set n 0
+  foreach l [split [read $fp] \n] { if {[string match "N *" $l]} { incr n } }
+  close $fp
+  return $n
+}
+
 # ---------------------------------------------------------------------------
 # R1: load_backup loads the ~ content under the cell's identity, modified.
 # ---------------------------------------------------------------------------
@@ -113,4 +128,87 @@ set rec [xschem_recover_backup $cell3]
 check "R3c: a stale (older) ~ is removed without asking" \
   [expr {$rec == 0 && $::mb_calls == 0 && ![file exists $bak3]}]
 
+# ---------------------------------------------------------------------------
+# R4 (issue 0264): File > New / `xschem clear` must not destroy a ~ it never
+# asked about. clear_schematic() calls save(1,0) -- which only prompts when
+# xctx->modified -- and then remove_backup() UNCONDITIONALLY. So on a CLEAN
+# buffer nothing is asked and the ~ is unlinked anyway. That ~ is exactly where
+# `xschem reload` and an in-place load of another cell leave the user's only
+# copy of their edits, so the discard eats work with zero prompts (measured).
+# The consented discards (dirty + "no", dirty + "yes") must keep removing it.
+# doc/claude/issues/0264-hierarchy-modified-ignores-the-current-cells-own-backup.md
+# ---------------------------------------------------------------------------
+set ::ask_answer no
+set ::ask_calls 0
+proc ask_save {{ask {}} {cancel 1}} { incr ::ask_calls; return $::ask_answer }
+
+# (a) precondition: headless never auto-recovers (the offer is has_x-gated), so
+# opening a cell that still has a live ~ gives a clean buffer beside a live ~.
+set cell4 $work/r4.sch
+set bak4  $work/r4~.sch
+write_sch $cell4 1
+write_sch $bak4  2                                  ;# the unsaved work: 2 wires
+file mtime $bak4 [expr {[file mtime $cell4] + 5}]   ;# ~ NEWER than the cell
+xschem load $cell4
+check "R4a: opening a cell with a live ~ is clean and keeps the ~" \
+  [expr {[xschem get modified] == 0 && [xschem get wires] == 1 && [file exists $bak4]}]
+
+# (h) tripwire for (b)/(g): save(1,0) silently force-saves when the cell's mtime
+# moved under us, which would remove the ~ for a reason unrelated to 0264.
+check "R4h: buffer is clean right before the clear (no forced save)" \
+  [expr {[xschem get modified] == 0}]
+
+set ::ask_calls 0
+xschem clear
+check "R4b: clear did NOT delete a ~ it never asked about" [file exists $bak4]
+check "R4g: that clear asked the user nothing (0 ask_save calls)" \
+  [expr {$::ask_calls == 0}]
+
+xschem load $cell4
+check "R4c: the work is still recoverable after the clear (2 wires)" \
+  [expr {[xschem load_backup $cell4] == 1 && [xschem get wires] == 2}]
+
+# (d) the measured 0264 repro end to end: edit -> File>Reload (buffer clean
+# again, ~ untouched and holding the edit) -> File>New.
+set cell5 $work/r4d.sch
+set bak5  $work/r4d~.sch
+write_sch $cell5 1
+file delete -force $bak5
+xschem load $cell5
+xschem wire 200 300 300 300                         ;# 2 wires, autosaved to the ~
+xschem reload
+check "R4d: after reload the buffer is clean but the ~ still holds the edit" \
+  [expr {[xschem get modified] == 0 && [xschem get wires] == 1 && \
+         [count_wires $bak5] == 2 && [count_wires $cell5] == 1}]
+xschem clear
+xschem load $cell5
+check "R4d: File>New after a Reload leaves the edit recoverable (2 wires)" \
+  [expr {[xschem load_backup $cell5] == 1 && [xschem get wires] == 2}]
+
+# (e) the consented half is UNCHANGED: a DIRTY buffer discarded with "no" still
+# drops its ~ (guards against a fix that guards too much).
+set cell6 $work/r4e.sch
+set bak6  $work/r4e~.sch
+write_sch $cell6 1
+file delete -force $bak6
+xschem load $cell6
+xschem wire 200 300 300 300
+check "R4e: the dirty edit autosaved its ~" [file exists $bak6]
+set ::ask_answer no; set ::ask_calls 0
+xschem clear
+check "R4e: a CONSENTED discard (asked, answered no) still removes the ~" \
+  [expr {$::ask_calls == 1 && ![file exists $bak6]}]
+
+# (f) answering "yes" saves the cell; save_schematic's own removal still runs.
+set cell7 $work/r4f.sch
+set bak7  $work/r4f~.sch
+write_sch $cell7 1
+file delete -force $bak7
+xschem load $cell7
+xschem wire 200 300 300 300
+set ::ask_answer yes; set ::ask_calls 0
+xschem clear
+check "R4f: answering yes saved the cell (2 wires) and removed the ~" \
+  [expr {$::ask_calls == 1 && ![file exists $bak7] && [count_wires $cell7] == 2}]
+
 result
