+# ---------------------------------------------------------------------------
+# issue 0264: the scan covered ONLY the ancestors (`for(i = 0; i < currsch; i++)`),
+# so the cell the user is actually looking at was never in it -- and at top level
+# (currsch==0) the loop body never runs at all and the predicate degenerates to
+# xctx->modified. A clean buffer whose OWN ~ is newer than the cell (exactly what
+# `xschem reload` and an in-place load of another cell leave behind) therefore
+# reported "clean" while the only copy of the work sat on disk.
+# The current level counts when its ~ is LIVE -- newer than the cell, or the cell
+# is gone -- which is the same staleness rule xschem_recover_backup uses (R3c of
+# test_backup_recovery.tcl). That buys a statable invariant: Close/Quit warns for
+# the current cell exactly when reopening it would offer recovery. ANCESTORS keep
+# the bare-existence rule of B5/B6 (their ~ is the live descend artifact).
+# doc/claude/issues/0264-hierarchy-modified-ignores-the-current-cells-own-backup.md
+# ---------------------------------------------------------------------------
+
+# --- D/E: the CURRENT level while descended (currsch=1, ancestor scan empty) ---
+set cbak [xschem backup name]
+xschem backup write                     ;# the child's own unsaved copy on disk
+file mtime $cbak [expr {[file mtime $work/descend_child.sch] + 5}]
+check "0264 D: descended child's OWN live ~ counts (hierarchy_modified=1)" \
+  [expr {[xschem get modified] == 0 && [xschem get hierarchy_modified] == 1}]
+file delete -force $cbak
+check "0264 E: never-edited descended child with no ~ stays clean (hierarchy_modified=0)" \
+  [expr {[xschem get hierarchy_modified] == 0}]
+
+# --- A/B/C: the CURRENT level at top level (currsch=0, the loop never runs) ---
+xschem go_back
+check "0264: back at a clean top level (currsch=0, modified=0)" \
+  [expr {[xschem get currsch] == 0 && [xschem get modified] == 0}]
+set pbak [xschem backup name]
+xschem backup write
+file mtime $pbak [expr {[file mtime $work/descend_parent.sch] + 5}]
+check "0264 A: clean top level whose own ~ is NEWER than the cell -> hierarchy_modified=1" \
+  [expr {[xschem get modified] == 0 && [xschem get hierarchy_modified] == 1}]
+
+file mtime $pbak [expr {[file mtime $work/descend_parent.sch] - 5}]
+check "0264 C: a superseded (older) ~ is stale junk -> hierarchy_modified=0" \
+  [expr {[xschem get hierarchy_modified] == 0}]
+
+file delete -force $pbak
+check "0264 B: no ~ on disk at all -> hierarchy_modified=0" \
+  [expr {[xschem get hierarchy_modified] == 0}]
+
+# --- F/G: autosave_backup off -> no ~ trail to consult, only xctx->modified ---
+xschem backup write
+file mtime $pbak [expr {[file mtime $work/descend_parent.sch] + 5}]
+set autosave_backup 0
+check "0264 F: autosave_backup off -> a live ~ does not count (hierarchy_modified=0)" \
+  [expr {[xschem get hierarchy_modified] == 0}]
+xschem wire 200 300 300 300
+check "0264 G: autosave_backup off -> a real edit still counts (hierarchy_modified=1)" \
+  [expr {[xschem get hierarchy_modified] == 1}]
+set autosave_backup 1
+file delete -force $pbak
+xschem load $work/descend_parent.sch    ;# leave the buffer clean for exit
+
 result
