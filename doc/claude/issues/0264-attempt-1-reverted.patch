+ * CALLER CONTRACT (issue 0264): this unlinks unconditionally -- it never asks whose
+ * work the ~ holds. The ~ is keyed on a FILENAME, not on the buffer that wrote it, so
+ * the caller must first establish that the content being torn down is the content this
+ * ~ backs (a real save of this buffer, or a discard the user consented to). Calling it
+ * on a CLEAN buffer destroys whatever a previous session or an earlier discard left
+ * there -- which is exactly the copy crash recovery exists to offer. */
 void remove_backup(void)
 {
   char bak[PATH_MAX];
@@ -3573,26 +3580,69 @@ int load_backup_as(const char *cellfile, int set_title)
   return 1;
