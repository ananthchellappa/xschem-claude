+    incr ::KX_REL
+    return [uplevel 1 [linsert $args 0 ::rdw::pick_release_kxreal]]
+  }
+}
+if {[llength [info commands ::rdw::pick_suspend]]} {
+  rename ::rdw::pick_suspend ::rdw::pick_suspend_kxreal
