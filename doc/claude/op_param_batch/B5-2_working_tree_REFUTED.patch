+proc b5_dkey {type key} {
+  set d [rw_ans ::op_annot::descriptor $type]
+  if {[rw_bad $d]} { return $d }
+  if {[catch {dict exists $d $key} e]} { return BADDESC }
+  if {!$e} { return NOKEY }
