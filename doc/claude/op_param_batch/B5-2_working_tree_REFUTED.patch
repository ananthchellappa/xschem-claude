+}
+proc ::rdw::scope_dialog {args} {
+  incr ::b5_dlg_calls
+  set ::b5_dlg_args $args
+  return $::b5_dlg_answer
+}
+proc b5_dlg {answer} { set ::b5_dlg_calls 0 ; set ::b5_dlg_args {} ; set ::b5_dlg_answer $answer }
