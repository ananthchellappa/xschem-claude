+set ::be_dlg_answer {scope broad list summary}
+ol_ans ::rdw::set_list summary
+ol_ans ::rdw::set_row 11
+set BE3B_SAY   [be_press delete]
+set BE3B_CARDS [ol_ans ::op_annot::_cards_for M1 {}]
+set BE3B_PARAM [ol_dkey b5ndev params]
