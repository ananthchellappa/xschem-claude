+set fail 0; set npass 0
+proc check {name got exp} {
+  global fail npass
+  if {$got eq $exp} { puts "ok:   $name"; incr npass } \
+  else { puts "FAIL: $name -> {$got} (exp {$exp}) : FAIL"; incr fail }
+}
