+check {FX0 the canvas is mapped and really sized before anything is measured - every row below is silently vacuous without it} \
+  [list [winfo ismapped .drw] [expr {[winfo width .drw] > 1 && [winfo height .drw] > 1 ? 1 : 0}]] \
+  {1 1}
