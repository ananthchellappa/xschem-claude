+# --- F19s3: 0674 -- THE NUDGE MUST SURVIVE A RAISING CHANNEL ----------------
+# ⚠ THE ROW NAME IS s3, NOT s2. `F19s2` is TAKEN by issue 0679's refusal-to-guess
+# row (~:936) in this same suite.
+#
+# THE USER'S OWN MESSAGE, on the one call site 0674 is about. src/ase.tcl:778
+# (the issue says :692; it has drifted) is the ONLY direct `::xschem::notify`
+# call in any product file outside the channel's own two, and it is direct
+# because `notify_safe`'s `{msg {tag {}}}` signature cannot carry
+# -short/-menu/-command -- which R-0653-d keeps as DISTINCT fields. Its own
+# comment says so, and names this as issue 0674's general class.
+#
+# WHAT THAT COSTS, measured: the site is wrapped in a bare `catch`, and it sits
+# inside `catch {ase::op_cards_capture $state $nl}` (ase.tcl:889). So a raise
+# anywhere in the channel takes the notice AND destroys the evidence -- twice
+# over, silently. F19s proves the nudge travels through a HEALTHY channel;
+# nothing in this suite or in test_ase_window falsifies the catch, which is
+# exactly the declared coverage hole (`grep -c 'rename ::xschem::notify '` is 0
+# in both files).
+#
+# THE WITNESS IS THE BOOTSTRAP, not the pane: with the channel raising, a notice
+# that survives is one that reached `xschem::notify_bootstrap`, carrying its
+# remedy fields intact through notify_safe's `{*}$args` forwarding. At HEAD the
+# spy sees the OTHER ase::echo notices of the same netlist and NOT this one --
+# which is the defect stated as a measurement.
+
+## Run $script with the channel RAISING at its first statement and the degraded
+## bootstrap SPIED, capturing every notice that got that far as {msg args...}.
+## Restores both on every exit path.
+proc f_boot_spy {script} {
+  set ::f_boot {}
+  set hadn [expr {[info commands ::xschem::notify] ne {}}]
+  if {$hadn} { rename ::xschem::notify ::f_saved_notify_r }
+  proc ::xschem::notify {args} {
+    return -code error {F19s3 a simulated bug inside the channel itself}
+  }
+  set hadb [expr {[info commands ::xschem::notify_bootstrap] ne {}}]
+  if {$hadb} { rename ::xschem::notify_bootstrap ::f_saved_boot }
+  proc ::xschem::notify_bootstrap {msg args} {
+    lappend ::f_boot [linsert $args 0 $msg] ; return 0
+  }
+  set rc [catch {uplevel 1 $script} e]
+  catch {rename ::xschem::notify {}}
+  if {$hadn} { catch {rename ::f_saved_notify_r ::xschem::notify} }
+  catch {rename ::xschem::notify_bootstrap {}}
+  if {$hadb} { catch {rename ::f_saved_boot ::xschem::notify_bootstrap} }
+  if {$rc} { return [list ERR $e] }
+  return $e
+}
+## just the 0617 gate-off nudges out of that capture (a netlist emits others)
+proc f_boot_nudge {} {
+  set out {}
+  foreach c $::f_boot {
+    if {[string match {ASE: device operating-point parameters*} [lindex $c 0]]} {
+      lappend out $c
+    }
+  }
+  return $out
+}
+## one option's value out of a captured {-o v -o v} tail
+proc f_optval {tail o} {
+  foreach {k v} $tail { if {$k eq $o} { return $v } }
+  return NO-OPTION
+}
+
+cx {ase::op_cards_nudge_reset}
+catch {unset ::xschem::notify_last}
+set f19s3_dir [file normalize [file join $scratch runoff_s3]]
+set f19s3_st [ase::state_load $statefile]
+dict set f19s3_st rundir $f19s3_dir
+## NON-VACUITY FIRST, and it is not decoration: without it a red row could mean
+## "this state makes no nudge at all" (a consumed latch, a changed gate) rather
+## than "the raise ate it". One HEALTHY netlist of the SAME state, F19s's own
+## collector, then the latch is re-armed for the spied run.
+cx {ase::op_cards_nudge_reset}
+set f19s3_ctrl [f_nudges $f19s3_st]
+cx {ase::op_cards_nudge_reset}
+set ::f19s3_nl NO-RUN
+set f19s3_run  [f_boot_spy { set ::f19s3_nl [cx {ase::netlist $::f19s3_st}] }]
+set f19s3_call [f_boot_nudge]
+set f19s3_tail [expr {[llength $f19s3_call] == 1 ? [lrange [lindex $f19s3_call 0] 1 end] : {}}]
+## the static half: after 0674 no NON-COMMENT line of src/ase.tcl calls the
+## channel directly (test_ase_core NT39 owns the whole-tree form)
+set f19s3_direct 0
+if {![catch {open [file join $repo src ase.tcl] r} f19s3_fd]} {
+  set f19s3_body [read $f19s3_fd] ; close $f19s3_fd
+  foreach l [split $f19s3_body \n] {
+    if {[string index [string trimleft $l] 0] eq {#}} continue
+    if {[regexp {::xschem::notify[^_a-zA-Z0-9]} $l]} { incr f19s3_direct }
+  }
+}
+check "F19s3 0674 THE USER'S OWN NUDGE SURVIVES A RAISING CHANNEL: the netlist\
+ completes, the gate-off notice reaches the degraded bootstrap exactly once\
+ with its -short/-menu/-command intact, and src/ase.tcl no longer calls\
+ ::xschem::notify directly at all" \
+  [list $f19s3_ctrl \
+        [expr {[string match {ERR *} $f19s3_run] ? 0 : 1}] \
+        [expr {[string match {ERR: *} $::f19s3_nl] ? 0 : 1}] \
+        [llength $f19s3_call] \
+        [f_optval $f19s3_tail -short] \
+        [llength [split [f_optval $f19s3_tail -menu] >]] \
+        [f_optval $f19s3_tail -command] \
+        $f19s3_direct] \
+  [list 1 1 1 1 {no OP params saved} 3 [list ase::ui::save_op_params_on $f19o_key] 0]
+puts "note: F19s3 captured nudge = {$f19s3_call}"
+puts "note: F19s3 notices that reached the bootstrap = {[llength $::f_boot]}"
+flush stdout
+cx {ase::op_cards_nudge_reset}
+
