+++ b/tests/headless/test_startup_guard_0663.tcl
@@ -339,17 +339,59 @@ check "SG13 0663 R6 hard form: a healthy startup writes ZERO `#! ` lines to the\
 # the C backstop never fires: one announcement, ONE durable line, 0658's shipped
 # output byte-unchanged. The `#! ` total is the anti-0665 half -- one notice
 # must not become two durable lines.
+#
+# ⚠ EXTENDED BY ISSUE 0675, AND THE `#! ` TOTAL IS WHY IT IS EXTENDED HERE
+# RATHER THAN ROWED SEPARATELY. The degraded sentence asserts an inventory --
+# "(no CIW pane, no status field, no popup, no remedy)" -- and measures none of
+# it. 0675 makes it a MEASUREMENT by appending the one reachability line. That
+# append must ride on the SAME durable line: `log_output` (src/util.c:536)
+# prefixes every physical newline with its own `#! `, so an inventory carrying
+# an embedded newline would turn this child's one announcement into TWO durable
+# lines and redden the last term of this very row. A second ANNOUNCEMENT would
+# do the same, which is 0497 rule 1 (count per pass, never alert per item)
+# enforced inside one sentence. Contract for the line's shape: the head of the
+# NT30-NT41 block in tests/headless/test_ase_core.tcl.
+## the first log line carrying $s, so a row (or a note) can show WHAT was said
+proc sg_log_line_with {r s} {
+  foreach l [dict get $r -log] { if {[string first $s $l] >= 0} { return $l } }
+  return {}
+}
 set sg_ciw [sg_run ciw [list ciw.tcl $SG_BOOM]]
