+        [expr {[string first {ciw=dead(no-ciw_echo)} $ntd15_mid] >= 0 ? 1 : 0}] \
+        [expr {[string first {ciw=dead(no-Tk)}       $ntd15_mid] >= 0 ? 1 : 0}] \
+        [expr {$ntd15_end ne {} && \
+               [ntd_fault_nocause $ntd15_end] eq [ntd_fault_nocause $ntd15_mid] ? 1 : 0}]] \
