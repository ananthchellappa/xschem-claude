+
+# --- PS39: EVERY CLAUSE IS TRUE AT THE MOMENT IT IS SAID --------------------
+# 0664 is issue 0652's defect class -- a report that LIES -- and the answer to
+# it cannot be a second report that asserts. So each clause of the inventory
+# captured INSIDE PS37's state is paired with an INDEPENDENT per-widget probe
+# taken in the same instant, in one tuple, so a clause that is merely plausible
+# cannot pass. (PS39 asserts on PS37's captured values and changes no state.)
+check "PS39 0675 THE INVENTORY IS A MEASUREMENT: captured inside the\
+ unreachable state, every clause of `sinks now:` matches an independent probe\
+ of the same widget in the same instant -- and the log arm ADMITS what Tcl\
+ cannot see (actionlog_suppress, issue 0699) instead of claiming liveness" \
+  [list [expr {[string first {sinks now: } $ps37_line] == 0 ? 1 : 0}] \
+        $ps37_armc \
+        [expr {[string first {ciw=dead(no-pane)} $ps37_line] >= 0 ? 1 : 0}] \
+        $ps37_arms \
+        [expr {[string first {statusbar=dead(no-widget)} $ps37_line] >= 0 ? 1 : 0}] \
+        $ps37_armp \
+        [expr {[string first {popup=off(style-ciw)} $ps37_line] >= 0 ? 1 : 0}] \
+        [expr {[string first {log=blind(open,UNVERIFIED issue 0699)} $ps37_line] >= 0 ? 1 : 0}] \
+        [expr {[string first "\n" $ps37_line] >= 0 ? 1 : 0}]] \
+  [list 1 {dead no-pane} 1 {dead no-widget} 1 {off style-ciw} 1 1 0]
+
+# --- PS38: 0497 RULE 1 -- COUNT PER PASS, NEVER ALERT PER ITEM -------------
+# The third voice is latched on the REACHABLE SET, not on the session and not on
+# the notice. Three passes in one row, because each alone would admit a wrong
+# fix: five more notices in the IDENTICAL state must add nothing (a per-notice
+# alert is what 0497 forbids); a genuinely DIFFERENT unreachable set must
+# re-arm and speak once (a session-wide one-shot would go quiet on a state the
+# user has not been told about); and a state with a VISIBLE sink must say
+# nothing at all (an announcement that never stops is noise, not information).
+#
+# The second pass is the sharp one: the pane is REBUILT and then WITHDRAWN, so
+# it RECEIVES every notice while no human can see it -- `blind`, not `dead`.
+# That is the distinction the whole predicate exists to make.
+set ps38_n0 [llength [loglines]]
+foreach i {1 2 3 4 5} { catch {ase::echo "PS38-0675 further unreachable notice $i" error} }
+update idletasks
+set ps38_same [ps_newcount $ps38_n0 {NOTICE CHANNEL UNREACHABLE}]
+set ps38_vol  [ps_newcount $ps38_n0 {PS38-0675 further unreachable notice}]
+
+set ps38_n1 [llength [loglines]]
+set ps38_rebuilt [ciw_rebuild]
+set ps38_withdrawn [ciw_close_via_wm]
+catch {ase::echo {PS38-0675 a DIFFERENT unreachable set: the pane receives, nobody sees} error}
+update idletasks
+set ps38_changed [ps_newcount $ps38_n1 {NOTICE CHANNEL UNREACHABLE}]
+set ps38_arm_blind [ps_arm ciw]
+
+set ps38_n2 [llength [loglines]]
+set ps38_shown [ciw_show]
+catch {ase::echo {PS38-0675 and with a visible sink there is nothing to announce} error}
+update idletasks
+set ps38_reachable [ps_newcount $ps38_n2 {NOTICE CHANNEL UNREACHABLE}]
+check "PS38 0675/0497 rule 1 the third voice is LATCHED ON THE REACHABLE SET:\
+ five further notices in the identical state add ZERO lines (while all five are\
+ still logged), a genuinely different unreachable set -- a pane that RECEIVES\
+ and cannot be SEEN -- re-arms it for exactly ONE more, and a state with a\
+ visible sink announces nothing" \
+  [list $ps38_same $ps38_vol $ps38_rebuilt $ps38_withdrawn $ps38_arm_blind \
+        $ps38_changed $ps38_shown $ps38_reachable] \
+  [list 0 5 1 1 {blind unmapped} 1 1 0]
+
+## restore the drawing window's status field before the file-shape rows
+set ps_sbar_back [sbar_rebuild]
+note "PS37-PS39 statusbar rebuilt" $ps_sbar_back
+
+# --- PS40: ONE ANNOUNCEMENT, ONE DURABLE LINE ------------------------------
+# `log_output` (src/util.c:536) prefixes EVERY physical newline with its own
+# `#! `, so an inventory carrying an embedded newline silently becomes a second
+# durable line -- which would redden SG14 in test_startup_guard_0663.tcl (that
+# row counts the broken-ciw child's `#! ` total as exactly 1) and would be
+# 0665's two-lines-for-one-notice defect wearing a new coat. Asserted on the
+# WHOLE log, over every announcement this suite has provoked: no orphan
+# inventory line, every announcement `#! `-prefixed, and every one of them
+# carrying its measurement.
+set ps40_orphan 0 ; set ps40_unpref 0 ; set ps40_ann 0 ; set ps40_ann_inv 0
+foreach l [loglines] {
+  set ps40_inv [expr {[string first {sinks now:} $l] >= 0}]
+  set ps40_m 0
+  foreach m {{NOTICE CHANNEL DEGRADED} {NOTICE CHANNEL FAULT} {NOTICE CHANNEL UNREACHABLE}} {
+    if {[string first $m $l] >= 0} { set ps40_m 1 }
+  }
+  if {$ps40_m} {
+    incr ps40_ann
+    if {$ps40_inv} { incr ps40_ann_inv }
+    if {[string range $l 0 2] ne {#! }} { incr ps40_unpref }
+  } elseif {$ps40_inv} { incr ps40_orphan }
+}
+note "PS40 announcements in the log" [list $ps40_ann with-inventory $ps40_ann_inv]
+check "PS40 0665/0675 EACH ANNOUNCEMENT IS EXACTLY ONE DURABLE LINE: every\
+ `NOTICE CHANNEL ...` line in the whole log is `#! `-prefixed and carries its\
+ own measured inventory, and no inventory ever appears on a line of its own" \
+  [list $ps40_orphan $ps40_unpref [expr {$ps40_ann > 0 ? 1 : 0}] \
+        [expr {$ps40_ann == $ps40_ann_inv ? 1 : 0}]] \
+  [list 0 0 1 1]
+
+# --- PS41: 0674 -- THE REMEDY-CARRYING SITE, WITH A REAL LOG ----------------
+# src/ase.tcl:778's shape (0674 says :692; it has drifted). It is a DIRECT
+# `catch {::xschem::notify ... -short -menu -command}` because notify_safe's
+# `{msg {tag {}}}` signature cannot carry a remedy -- so the user's own 0617
+# gate-off nudge is swallowed whole, with its own catch destroying the evidence,
+# the moment the channel raises. Both halves in one row: through the widened
+# delegate the healthy path keeps every field DISTINCT (R-0653-d) and renders
+# ONE durable sentence, and the raising path still leaves its line and does not
+# raise into its caller.
+ciw_show
+ps_rearm_latches
+set PS41_MSG  {PS41-0674 the gate-off nudge must survive a raising channel}
+set PS41_MENU {ASE-L > Outputs > Save All...}
+set PS41_CMD  {ase::ui::save_op_params_on ps41}
+catch {unset ::xschem::notify_last}
+set ps41_n0 [llength [loglines]]
+set ps41_rc [ps_cx {::xschem::notify_safe $PS41_MSG -tag error -short PS41SHORT \
+                      -menu $PS41_MENU -command $PS41_CMD}]
+update idletasks
+## ⚠ CAPTURED HERE, NOT IN THE `check` BELOW. The witness is ONE slot: the
+## raising half of this row makes a SECOND notice, which reaches the degraded
+## bootstrap and overwrites `::xschem::notify_last` with its own fresh record --
+## and degraded mode deliberately carries NO short form and NO remedy (0658's
+## scope limit, fenced by test_ase_core NT18). Reading the fields after that
+## call would measure the bootstrap's record while claiming to measure the
+## healthy channel's, which is this cluster's own defect class wearing a test's
+## clothes. The HEALTHY half is asserted where it is true.
+set ps41_short [ps_field short]
+set ps41_menuf [ps_field menu]
+set ps41_cmdf  [ps_field command]
+set ps41_line "#! $PS41_MSG Fix: $PS41_MENU. CIW command: $PS41_CMD"
+
+set PS41_MSG2 {PS41-0674 and the same notice with the channel RAISING}
+set ps41_n1 [llength [loglines]]
+set ::ps41_rc2  NO-RUN
+set ::ps41_done 0
+set ps41_raise [ps_raising_notify {
+  set ::ps41_rc2  [ps_cx {::xschem::notify_safe $::PS41_MSG2 -tag error \
+                            -short PS41SHORT2 -menu $::PS41_MENU -command $::PS41_CMD}]
+  set ::ps41_done 1
+}]
+update idletasks
+note "PS41 healthy return" $ps41_rc
+note "PS41 raising return" $::ps41_rc2
+note "PS41 new log lines"  [newlines $ps41_n1]
+check "PS41 0674 THE SAFE DELEGATE CARRIES THE WHOLE NOTICE: healthy, it keeps\
+ -short/-menu/-command as DISTINCT witness fields and renders ONE durable\
+ sentence carrying the remedy; with the channel RAISING, the call itself does\
+ not raise and the notice still leaves exactly one durable line" \
+  [list $ps41_short $ps41_menuf $ps41_cmdf \
+        [ps_newcount $ps41_n0 $ps41_line] \
+        $ps41_done \
+        [expr {[string match {ERR: *} $::ps41_rc2] ? 0 : 1}] \
+        [ps_newcount $ps41_n1 $PS41_MSG2]] \
+  [list PS41SHORT $PS41_MENU $PS41_CMD 1 1 1 1]
+
 # leave the session as we found it: CIW visible, status field clear
 sbar_set {}
 ciw_show
