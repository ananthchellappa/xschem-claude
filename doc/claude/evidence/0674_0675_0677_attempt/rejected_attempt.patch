+## ---------------------------------------------------------------------------
+## THE ONE REACHABILITY PREDICATE, AND ITS TWO RENDERERS  (issues 0674/0675/0677)
+## ---------------------------------------------------------------------------
+## THE DEFECT, IN ONE SENTENCE (issue 0675): every liveness test this channel
+## owned measured PROC IDENTITY, and the question is SINK REACHABILITY. A
+## channel can be ALIVE by its own test and reach nobody -- measured three ways:
+##
+##   * `--nogui --nolog`: notify_channel_degraded 0, `xschem::notify` returns 1,
+##     the witness reads `sinks {ciw}`, with no Tk, no `.ciw.l.t` and no log;
+##   * on :99 with the CIW toplevel MAPPED and its text pane DESTROYED: the same
+##     three answers, the `.statusbar.12` fallback SKIPPED, and neither
+##     announcement in the log;
+##   * a ciw.tcl that fails PART-WAY through: three materially different failure
+##     points emitting the IDENTICAL `NOTICE CHANNEL FAULT` sentence, while
+##     `::ciw_echo` is present in one of them and absent in the others.
+##
+## FOUR NEAR-COPIES made that possible -- one question, four answers, and their
+## drift was silent (invariant I1): notify_ciw_visible probed the TOPLEVEL
+## `.ciw`; sink 1 marked `ciw` whenever `::ciw_echo` merely FAILED TO RAISE (and
+## ciw_echo's first statement is a SILENT `return` when `.ciw.l.t` is absent);
+## notify_statusbar probed its own widget; notify_channel_degraded asked
+## `info body`. TWO of them looked at `.ciw` while the writer writes `.ciw.l.t`.
+##
+## So: ONE predicate, and every consumer asks IT -- notify_ciw_visible (the
+## sink-3 gate), sink 1's mark, and all three announcements.
+##
+## ⚠ THE VOCABULARY IS REACHABLE, NEVER SEEN, and the difference is not
+## pedantry. `winfo ismapped` is 1 for a CIW stacked BEHIND the design window
+## (issue 0659, re-measured), 1 for a sash collapsed to zero height, and says
+## nothing at all about whether anyone is at the desk. This predicate can prove
+## a sink DEAD; it can NEVER prove a live sink was READ. `visible` therefore
+## means "a person could see it now", and that is the strongest honest claim
+## available from Tcl.
+
+## IS THE DURABLE LOG OPEN? -- THE ONE spelling of that test (invariant I1).
+##
+## ⚠ IT EXISTED TWICE BEFORE THIS PROC: byte-equivalent copies inside
+## notify_log's 0657 honesty gate and inside notify_degraded_once's no-log
+## branch -- an I1 breach shipped inside the very fix that cites I1, and this
+## expression is precisely where the `log` claim is either honest or a lie
+## (0657: `sinks = ciw log` reported under --nolog with no log at all). Adding a
+## third copy inside notify_reach would have made it three. ONE proc, THREE
+## consumers (test_ase_core NT40 fences exactly that).
+proc xschem::notify_log_open {} {
+  if {[catch {xschem get actionlog_filename} lf]} { return 0 }
+  return [expr {$lf ne {} ? 1 : 0}]
+}
+
+## THE ONE RENDERER of message + remedy (R-0653-d, invariant I1). Moved verbatim
+## out of src/ciw.tcl's channel so notify_safe's completion branch can record
+## the REAL rendered line instead of building a second copy of it -- which is
+## issue 0677 (b), and which 0674's widening (a delegate that can now carry
+## -menu/-command) is exactly what makes live.
+proc xschem::notify_line {msg menu command} {
+  set line $msg
+  if {$msg ne {}} {
+    if {$menu ne {}}    { append line " Fix: $menu." }
+    if {$command ne {}} { append line " CIW command: $command" }
+  }
+  return $line
+}
+
+## CAN A NOTICE REACH A HUMAN RIGHT NOW? -- one dict, four arms, four states.
+##
+##   ciw log statusbar popup  ->  {state reason}
+##
+##   state   visible : a person could see it NOW (never "did see it")
+##           blind   : the sink RECEIVES the text and no eye is on it -- a
+##                     withdrawn pane, a durable log file
+##           dead    : the sink is not there at all
+##           off     : ::notify_style did not select this sink for THIS notice
+##   reason  a token, or {} when `visible` needs no qualifier
+##
+## ⚠ THE REASON ORDER IS LOAD-BEARING, most-specific first. `no-ciw_echo` before
+## `no-Tk` is the ONLY thing that distinguishes a mid-file-broken ciw.tcl from a
+## plain headless run inside one `--nogui` child -- which is 0497 rule 2 (split
+## by CAUSE, never one aggregate) enforced inside a single sentence, and the one
+## fact HEAD's identical FAULT announcements never mentioned.
+##
+## ⚠ THE PANE ARM PROBES `.ciw.l.t`, THE WIDGET ciw_echo REALLY WRITES, never
+## the toplevel `.ciw`. Re-measured on :99 with openbox live: `ismapped` for the
+## two paths is IDENTICAL across open (1/1), withdrawn (0/0) and iconified
+## (0/0), so every committed sink-selection row is unmoved. Exactly ONE state
+## changes, and it is the user's: a mapped toplevel whose pane is gone.
+##
+## ⚠ THE LOG ARM IS NEVER `visible` -- a file is a record, not an audience --
+## and it ADMITS what Tcl cannot see. `actionlog_suppress` (src/util.c:540 gates
+## on it; src/scheduler.c:11733 is a SETTER with no getter) silently discards
+## every line while notify_log still returns 1, measured. Issue 0699 carries it;
+## until then the arm says UNVERIFIED rather than asserting liveness.
+##
+## It NEVER raises, and it reads ::notify_style at CALL time (invariant I5).
+proc xschem::notify_reach {} {
+  set degraded 1
+  catch {set degraded [xschem::notify_channel_degraded]}
+  set tk [expr {[llength [info commands winfo]] ? 1 : 0}]
+  set style ciw
+  if {[info exists ::notify_style]} { set style $::notify_style }
+  set d [dict create]
+
+  ## SINK 1 -- the CIW log pane. A degraded channel short-circuits every Tk arm,
+  ## which is what turns the DEGRADED sentence's "(no CIW pane, no status field,
+  ## no popup)" from an assertion into a measurement (issue 0664).
+  if {$degraded} {
+    dict set d ciw [list dead degraded-channel]
+  } elseif {[info commands ::ciw_echo] eq {}} {
+    dict set d ciw [list dead no-ciw_echo]
+  } elseif {!$tk} {
+    dict set d ciw [list dead no-Tk]
+  } elseif {[catch {winfo exists .ciw.l.t} e] || !$e} {
+    dict set d ciw [list dead no-pane]
+  } elseif {[catch {winfo ismapped .ciw.l.t} m] || !$m} {
+    dict set d ciw [list blind unmapped]
+  } else {
+    dict set d ciw [list visible {}]
+  }
+
+  ## SINK 2 -- the durable action log.
+  if {[xschem::notify_log_open]} {
+    dict set d log [list blind {open,UNVERIFIED issue 0699}]
+  } else {
+    dict set d log [list dead no-file]
+  }
+
+  ## SINK 3 -- the drawing window's shared red status field, addressed as
+  ## `[xschem get top_path].statusbar.12` and NEVER bare (a bare path posts to
+  ## the MAIN window while the user works in `.x1`).
+  if {$degraded} {
+    dict set d statusbar [list dead degraded-channel]
+  } elseif {!$tk} {
+    dict set d statusbar [list dead no-Tk]
+  } else {
+    set sw {}
+    if {![catch {xschem get top_path} tp]} { set sw "$tp.statusbar.12" }
+    if {$sw eq {} || [catch {winfo exists $sw} e] || !$e} {
+      dict set d statusbar [list dead no-widget]
+    } elseif {[catch {winfo ismapped $sw} m] || !$m} {
+      dict set d statusbar [list blind unmapped]
+    } else {
+      dict set d statusbar [list visible {}]
+    }
+  }
+
+  ## SINK 4 -- the opt-in non-blocking popup. `degraded-channel` OUTRANKS the
+  ## style gate deliberately: with the log-only fallback live the popup is not
+  ## merely unselected, it is gone, and the arm should say which.
+  if {$degraded} {
+    dict set d popup [list dead degraded-channel]
+  } elseif {$style ne {popup}} {
+    dict set d popup [list off style-ciw]
+  } elseif {!$tk} {
+    dict set d popup [list dead no-Tk]
+  } else {
+    dict set d popup [list visible {}]
+  }
+  return $d
+}
+
+## THE ONE RENDERER of that dict, and it is ONE PHYSICAL LINE.
+##
+## ⚠ NO EMBEDDED NEWLINE, EVER. log_output() (src/util.c:536) prefixes every
+## physical newline with its own `#! `, so a two-line inventory silently becomes
+## TWO durable lines -- 0665's one-notice-two-lines defect wearing a new coat,
+## and it reddens test_startup_guard_0663 SG14 from a distance.
+##
+##   sinks now: ciw=dead(no-pane) log=blind(open,UNVERIFIED issue 0699) ...
+proc xschem::notify_reach_line {} {
+  if {[catch {xschem::notify_reach} d]} { return {sinks now: UNMEASURED} }
+  set out {}
+  foreach s {ciw log statusbar popup} {
+    set st UNMEASURED ; set rs {}
+    if {[dict exists $d $s]} {
+      set a [dict get $d $s]
+      set st [lindex $a 0]
+      set rs [lindex $a 1]
+    }
+    ## ⚠ ${st} IS BRACED: a bare `$st(...)` is an ARRAY REFERENCE to Tcl.
+    if {$rs eq {}} { lappend out "$s=$st" } else { lappend out "$s=${st}($rs)" }
+  }
+  return "sinks now: [join $out { }]"
+}
