+proc xschem::notify_unreachable_once {} {
+  if {[catch {xschem::notify_channel_degraded} deg] || $deg} { return 0 }
+  if {![llength [info commands winfo]]} { return 0 }
+  if {[catch {xschem::notify_reach} d]} { return 0 }
