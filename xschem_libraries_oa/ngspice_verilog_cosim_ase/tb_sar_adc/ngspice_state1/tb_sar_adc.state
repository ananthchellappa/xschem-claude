version 1
simulator ngspice
design {lib ngspice_verilog_cosim_ase cell tb_sar_adc view schematic}
rundir {}
temperature 27
models {}
variables {{name VCC value 3.3}}
analyses {{type op enabled 0} {type dc enabled 0} {type ac enabled 0} {type tran enabled 1 stop 250u step 10n}}
outputs {{name d5 expr v(d5) save 1 plot 1} {name d4 expr v(d4) save 1 plot 1} {name d3 expr v(d3) save 1 plot 1} {name d2 expr v(d2) save 1 plot 1} {name d1 expr v(d1) save 1 plot 1} {name d0 expr v(d0) save 1 plot 1} {name valida expr v(valid_a) save 1 plot 1} {name clk expr v(clk) save 1 plot 1} {name start expr v(start) save 1 plot 1} {name xtestsample expr v(xtest.sample) save 1 plot 1} {name xtestcompa expr v(xtest.comp_a) save 1 plot 1} {name INPUT expr v(INPUT) save 1 plot 1} {name xtesttestv expr v(xtest.test_v) save 1 plot 1} {name ivamm expr i(vamm) save 1 plot 1}}
save_all_v 1
save_all_i 0
options {}
includes {}
pre_commands {}
viewer {}
