version 1
simulator ngspice
design {lib ngspice_verilog_cosim_ase cell tb_sar_adc view schematic}
rundir {}
temperature 27
models {}
variables {{name VCC value 3.3}}
analyses {{type op enabled 0} {type dc enabled 0} {type ac enabled 0} {type tran enabled 1 stop 250u step 10n}}
outputs {{name d5 expr vt(d5) save 1 plot 1} {name d4 expr vt(d4) save 1 plot 1} {name d3 expr vt(d3) save 1 plot 1} {name d2 expr vt(d2) save 1 plot 1} {name d1 expr vt(d1) save 1 plot 1} {name d0 expr vt(d0) save 1 plot 1} {name valida expr vt(valid_a) save 1 plot 1} {name clk expr vt(clk) save 1 plot 1} {name start expr vt(start) save 1 plot 1} {name xtestsample expr vt(xtest.sample) save 1 plot 1} {name xtestcompa expr vt(xtest.comp_a) save 1 plot 1} {name INPUT expr vt(INPUT) save 1 plot 1} {name xtesttestv expr vt(xtest.test_v) save 1 plot 1} {name ivamm expr it(vamm) save 1 plot 1}}
save_all_v 1
save_all_i 0
options {}
includes {}
pre_commands {}
viewer {}
