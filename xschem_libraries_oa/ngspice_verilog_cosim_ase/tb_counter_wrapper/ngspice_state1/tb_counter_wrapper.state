version 1
simulator ngspice
design {lib ngspice_verilog_cosim_ase cell tb_counter_wrapper view schematic}
rundir {}
temperature 27
models {}
variables {{name VDD value 1.8}}
analyses {{type op enabled 0} {type dc enabled 0} {type ac enabled 0} {type tran enabled 1 stop 2u step 10p}}
outputs {{name clk expr clk save 1 plot 1} {name countout3 expr count_out3 save 1 plot 1} {name countout2 expr count_out2 save 1 plot 1} {name countout1 expr count_out1 save 1 plot 1} {name countout0 expr count_out0 save 1 plot 1} {name sum expr SUM save 1 plot 1} {name ivamm expr i(vamm) save 1 plot 1}}
save_all_v 1
save_all_i 0
options {}
includes {}
pre_commands {{cmd {pre_set auto_bridge_d_in = ( ".model auto_adc adc_bridge( in_low = '0.9 * 1.8 / 2' in_high = '1.1 * 1.8 / 2' rise_delay=1e-11 fall_delay=1e-11 )" "auto_bridge%d [ %s ] [ %s ] auto_adc" )}} {cmd {pre_set auto_bridge_d_out = ( ".model auto_dac dac_bridge( out_low = 0 out_high = 1.8 t_rise=1e-11 t_fall=1e-11 )" "auto_bridge%d [ %s ] [ %s ] auto_dac" )}}}
viewer {}
